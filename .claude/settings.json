{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "git status --porcelain 2>/dev/null | grep -q . && printf '%s' '{\"systemMessage\":\"AGENTS.md rituál: máš necommitnuté změny — synchronizuj docs/product-roadmap.html a proveď kritický self-audit (co jsem ošidil/obešel/přešel mlčením?) před předáním.\"}' || true",
            "statusMessage": "Kontrola AGENTS.md rituálu"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/gate.sh\"",
            "timeout": 300,
            "statusMessage": "Brána: typecheck + lint + vizuální důkaz"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/mark-ui-change.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
