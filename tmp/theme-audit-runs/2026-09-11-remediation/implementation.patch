+        --mint: #3fd7a5;
+        --mint-dark: #08271d;
+        --amber: #e5b64c;
+        --amber-dark: #302713;
+        --rose: #e57c7c;
+        --rose-dark: #2f1616;
+        --radius: 15px;
+        --max-width: 1180px;
+        --sans:
+          Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
+          "Segoe UI", sans-serif;
+        --mono: "SFMono-Regular", Consolas, "Liberation Mono", Menlo, monospace;
+      }
+
+      * { box-sizing: border-box; }
+      html { scroll-behavior: smooth; }
+
+      body {
+        margin: 0;
+        color: var(--text);
+        background: var(--page);
+        font-family: var(--sans);
+        line-height: 1.55;
+        text-rendering: optimizeLegibility;
+      }
+
+      .shell {
+        width: min(calc(100% - 30px), var(--max-width));
+        margin-inline: auto;
+      }
+
+      a { color: var(--mint); }
+
+      .catalog-header { padding: 22px 0; }
+
+      .eyebrow {
+        margin: 0 0 13px;
+        color: var(--text-soft);
+        font-family: var(--mono);
+        font-size: 0.95rem;
+        letter-spacing: 0.16em;
+        text-transform: uppercase;
+      }
+
+      h1, h2, h3, p { margin-top: 0; }
+
+      h1 {
+        margin-bottom: 15px;
+        font-size: clamp(2.35rem, 4vw, 3rem);
+        font-weight: 760;
+        letter-spacing: -0.05em;
+        line-height: 1.05;
+      }
+
+      .lede {
+        max-width: 860px;
+        margin: 0;
+        color: var(--text-soft);
+        font-size: clamp(1.05rem, 1.5vw, 1.32rem);
+        line-height: 1.62;
+      }
+
+      .status-line {
+        margin-top: 18px;
+        display: flex;
+        flex-wrap: wrap;
+        gap: 10px;
+        font-family: var(--mono);
+        font-size: 0.82rem;
+      }
+
+      .chip {
+        padding: 5px 11px;
+        border: 1px solid var(--line-strong);
+        border-radius: 999px;
+        color: var(--text-muted);
+        background: var(--surface-soft);
+      }
+      .chip.live { border-color: var(--mint); color: var(--mint); background: var(--mint-dark); }
+      .chip.wait { border-color: #59471b; color: var(--amber); background: var(--amber-dark); }
+
+      section.block { padding: 30px 0; border-top: 1px solid var(--line); }
+
