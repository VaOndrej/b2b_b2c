{%- comment -%}
  won-hero — single-stage hero. One full-bleed stage rendering one won-slide
  (the slide's own media_position gives the overlay / split / centered look).
  Sibling sections won-hero-grid and won-hero-carousel cover the other two hero
  shapes; all three share the .won-hero styling in won-tokens.css.
{%- endcomment -%}

{%- assign s = section.settings -%}
<section
  class="won-section color-{{ s.color_scheme }}"
  style="{% render 'won-style-vars', settings: s %}"
  data-testid="won-hero-section"
>
  <div
    class="won-container{% if s.section_width == 'full' %} won-container--full{% endif %} won-hero won-hero--single"
    style="--won-hero-min: {{ s.min_height }}px;"
  >
    <div class="won-hero__track">
      {% content_for 'blocks' %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:won.names.hero",
  "tag": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "max_blocks": 1,
