{%- assign s = section.settings -%}
<section
  class="won-section color-{{ s.color_scheme }} {% render 'won-visibility', settings: s %}"
  style="{% render 'won-style-vars', settings: s %}"
  data-testid="won-accordion-section"
>
  {% render 'won-guard', settings: s %}
  <div class="won-container{% if s.section_width == 'full' %} won-container--full{% endif %}">
    <div class="won-acc won-acc--{{ s.layout }}">
      {%- if s.heading != blank or s.intro != blank -%}
        <div class="won-acc__head">
          {%- if s.heading != blank -%}
            <h2
              class="won-heading won-acc__heading"
              style="--won-h-size-m: {{ s.heading_size_mobile }}px; --won-h-size-d: {{ s.heading_size_desktop }}px; --won-h-mw-m: {{ s.heading_max_width_mobile }}%; --won-h-mw-d: {{ s.heading_max_width_desktop }}%;"
            >
              {{- s.heading | replace: '</p><p>', '<br>' | remove: '<p>' | remove: '</p>' | strip -}}
            </h2>
          {%- endif -%}
          {%- if s.intro != blank -%}<div class="won-acc__intro rte">{{ s.intro }}</div>{%- endif -%}
          {%- if s.show_contact -%}
            <div class="won-acc__contact">
              {%- if s.contact_heading != blank -%}<p class="won-acc__contact-heading">{{ s.contact_heading }}</p>{%- endif -%}
              {%- if s.contact_text != blank -%}<div class="rte">{{ s.contact_text }}</div>{%- endif -%}
              {%- if s.contact_button_label != blank -%}
                <a class="won-btn won-btn--secondary" {% if s.contact_button_link != blank %}href="{{ s.contact_button_link }}"{% endif %}>{{ s.contact_button_label }}</a>
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}
      <div class="won-acc__rows">
        {% content_for 'blocks' %}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .won-acc { display: flex; flex-direction: column; gap: var(--won-space-5); }
  .won-acc__head { display: flex; flex-direction: column; gap: var(--won-space-3); }
  .won-acc__heading { font-size: var(--won-h-size-m, 1.8rem); max-width: var(--won-h-mw-m, 100%); }
  .won-acc__intro { opacity: 0.9; }
  .won-acc__contact { margin-top: var(--won-space-3); display: flex; flex-direction: column; gap: var(--won-space-2); align-items: flex-start; }
  .won-acc__contact-heading { margin: 0; font-weight: 700; }

  @media (min-width: 990px) {
    .won-acc__heading { font-size: var(--won-h-size-d, 2.4rem); max-width: var(--won-h-mw-d, 100%); }
    .won-acc--split { flex-direction: row; align-items: flex-start; gap: var(--won-space-7); }
    .won-acc--split .won-acc__head { flex: 0 0 34%; position: sticky; top: var(--won-space-5); }
    .won-acc--split .won-acc__rows { flex: 1 1 auto; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:won.names.accordion",
  "tag": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "max_blocks": 30,
  "blocks": [
    {
      "type": "won-accordion-row"
    },
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "t:won.headers.visibility"
    },
    {
      "type": "checkbox",
      "id": "show_on_mobile",
      "label": "t:won.settings.show_on_mobile",
      "info": "t:won.info.show_on_mobile",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_on_desktop",
      "label": "t:won.settings.show_on_desktop",
      "info": "t:won.info.show_on_desktop",
      "default": true
    },
    {
      "type": "header",
      "content": "t:won.headers.content"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "t:won.settings.heading",
      "default": "t:won.defaults.faq_heading"
    },
    {
      "type": "range",
      "id": "heading_size_desktop",
      "label": "t:won.settings.heading_size_desktop",
      "min": 20,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "heading_max_width_desktop",
      "label": "t:won.settings.heading_max_width_desktop",
      "min": 30,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "t:won.settings.heading_size_mobile",
      "min": 16,
      "max": 56,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "heading_max_width_mobile",
      "label": "t:won.settings.heading_max_width_mobile",
      "min": 30,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "t:won.settings.intro"
    },
    {
      "type": "header",
      "content": "t:won.headers.layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "t:won.settings.layout",
      "options": [
        {
          "value": "stacked",
          "label": "t:won.options.layout_stacked"
        },
        {
          "value": "split",
          "label": "t:won.options.layout_split"
        }
      ],
      "default": "stacked"
    },
    {
      "type": "checkbox",
      "id": "allow_multiple",
      "label": "t:won.settings.allow_multiple",
      "default": false
    },
    {
      "type": "header",
      "content": "t:won.headers.contact"
    },
    {
      "type": "checkbox",
      "id": "show_contact",
      "label": "t:won.settings.show_contact",
      "default": false
    },
    {
      "type": "inline_richtext",
      "id": "contact_heading",
      "label": "t:won.settings.contact_heading",
      "visible_if": "{{ section.settings.show_contact }}"
    },
    {
      "type": "richtext",
      "id": "contact_text",
      "label": "t:won.settings.contact_text",
      "visible_if": "{{ section.settings.show_contact }}"
    },
    {
      "type": "text",
      "id": "contact_button_label",
      "label": "t:won.settings.button_label",
      "visible_if": "{{ section.settings.show_contact }}"
    },
    {
      "type": "url",
      "id": "contact_button_link",
      "label": "t:won.settings.button_link",
      "visible_if": "{{ section.settings.show_contact }}"
    },
    {
      "type": "header",
      "content": "t:won.headers.appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:won.settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:won.settings.section_width",
      "options": [
        {
          "value": "page",
          "label": "t:won.options.width_page"
        },
        {
          "value": "full",
          "label": "t:won.options.width_full"
        }
      ],
      "default": "page"
    },
    {
      "type": "header",
      "content": "t:won.headers.spacing"
    },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "t:won.settings.corner_radius",
      "info": "t:won.info.corner_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "t:won.settings.border_width",
      "info": "t:won.info.border_width",
      "min": 0,
      "max": 8,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "select",
      "id": "border_style",
      "label": "t:won.settings.border_style",
      "options": [
        {
          "value": "solid",
          "label": "t:won.options.solid"
        },
        {
          "value": "dashed",
          "label": "t:won.options.dashed"
        }
      ],
      "default": "solid",
      "visible_if": "{{ section.settings.border_width > 0 }}"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "t:won.settings.border_color",
      "info": "t:won.info.border_color",
      "visible_if": "{{ section.settings.border_width > 0 }}"
    },
    {
      "type": "select",
      "id": "shadow",
      "label": "t:won.settings.shadow",
      "info": "t:won.info.shadow",
      "options": [
        {
          "value": "none",
          "label": "t:won.options.none"
        },
        {
          "value": "sm",
          "label": "t:won.options.shadow_sm"
        },
        {
          "value": "md",
          "label": "t:won.options.shadow_md"
        },
        {
          "value": "lg",
          "label": "t:won.options.shadow_lg"
        }
      ],
      "default": "none"
    },
    {
      "type": "color",
      "id": "accent_override",
      "label": "t:won.settings.accent_color",
      "info": "t:won.info.accent_color"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "t:won.settings.bg_color",
      "info": "t:won.info.bg_color"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:won.settings.text_color",
      "info": "t:won.info.text_color"
    },
    {
      "type": "checkbox",
      "id": "hide_mobile",
      "label": "t:won.settings.hide_mobile",
      "info": "t:won.info.hide_mobile",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_desktop",
      "label": "t:won.settings.hide_desktop",
      "info": "t:won.info.hide_desktop",
      "default": false
    },
    {
      "type": "header",
      "content": "t:won.headers.padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:won.settings.padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:won.settings.padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "header",
      "content": "t:won.headers.type_motion"
    },
    {
      "type": "select",
      "id": "heading_weight",
      "label": "t:won.settings.heading_weight",
      "info": "t:won.info.heading_weight",
      "options": [
        {
          "value": "theme",
          "label": "t:won.options.weight_theme"
        },
        {
          "value": "400",
          "label": "t:won.options.weight_normal"
        },
        {
          "value": "500",
          "label": "t:won.options.weight_medium"
        },
        {
          "value": "600",
          "label": "t:won.options.weight_semibold"
        },
        {
          "value": "700",
          "label": "t:won.options.weight_bold"
        },
        {
          "value": "800",
          "label": "t:won.options.weight_extrabold"
        }
      ],
      "default": "theme"
    },
    {
      "type": "select",
      "id": "letter_spacing",
      "label": "t:won.settings.letter_spacing",
      "info": "t:won.info.letter_spacing",
      "options": [
        {
          "value": "theme",
          "label": "t:won.options.ls_theme"
        },
        {
          "value": "tight",
          "label": "t:won.options.ls_tight"
        },
        {
          "value": "normal",
          "label": "t:won.options.ls_normal"
        },
        {
          "value": "wide",
          "label": "t:won.options.ls_wide"
        },
        {
          "value": "wider",
          "label": "t:won.options.ls_wider"
        }
      ],
      "default": "theme"
    },
    {
      "type": "select",
      "id": "line_height",
      "label": "t:won.settings.line_height",
      "info": "t:won.info.line_height",
      "options": [
        {
          "value": "theme",
          "label": "t:won.options.lh_theme"
        },
        {
          "value": "tight",
          "label": "t:won.options.lh_tight"
        },
        {
          "value": "normal",
          "label": "t:won.options.lh_normal"
        },
        {
          "value": "relaxed",
          "label": "t:won.options.lh_relaxed"
        }
      ],
      "default": "theme"
    },
    {
      "type": "select",
      "id": "text_transform",
      "label": "t:won.settings.text_transform",
      "info": "t:won.info.text_transform",
      "options": [
        {
          "value": "none",
          "label": "t:won.options.tt_none"
        },
        {
          "value": "uppercase",
          "label": "t:won.options.tt_uppercase"
        },
        {
          "value": "capitalize",
          "label": "t:won.options.tt_capitalize"
        }
      ],
      "default": "none"
    },
    {
      "type": "select",
      "id": "animate_in",
      "label": "t:won.settings.animate_in",
      "info": "t:won.info.animate_in",
      "options": [
        {
          "value": "none",
          "label": "t:won.options.anim_none"
        },
        {
          "value": "fade",
          "label": "t:won.options.anim_fade"
        },
        {
          "value": "slide",
          "label": "t:won.options.anim_slide"
        },
        {
          "value": "scale",
          "label": "t:won.options.anim_scale"
        }
      ],
      "default": "none"
    },
    {
      "type": "header",
      "content": "t:won.headers.advanced"
    },
    {
      "type": "paragraph",
      "content": "t:won.info.advanced_about"
    },
    {
      "type": "checkbox",
      "id": "show_advanced",
      "label": "t:won.settings.show_advanced",
      "info": "t:won.info.show_advanced",
      "default": false
    },
    {
      "type": "range",
      "id": "pad_inline",
      "label": "t:won.settings.pad_inline",
      "info": "t:won.info.pad_inline",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.show_advanced }}"
    },
    {
      "type": "range",
      "id": "section_opacity",
      "label": "t:won.settings.section_opacity",
      "info": "t:won.info.section_opacity",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ section.settings.show_advanced }}"
    },
    {
      "type": "text",
      "id": "custom_shadow",
      "label": "t:won.settings.custom_shadow",
      "info": "t:won.info.custom_shadow",
      "visible_if": "{{ section.settings.show_advanced }}"
    }
  ]
}
{% endschema %}
