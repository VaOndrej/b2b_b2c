{%- liquid
  assign s = section.settings
  assign count = section.blocks.size
  assign cols = s.columns_desktop
  if count > 0 and count < cols
    assign cols = count
  endif
-%}

<section
  class="won-section color-{{ s.color_scheme }}"
  style="{% render 'won-spacing', settings: s %}"
  data-testid="won-features-section"
>
  <div class="won-container{% if s.section_width == 'full' %} won-container--full{% endif %} won-features-wrap">
    {%- if s.heading != blank -%}
      <h2
        class="won-heading won-features__heading"
        style="--won-h-size-m: {{ s.heading_size_mobile }}px; --won-h-size-d: {{ s.heading_size_desktop }}px; --won-h-mw-m: {{ s.heading_max_width_mobile }}%; --won-h-mw-d: {{ s.heading_max_width_desktop }}%; text-align: {{ s.content_align }};"
      >
        {{- s.heading | replace: '</p><p>', '<br>' | remove: '<p>' | remove: '</p>' | strip -}}
      </h2>
    {%- endif -%}

    <div
      class="won-features won-features--{{ s.item_style }}"
      style="--won-cols-lg: {{ cols }}; --won-cols-md: {{ s.columns_tablet }}; --won-cols-sm: {{ s.columns_mobile }}; --won-gap: {{ s.gap }}px; --won-features-align: {{ s.content_align }};"
    >
      {% content_for 'blocks' %}
    </div>
  </div>
</section>

{% stylesheet %}
  .won-features-wrap { display: flex; flex-direction: column; gap: var(--won-space-5); }
  .won-features__heading { font-size: var(--won-h-size-m, 1.6rem); max-width: var(--won-h-mw-m, 100%); }
  .won-features {
    display: grid;
    gap: var(--won-gap, 24px);
    grid-template-columns: repeat(var(--won-cols-sm, 1), minmax(0, 1fr));
  }
  .won-features > * { text-align: var(--won-features-align, left); }
  .won-features--card > * { background: var(--won-surface); border-radius: var(--won-radius-md); padding: var(--won-space-4); }
  .won-features--bordered > * { border: 1px solid var(--won-border); border-radius: var(--won-radius-md); padding: var(--won-space-4); }

  @media (min-width: 750px) {
    .won-features { grid-template-columns: repeat(var(--won-cols-md, 2), minmax(0, 1fr)); }
    .won-features__heading { font-size: var(--won-h-size-d, 2rem); max-width: var(--won-h-mw-d, 100%); }
  }
  @media (min-width: 990px) {
    .won-features { grid-template-columns: repeat(var(--won-cols-lg, 4), minmax(0, 1fr)); }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:won.names.features",
  "tag": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "max_blocks": 12,
  "blocks": [{ "type": "won-feature" }, { "type": "@theme" }, { "type": "@app" }],
  "settings": [
    { "type": "header", "content": "t:won.headers.content" },
    { "type": "richtext", "id": "heading", "label": "t:won.settings.heading" },
    { "type": "range", "id": "heading_size_desktop", "label": "t:won.settings.heading_size_desktop", "min": 20, "max": 72, "step": 2, "unit": "px", "default": 34 },
    { "type": "range", "id": "heading_max_width_desktop", "label": "t:won.settings.heading_max_width_desktop", "min": 30, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "heading_size_mobile", "label": "t:won.settings.heading_size_mobile", "min": 16, "max": 48, "step": 2, "unit": "px", "default": 24 },
    { "type": "range", "id": "heading_max_width_mobile", "label": "t:won.settings.heading_max_width_mobile", "min": 30, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "header", "content": "t:won.headers.layout" },
    { "type": "range", "id": "columns_desktop", "label": "t:won.settings.columns_desktop", "min": 1, "max": 6, "step": 1, "default": 4 },
    { "type": "range", "id": "columns_tablet", "label": "t:won.settings.columns_tablet", "min": 1, "max": 4, "step": 1, "default": 2 },
    {
      "type": "select", "id": "columns_mobile", "label": "t:won.settings.columns_mobile",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "1"
    },
    { "type": "range", "id": "gap", "label": "t:won.settings.gap", "min": 8, "max": 64, "step": 2, "unit": "px", "default": 24 },
    {
      "type": "select", "id": "item_style", "label": "t:won.settings.item_style",
      "options": [
        { "value": "plain", "label": "t:won.options.style_plain" },
        { "value": "card", "label": "t:won.options.style_card" },
        { "value": "bordered", "label": "t:won.options.style_bordered" }
      ],
      "default": "plain"
    },
    { "type": "text_alignment", "id": "content_align", "label": "t:won.settings.content_align", "default": "left" },
    { "type": "header", "content": "t:won.headers.appearance" },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:won.settings.color_scheme", "default": "scheme-1" },
    {
      "type": "select", "id": "section_width", "label": "t:won.settings.section_width",
      "options": [
        { "value": "page", "label": "t:won.options.width_page" },
        { "value": "full", "label": "t:won.options.width_full" }
      ],
      "default": "page"
    },
    { "type": "header", "content": "t:won.headers.padding" },
    { "type": "range", "id": "padding_top", "label": "t:won.settings.padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding_bottom", "label": "t:won.settings.padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 56 }
  ],
  "presets": [
    {
      "name": "t:won.presets.usp_row",
      "category": "t:won.categories.content",
      "settings": { "columns_desktop": 4, "item_style": "plain", "content_align": "center" },
      "blocks": [{ "type": "won-feature" }, { "type": "won-feature" }, { "type": "won-feature" }, { "type": "won-feature" }]
    },
    {
      "name": "t:won.presets.benefits_cards",
      "category": "t:won.categories.content",
      "settings": { "columns_desktop": 3, "item_style": "card" },
      "blocks": [{ "type": "won-feature" }, { "type": "won-feature" }, { "type": "won-feature" }]
    },
    {
      "name": "t:won.presets.trust_badges",
      "category": "t:won.categories.content",
      "settings": { "columns_desktop": 4, "item_style": "bordered", "content_align": "center" },
      "blocks": [{ "type": "won-feature" }, { "type": "won-feature" }, { "type": "won-feature" }, { "type": "won-feature" }]
    }
  ]
}
{% endschema %}
