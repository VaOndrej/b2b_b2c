{%- liquid
  assign s = section.settings
  assign rows = s.rows | newline_to_br | split: '<br />'
-%}
<section
  class="won-section color-{{ s.color_scheme }} {% render 'won-visibility', settings: s %}"
  style="{% render 'won-style-vars', settings: s %}"
  data-testid="won-comparison-section"
>
  {% render 'won-guard', settings: s %}
  <div class="won-container{% if s.section_width == 'full' %} won-container--full{% endif %} won-cmp-wrap">
    {%- if s.heading != blank -%}
      <h2
        class="won-heading won-cmp__heading"
        style="--won-h-size-m: {{ s.heading_size_mobile }}px; --won-h-size-d: {{ s.heading_size_desktop }}px; --won-h-mw-m: {{ s.heading_max_width_mobile }}%; --won-h-mw-d: {{ s.heading_max_width_desktop }}%;"
      >
        {{- s.heading | replace: '</p><p>', '<br>' | remove: '<p>' | remove: '</p>' | strip -}}
      </h2>
    {%- endif -%}
    <div class="won-cmp__scroll">
      {%- assign header_cells = rows[0] | split: '|' -%}
      <table class="won-cmp__table">
        <thead>
          <tr>
            {%- for c in header_cells -%}
              <th scope="col" {% if forloop.index == s.highlight_col %}class="is-us"{% endif %}>{{ c | strip }}</th>
            {%- endfor -%}
          </tr>
        </thead>
        <tbody>
          {%- for line in rows offset: 1 -%}
            {%- assign row = line | strip -%}
            {%- unless row == blank -%}
              {%- assign cells = row | split: '|' -%}
              <tr>
                {%- for c in cells -%}
                  {%- assign val = c | strip -%}
                  {%- assign vl = val | downcase -%}
                  {%- if forloop.first -%}
                    <th scope="row">{{ val }}</th>
                  {%- else -%}
                    <td {% if forloop.index == s.highlight_col %}class="is-us"{% endif %}>
                      {%- if vl == 'yes' or vl == 'ano' -%}
                        <svg class="won-cmp__yes" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M4 10.5l4 4 8-9" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                      {%- elsif vl == 'no' or vl == 'ne' -%}
                        <svg class="won-cmp__no" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M5 5l10 10M15 5L5 15" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                      {%- elsif vl contains 'dots:' -%}
                        {%- assign dspec = vl | remove: 'dots:' | strip -%}
                        {%- assign dfilled = dspec | split: '/' | first | times: 1 -%}
                        {%- assign dtotal = 4 -%}
                        {%- if dspec contains '/' -%}{%- assign dtotal = dspec | split: '/' | last | times: 1 -%}{%- endif -%}
                        <span class="won-cmp__dots" role="img" aria-label="{{ dfilled }}/{{ dtotal }}">
                          {%- for i in (1..dtotal) -%}<span class="won-cmp__dot{% if i <= dfilled %} is-on{% endif %}"></span>{%- endfor -%}
                        </span>
                      {%- else -%}
                        {{ val }}
                      {%- endif -%}
                    </td>
                  {%- endif -%}
                {%- endfor -%}
              </tr>
            {%- endunless -%}
          {%- endfor -%}
        </tbody>
      </table>
    </div>
  </div>
</section>

{% stylesheet %}
  .won-cmp-wrap { display: flex; flex-direction: column; gap: var(--won-space-5); }
  .won-cmp__heading { font-size: var(--won-h-size-m, 1.8rem); max-width: var(--won-h-mw-m, 100%); }
  .won-cmp__scroll { overflow-x: auto; }
  .won-cmp__table { inline-size: 100%; border-collapse: collapse; min-inline-size: 480px; table-layout: fixed; }
  .won-cmp__table th,
  .won-cmp__table td { padding: var(--won-space-3) var(--won-space-4); text-align: center; vertical-align: middle; border-block-end: 1px solid var(--won-border); }
  .won-cmp__table th:first-child,
  .won-cmp__table td:first-child { inline-size: 42%; }
  .won-cmp__table thead th { font-size: 0.9rem; text-transform: uppercase; letter-spacing: 0.05em; }
  .won-cmp__table tbody th { text-align: start; font-weight: 500; }
  .won-cmp__table .is-us { background: color-mix(in oklab, var(--won-accent) 12%, transparent); }
  .won-cmp__table thead .is-us { border-radius: var(--won-radius-sm) var(--won-radius-sm) 0 0; color: var(--won-accent); font-weight: 800; }
  .won-cmp__yes { display: block; margin-inline: auto; inline-size: 20px; block-size: 20px; color: var(--won-accent); }
  .won-cmp__no { display: block; margin-inline: auto; inline-size: 18px; block-size: 18px; opacity: 0.4; }
  /* Quality dots (NOVA-style rating) — cell value `dots:2/4`. */
  .won-cmp__dots { display: inline-flex; gap: 5px; justify-content: center; }
  .won-cmp__dot { inline-size: 10px; block-size: 10px; border-radius: 50%; border: 1.5px solid var(--won-border); }
  .won-cmp__dot.is-on { background: var(--won-accent); border-color: var(--won-accent); }
  /* Mobile reads centered like the rest of the page — the feature (row-label)
     column joins the centered heading instead of sitting left under it. Desktop
     keeps row-labels start-aligned (standard comparison-table readability). */
  @media (max-width: 749px) {
    .won-cmp__table tbody th { text-align: center; }
  }
  @media (min-width: 750px) {
    .won-cmp__heading { font-size: var(--won-h-size-d, 2.4rem); max-width: var(--won-h-mw-d, 100%); }
  }
{% endstylesheet %}

