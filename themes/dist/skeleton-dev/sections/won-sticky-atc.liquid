{%- liquid
  assign s = section.settings
  assign has_product = false
  if product != blank and product.id != blank
    assign has_product = true
  endif
  assign pv = product.selected_or_first_available_variant
-%}
{%- if has_product -%}
{%- comment -%}The colour-scheme class is what puts the host theme's button and
  surface variables in scope; without it `cta_style: theme` silently falls back to
  the Won accent, because Horizon defines --color-primary-button-* on .color-<id>.
{%- endcomment -%}
<section class="won-sticky-host won-sticky-host--scope-{{ s.device_scope | default: 'both' }} color-{{ s.color_scheme | default: 'scheme-1' }}" data-testid="won-sticky-atc-section">
  <won-sticky-atc class="won-sticky won-sticky--{{ s.bar_style | default: 'full' }}" style="--won-radius-md: {{ s.corner_radius | default: 14 }}px; --won-sticky-offset: {{ s.offset_bottom | default: 12 }}px;" data-hidden>
    <div class="won-sticky__inner won-container">
      {%- if product.featured_image -%}
        <img class="won-sticky__thumb" src="{{ product.featured_image | image_url: width: 120 }}" alt="" width="48" height="48" loading="lazy">
      {%- endif -%}
      <span class="won-sticky__title">{{ product.title }}</span>
      <span class="won-sticky__price" data-sticky-price>{{ pv.price | money }}</span>
      <button type="button" class="won-btn won-btn--primary won-sticky__atc won-sticky__atc--{{ s.cta_style | default: 'theme' }}" data-won-add data-variant-id="{{ pv.id }}" data-added-label="{{ 'won.cart.added' | t }}">
        <span class="won-pcard__add-label">{%- if s.atc_label != blank -%}{{ s.atc_label }}{%- else -%}{{ 'won.cart.add' | t }}{%- endif -%}</span>
      </button>
    </div>
  </won-sticky-atc>
</section>
{%- endif -%}

{% stylesheet %}
  /* Device scope — hide the whole sticky bar on the breakpoint it's not meant for. */
  @media (min-width: 750px) { .won-sticky-host--scope-mobile .won-sticky { display: none !important; } }
  @media (max-width: 749px) { .won-sticky-host--scope-desktop .won-sticky { display: none !important; } }
  .won-sticky {
    position: fixed; inset-inline: 0; inset-block-end: 0; z-index: 40;
    background: var(--won-bg); border-block-start: 1px solid var(--won-border);
    box-shadow: 0 -6px 24px color-mix(in oklab, var(--won-fg) 10%, transparent);
    transform: translateY(110%); transition: transform var(--won-dur) var(--won-ease);
  }
  .won-sticky.is-visible { transform: translateY(0); }
  .won-sticky__inner { display: flex; align-items: center; gap: var(--won-space-3); padding-block: var(--won-space-2); }
  .won-sticky__thumb { inline-size: 48px; block-size: 48px; border-radius: var(--won-radius-sm); object-fit: cover; flex: 0 0 auto; }
  .won-sticky__title { font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .won-sticky__price { font-weight: 700; color: var(--won-fg); margin-inline-start: auto; white-space: nowrap; }
  .won-sticky__atc { flex: 0 0 auto; }
  /* The sticky bar repeats the SAME action as the buy box, so by default it must be
     the same button. Two shapes and two colours for one action read as two different
     offers. `theme` borrows the host theme's primary-button tokens (Horizon exposes
     --color-primary-button-* and --style-border-radius-buttons-primary); every value
     falls back to the won accent pill, so the section still renders standalone on
     Skeleton or bare Liquid. `accent` keeps the Won pill for merchants who want the
     bar to stand apart. */
  /* Doubled selector (0,0,2,0): won-tokens.css loads after the section stylesheet,
     so a single class would lose to .won-btn--primary on source order alone. */
  .won-sticky .won-sticky__atc--theme {
    background: var(--color-primary-button-background, var(--won-accent));
    color: var(--color-primary-button-text, var(--won-accent-contrast));
    border-color: var(--color-primary-button-border, transparent);
    border-radius: var(--style-border-radius-buttons-primary, var(--won-radius-pill));
  }
  .won-sticky .won-sticky__atc--theme:hover {
    background: var(--color-primary-button-hover-background, var(--won-accent));
    color: var(--color-primary-button-hover-text, var(--won-accent-contrast));
  }
  @media (min-width: 750px) {
    .won-sticky__price { margin-inline-start: 0; }
    .won-sticky__title { margin-inline-end: auto; }
  }
  /* Visual variants — switchable in the theme editor. */
  .won-sticky--compact .won-sticky__thumb { display: none; }
  .won-sticky--minimal .won-sticky__thumb,
  .won-sticky--minimal .won-sticky__title { display: none; }
  .won-sticky--minimal .won-sticky__price { margin-inline-start: 0; margin-inline-end: var(--won-space-3); }
  .won-sticky--minimal .won-sticky__atc { flex: 1 1 auto; }

  /* Floating styles — not edge-to-edge: a rounded, shadowed card offset from the
     bottom edge. Center = a compact pill in the middle; Corner = a small card in
     the bottom-inline-end corner (price + Add). Both honour the editor's
     corner-radius + bottom-offset via the --won-* vars set inline on the host. */
  .won-sticky--center,
  .won-sticky--corner {
    inset-block-end: var(--won-sticky-offset, var(--won-space-3));
    border: 1px solid var(--won-border);
    border-radius: var(--won-radius-md);
    box-shadow: 0 8px 28px color-mix(in oklab, var(--won-fg) 16%, transparent);
  }
  .won-sticky--center {
    inset-inline: 0; margin-inline: auto;
    inline-size: fit-content;
    max-inline-size: min(560px, calc(100% - var(--won-space-4)));
  }
  .won-sticky--corner {
    inset-inline-start: auto; inset-inline-end: var(--won-space-3);
    inline-size: auto;
    max-inline-size: min(360px, calc(100% - var(--won-space-4)));
  }
  .won-sticky--center .won-sticky__inner,
  .won-sticky--corner .won-sticky__inner { padding-inline: var(--won-space-3); }
  /* Center is a COMPACT pill (task: "kompaktní verze uprostřed") — drop the
     thumbnail so it stays a tidy pill, name + price + Add, even on a phone. */
  .won-sticky--center .won-sticky__thumb { display: none; }
  /* Corner is intentionally tiny: the shopper is already on the product page, so
     price + Add is enough; the title would force an awkward width. */
  .won-sticky--corner .won-sticky__thumb,
  .won-sticky--corner .won-sticky__title { display: none; }
  .won-sticky--corner .won-sticky__price { margin-inline-start: 0; margin-inline-end: var(--won-space-2); }

  @media (prefers-reduced-motion: reduce) { .won-sticky { transition: none; } }
{% endstylesheet %}

{% javascript %}
  class WonStickyAtc extends HTMLElement {
    connectedCallback() {
      if (this.dataset.wonBound) return;
      this.dataset.wonBound = '1';
      this.priceEl = this.querySelector('[data-sticky-price]');
      this.btn = this.querySelector('[data-won-add]');
      // Mirror the main buy area's variant selection when a won-variant-picker is present.
      document.addEventListener('won:variant:change', (e) => {
        var v = e.detail && e.detail.variant;
        if (!v) return;
        if (this.priceEl && v.price) this.priceEl.textContent = v.price;
        if (this.btn && v.id) this.btn.setAttribute('data-variant-id', v.id);
        if (this.btn) this.btn.disabled = v.available === false;
      });
      // Reveal once the primary buy area scrolls out of view.
      var target = document.querySelector('won-variant-picker')
        || document.querySelector('[data-testid="won-variant-picker-section"]')
        || document.querySelector('product-form-component, .product-form, main h1');
      if (target && 'IntersectionObserver' in window) {
        this.observer = new IntersectionObserver((entries) => {
          entries.forEach((en) => {
            this.classList.toggle('is-visible', !en.isIntersecting && en.boundingClientRect.top < 0);
          });
        }, { threshold: 0 });
        this.observer.observe(target);
      } else {
        this.classList.add('is-visible');
      }
    }
    disconnectedCallback() { if (this.observer) this.observer.disconnect(); }
  }
  if (!customElements.get('won-sticky-atc')) customElements.define('won-sticky-atc', WonStickyAtc);
{% endjavascript %}

{% schema %}
{
  "name": "t:won.names.sticky_atc",
  "tag": "section",
  "settings": [
    { "type": "paragraph", "content": "t:won.info.sticky_atc" },
    { "type": "header", "content": "t:won.headers.mode" },
    {
      "type": "select", "id": "bar_style", "label": "t:won.settings.sticky_style",
      "info": "t:won.info.sticky_style",
      "options": [
        { "value": "full", "label": "t:won.options.sticky_full" },
        { "value": "compact", "label": "t:won.options.sticky_compact" },
        { "value": "minimal", "label": "t:won.options.sticky_minimal" },
        { "value": "center", "label": "t:won.options.sticky_center" },
        { "value": "corner", "label": "t:won.options.sticky_corner" }
      ],
      "default": "full"
    },
    {
      "type": "select", "id": "device_scope", "label": "t:won.settings.device_scope", "info": "t:won.info.device_scope",
      "options": [
        { "value": "both", "label": "t:won.options.device_both" },
        { "value": "mobile", "label": "t:won.options.device_mobile" },
        { "value": "desktop", "label": "t:won.options.device_desktop" }
      ],
      "default": "both"
    },
    { "type": "header", "content": "t:won.headers.content" },
    { "type": "text", "id": "atc_label", "label": "t:won.settings.vp_atc_label" },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:won.settings.color_scheme", "default": "scheme-1" },
    {
      "type": "select", "id": "cta_style", "label": "t:won.settings.sticky_cta_style",
      "info": "t:won.info.sticky_cta_style",
      "options": [
        { "value": "theme", "label": "t:won.options.cta_style_theme" },
        { "value": "accent", "label": "t:won.options.cta_style_accent" }
      ],
      "default": "theme"
    },
    { "type": "header", "content": "t:won.headers.appearance" },
    {
      "type": "range", "id": "corner_radius", "label": "t:won.settings.sticky_radius",
      "info": "t:won.info.sticky_radius",
      "min": 0, "max": 28, "step": 2, "unit": "px", "default": 14
    },
    {
      "type": "range", "id": "offset_bottom", "label": "t:won.settings.sticky_offset",
      "info": "t:won.info.sticky_offset",
      "min": 0, "max": 40, "step": 2, "unit": "px", "default": 12
    }
  ],
  "presets": [{ "name": "t:won.names.sticky_atc", "category": "t:won.categories.products" }]
}
{% endschema %}
