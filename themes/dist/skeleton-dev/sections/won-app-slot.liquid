{%- assign s = section.settings -%}
<section
  class="won-section color-{{ s.color_scheme }}"
  style="{% render 'won-style-vars', settings: s %}"
  data-testid="won-app-slot-section"
>
  <div class="won-container{% if s.section_width == 'full' %} won-container--full{% endif %}">
    {%- if section.blocks.size > 0 -%}
      {% content_for 'blocks' %}
    {%- else -%}
      <div class="won-app-slot__empty">
        {%- if s.heading != blank -%}<p class="won-app-slot__heading">{{ s.heading }}</p>{%- endif -%}
        {%- if s.text != blank -%}<div class="won-app-slot__text rte">{{ s.text }}</div>{%- endif -%}
        {%- if s.cta_label != blank -%}
          <a class="won-btn won-btn--primary" {% if s.cta_url != blank %}href="{{ s.cta_url }}" target="_blank" rel="noopener"{% endif %}>{{ s.cta_label }}</a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .won-app-slot__empty {
    display: flex; flex-direction: column; gap: var(--won-space-3); align-items: center; text-align: center;
    padding: var(--won-space-6); border: 1px dashed var(--won-border); border-radius: var(--won-radius-md);
    background: var(--won-surface);
  }
  .won-app-slot__heading { margin: 0; font-weight: 700; font-size: 1.1rem; }
  .won-app-slot__text { opacity: 0.85; max-inline-size: 46ch; }
{% endstylesheet %}

{% schema %}
{
  "name": "t:won.names.app_slot",
  "tag": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "blocks": [
    {
      "type": "@app"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "t:won.headers.content"
    },
    {
      "type": "paragraph",
      "content": "t:won.info.app_slot"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:won.settings.heading",
      "default": "t:won.defaults.app_slot_heading"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:won.settings.text",
      "default": "t:won.defaults.app_slot_text"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "t:won.settings.button_label",
      "default": "t:won.defaults.app_slot_cta"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "t:won.settings.button_link"
    },
    {
      "type": "header",
      "content": "t:won.headers.appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:won.settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:won.settings.section_width",
      "options": [
        {
          "value": "page",
          "label": "t:won.options.width_page"
        },
        {
          "value": "full",
          "label": "t:won.options.width_full"
        }
      ],
      "default": "page"
    },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "t:won.settings.corner_radius",
      "info": "t:won.info.corner_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "t:won.settings.border_width",
      "info": "t:won.info.border_width",
      "min": 0,
      "max": 8,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "select",
      "id": "border_style",
      "label": "t:won.settings.border_style",
      "options": [
        {
          "value": "solid",
          "label": "t:won.options.solid"
        },
        {
          "value": "dashed",
          "label": "t:won.options.dashed"
        }
      ],
      "default": "solid",
      "visible_if": "{{ section.settings.border_width > 0 }}"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "t:won.settings.border_color",
      "info": "t:won.info.border_color",
      "visible_if": "{{ section.settings.border_width > 0 }}"
    },
    {
      "type": "select",
      "id": "shadow",
      "label": "t:won.settings.shadow",
      "info": "t:won.info.shadow",
      "options": [
        {
          "value": "none",
          "label": "t:won.options.none"
        },
        {
          "value": "sm",
          "label": "t:won.options.shadow_sm"
        },
        {
          "value": "md",
          "label": "t:won.options.shadow_md"
        },
        {
          "value": "lg",
          "label": "t:won.options.shadow_lg"
        }
      ],
      "default": "none"
    },
    {
      "type": "color",
      "id": "accent_override",
      "label": "t:won.settings.accent_color",
      "info": "t:won.info.accent_color"
    },
    {
      "type": "checkbox",
      "id": "hide_mobile",
      "label": "t:won.settings.hide_mobile",
      "info": "t:won.info.hide_mobile",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_desktop",
      "label": "t:won.settings.hide_desktop",
      "info": "t:won.info.hide_desktop",
      "default": false
    },
    {
      "type": "header",
      "content": "t:won.headers.padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:won.settings.padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:won.settings.padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "t:won.names.app_slot",
      "category": "t:won.categories.apps"
    }
  ]
}
{% endschema %}
