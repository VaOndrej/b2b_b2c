{%- liquid
  assign s = section.settings
  assign has_media = false
  if s.image != blank
    assign has_media = true
  endif
-%}
<section
  class="won-section color-{{ s.color_scheme }}"
  style="{% render 'won-style-vars', settings: s %}"
  data-testid="won-page-header-section"
>
  {% render 'won-guard', settings: s %}
  <div class="won-container{% if s.section_width == 'full' %} won-container--full{% endif %}">
    <div
      class="won-page-header{% if has_media %} won-page-header--media{% endif %}"
      style="--won-ph-align: {{ s.content_align }};{% if s.min_height > 0 %}--won-ph-min: {{ s.min_height }}px;{% endif %}"
    >
      {%- if has_media -%}
        <div class="won-page-header__media">
          {%- if s.toggle_overlay -%}<span class="won-page-header__overlay" style="background: {{ s.overlay_color }};"></span>{%- endif -%}
          {{ s.image | image_url: width: 2400 | image_tag: widths: '800, 1200, 1800, 2400', sizes: '100vw', class: 'won-page-header__img', loading: 'eager', alt: s.image.alt | default: '' }}
        </div>
      {%- endif -%}
      <div class="won-page-header__content">
        {%- if s.heading != blank -%}
          <h1
            class="won-heading won-page-header__heading"
            style="--won-h-size-m: {{ s.heading_size_mobile }}px; --won-h-size-d: {{ s.heading_size_desktop }}px; --won-h-mw-m: {{ s.heading_max_width_mobile }}%; --won-h-mw-d: {{ s.heading_max_width_desktop }}%;"
          >
            {{- s.heading | replace: '</p><p>', '<br>' | remove: '<p>' | remove: '</p>' | strip -}}
          </h1>
        {%- endif -%}
        {%- if s.subheading != blank -%}<div class="won-page-header__sub rte">{{ s.subheading }}</div>{%- endif -%}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .won-page-header__content { display: flex; flex-direction: column; gap: var(--won-space-3); text-align: var(--won-ph-align, left); align-items: var(--won-ph-align, flex-start); }
  .won-page-header__heading { font-size: var(--won-h-size-m, 2rem); max-width: var(--won-h-mw-m, 100%); }
  .won-page-header__sub { opacity: 0.9; max-inline-size: 60ch; }
  .won-page-header--media {
    position: relative; overflow: hidden; border-radius: var(--won-radius-lg);
    min-block-size: var(--won-ph-min, 320px); display: flex; align-items: center; padding: var(--won-space-6);
  }
  .won-page-header--media .won-page-header__media { position: absolute; inset: 0; }
  .won-page-header--media .won-page-header__img { inline-size: 100%; block-size: 100%; object-fit: cover; }
  .won-page-header--media .won-page-header__overlay { position: absolute; inset: 0; z-index: 1; }
  .won-page-header--media .won-page-header__content { position: relative; z-index: 2; }
  @media (min-width: 750px) {
    .won-page-header__heading { font-size: var(--won-h-size-d, 3rem); max-width: var(--won-h-mw-d, 100%); }
  }
{% endstylesheet %}

