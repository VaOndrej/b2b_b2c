{%- comment -%}
  won-tabbed-rail — a product rail with a segmented SOURCE SWITCH (tabs), e.g.
  Bestsellers ⇄ New Arrivals (pebble / stack / flow). Each `tab` local block is a
  collection; the shared won-panels.js <won-tabset> builds the tab nav from each
  panel's data-title and toggles panels. Rails are plain CSS scroll-snap (global
  .won-pcard cards) — no won-carousel.js dependency, so a hidden panel binding at
  0 width is a non-issue. Self-contained styles (the tabset nav classes are hard-
  coded by won-panels.js, so their styles are duplicated here on purpose).
{%- endcomment -%}

{%- assign s = section.settings -%}
{%- comment -%} Rail controls are resolved once, in snippets/won-rail-controls.liquid,
  so a tab panel cannot drift from the rails beside it on the same page. {%- endcomment -%}
<section
  class="won-section won-tabrail-sec color-{{ s.color_scheme }}"
  style="{% render 'won-style-vars', settings: s %}"
  data-testid="won-tabbed-rail-section"
>
  {% render 'won-guard', settings: s %}
  <div class="won-container{% if s.section_width == 'full' %} won-container--full{% endif %} won-tabrail-wrap">
    {%- if s.heading != blank -%}
      <h2
        class="won-heading won-tabrail__heading"
        style="--won-h-size-m: {{ s.heading_size_mobile }}px; --won-h-size-d: {{ s.heading_size_desktop }}px;"
      >
        {{- s.heading | replace: '</p><p>', '<br>' | remove: '<p>' | remove: '</p>' | strip -}}
      </h2>
    {%- endif -%}

    <won-tabset
      class="won-tabrail"
      style="--won-cols-lg: {{ s.columns_desktop }}; --won-cols-md: {{ s.columns_tablet }}; --won-cols-sm: {{ s.columns_mobile }}; --won-gap: {{ s.gap }}px;"
    >
      <div class="won-panels__nav" role="tablist"></div>
      <div class="won-panels__panels">
        {%- for block in section.blocks -%}
          {%- assign bs = block.settings -%}
          {%- assign col = collections[bs.collection] -%}
          <div
            class="won-panels__panel won-tabrail__panel"
            id="won-panelpanel-{{ block.id }}"
            role="tabpanel"
            data-title="{{ bs.title | default: col.title | default: 'Tab' | escape }}"
            {% if bs.open %}data-won-default="true"{% endif %}
            {{ block.shopify_attributes }}
          >
            {%- if col != blank and col.products.size > 0 -%}
              {%- comment -%} Each tab panel IS a rail: `overflow-x: auto`, it really
                scrolls, and it used to render no arrows, no bar and no engine marker —
                so it looked like a carousel but could only be dragged. It stayed
                JS-free because a hidden panel binds at zero width and the fit-aware
                gate would hide the controls forever; won-carousel.js now observes its
                track with a ResizeObserver, so revealing a tab re-measures and the
                original objection no longer holds. {%- endcomment -%}
              <won-carousel class="won-carousel won-carousel--tabrail" data-mobile-mode="{{ s.columns_mobile | default: '1.2' }}" data-won-rail-indicator="{{ settings.won_rail_indicator | default: 'per_section' }}">
              <div class="won-tabrail__track{% if s.columns_mobile contains '.' %} won-tabrail--peek{% endif %}" data-won-track>
                {%- for product in col.products limit: bs.products_limit -%}
                  {%- comment -%} Gift cards are a payment instrument, not part of the range: they
                    have no packshot, no unit price and no place in "all products". Skipped inside
                    the loop rather than filtered upstream, because Liquid cannot rebuild a
                    paginated collection — and `!= false` so an unset setting still hides them. {%- endcomment -%}
                  {%- if settings.won_hide_gift_cards != false and product.gift_card? -%}{%- continue -%}{%- endif -%}
                  <div class="won-tabrail__item">
                    {% render 'won-product-card', product: product, aspect: s.card_aspect %}
                  </div>
                {%- endfor -%}
              </div>
              {% render 'won-rail-controls', s: s %}
              </won-carousel>
            {%- else -%}
              <p class="won-tabrail__empty">{{ 'won.a11y.no_products' | t }}</p>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    </won-tabset>
  </div>
</section>

<script src="{{ 'won-panels.js' | asset_url }}" defer></script>

{% stylesheet %}
  .won-tabrail-wrap { display: flex; flex-direction: column; gap: var(--won-space-4); }
  .won-tabrail__heading { font-size: var(--won-h-size-m, 1.6rem); }
  @media (min-width: 750px) { .won-tabrail__heading { font-size: var(--won-h-size-d, 2rem); } }

  /* Tabset nav — won-panels.js creates buttons with the .won-panels__tab class,
     so these rules must exist even when no won-panels section is on the page. */
  .won-tabrail .won-panels__nav {
    display: flex; flex-wrap: wrap; gap: var(--won-space-2);
    border-block-end: 1px solid var(--won-border); margin-block-end: var(--won-space-4);
  }
  .won-tabrail .won-panels__nav:empty { display: none; border: 0; margin: 0; }
  .won-tabrail .won-panels__tab {
    padding: var(--won-space-3) var(--won-space-4); border: 0; background: transparent; color: var(--won-fg);
    font: inherit; font-weight: 600; cursor: pointer; border-block-end: 2px solid transparent;
    margin-block-end: -1px; min-block-size: 44px;
  }
  .won-tabrail .won-panels__tab[aria-selected="true"] { color: var(--won-accent); border-block-end-color: var(--won-accent); }
  .won-tabrail__panel[hidden] { display: none; }

  /* Rail — plain scroll-snap; cards are the global .won-pcard. */
  .won-tabrail__track {
    display: flex; gap: var(--won-gap, 16px);
    overflow-x: auto; scroll-snap-type: x mandatory; scroll-behavior: smooth;
    scrollbar-width: none; --won-cols-cur: var(--won-cols-sm, 1); padding-bottom: 2px;
  }
  .won-tabrail__track::-webkit-scrollbar { display: none; }
  /* Peek rail = STEJNÁ geometrie jako won-carousel. Vlastní basis z columns_mobile
     dávala výhled na sousedа jen ~15 px, zatímco ostatní raily mají ~27 px —
     tak mělký peek se čte jako oříznutí, ne jako „je toho víc". Fixní 76 % se
     stropem --won-card-max je přesně to, co používá .won-carousel--peek-mobile. */
  @media (max-width: 749px) {
    .won-tabrail--peek .won-tabrail__item {
      scroll-snap-align: center;
      flex: 0 0 min(76%, var(--won-card-max, 380px));
    }
  }
  .won-tabrail__item {
    /* Start-snap by default; a FRACTIONAL columns_mobile (1.2 = "show a bit of
       the next one") is a peek rail, and a peek only reads as a peek when the
       resting card is centred — start-snap pins it left and the neighbour on the
       left never appears. Same rule and same feel as .won-carousel--peek-mobile,
       so `1.2` means the same thing in every rail on the page. */
    scroll-snap-align: start;
    flex: 0 0 calc((100% - (var(--won-cols-cur) - 1) * var(--won-gap, 16px)) / var(--won-cols-cur));
  }
  .won-tabrail__empty { opacity: 0.7; }
  @media (prefers-reduced-motion: reduce) { .won-tabrail__track { scroll-behavior: auto; } }
  /* Ceiling on the rail item below the tablet breakpoint: a percentage basis
     that suits a 390px phone makes a 746px-tall card on a 700px pane. Same fix
     and same token as won-carousel / won-grid. */
  @media (max-width: 749px) {
    .won-tabrail__track > * {
      flex-basis: min(
        calc((100% - (var(--won-cols-cur) - 1) * var(--won-gap, 16px)) / var(--won-cols-cur)),
        var(--won-card-max, 380px)
      );
    }
  }
  /* 750, not 768: the breakpoint canon shared with won-carousel, won-grid and
     won-collection. A mismatched pair leaves a band where neither rule applies. */
  @media (min-width: 750px) { .won-tabrail__track { --won-cols-cur: var(--won-cols-md, 2); } }
  @media (min-width: 1024px) { .won-tabrail__track { --won-cols-cur: var(--won-cols-lg, 4); } }
{% endstylesheet %}

{% schema %}
{
  "name": "t:won.names.tabbed_rail",
  "tag": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "max_blocks": 6,
  "blocks": [
    {
      "type": "tab",
      "name": "t:won.names.tabrail_tab",
