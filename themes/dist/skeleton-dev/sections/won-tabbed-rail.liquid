          "max": 24,
          "step": 1,
          "default": 8
        },
        {
          "type": "checkbox",
          "id": "open",
          "label": "t:won.settings.default_tab",
          "info": "t:won.info.default_tab",
          "default": false
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "paragraph",
      "content": "t:won.info.tabbed_rail_about"
    },
    {
