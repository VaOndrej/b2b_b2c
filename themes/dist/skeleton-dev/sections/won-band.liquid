{%- liquid
  assign s = section.settings
  assign has_media = false
  if s.media_type == 'image' and s.image != blank
    assign has_media = true
  elsif s.media_type == 'image' and s.image_asset != blank
    assign has_media = true
  elsif s.media_type == 'video' and s.video != blank
    assign has_media = true
  endif
  assign is_bg = false
  if s.media_position == 'background' and has_media
    assign is_bg = true
  endif
  assign is_gutter = false
  if s.media_position == 'center_gutter'
    assign is_gutter = true
  endif
  assign has_media2 = false
  if s.image_2 != blank or s.image_asset_2 != blank
    assign has_media2 = true
  endif
  assign layout = 'stacked'
  if is_bg
    assign layout = 'overlay'
  elsif is_gutter
    assign layout = 'gutter'
  elsif has_media
    assign layout = 'split'
  endif
  # content_align is a text_alignment control (left|center|right) — valid for
  # text-align, but align-items needs a flex keyword, so map it separately.
  assign flex_align = 'flex-start'
  if s.content_align == 'center'
    assign flex_align = 'center'
  elsif s.content_align == 'right'
    assign flex_align = 'flex-end'
  endif
-%}

<section
  class="won-section color-{{ s.color_scheme }}"
  style="{% render 'won-style-vars', settings: s %}"
  data-testid="won-band-section"
>
  {% render 'won-guard', settings: s %}
  <div class="won-container{% if s.section_width == 'full' %} won-container--full{% endif %}">
    <div
      class="won-band won-band--{{ layout }} won-band--media-{{ s.media_position }}"
      style="--won-band-align: {{ s.content_align }};--won-band-flex: {{ flex_align }};{% if s.min_height > 0 %}--won-band-min: {{ s.min_height }}px;{% endif %}"
    >
      {%- if has_media -%}
        <div class="won-band__media">
          {%- if is_bg and s.toggle_overlay -%}
            <span class="won-band__overlay" style="background: {{ s.overlay_color }};"></span>
          {%- endif -%}
          {%- if s.media_type == 'image' -%}
            {%- if s.image != blank -%}
              {{ s.image | image_url: width: 2400 | image_tag: widths: '600, 900, 1200, 1800, 2400', sizes: '(min-width: 750px) 50vw, 100vw', class: 'won-band__img', loading: 'lazy', alt: s.image.alt | default: '' }}
            {%- else -%}
              <img class="won-band__img" src="{{ s.image_asset | asset_url }}" alt="" width="2400" height="1200" loading="lazy">
            {%- endif -%}
          {%- else -%}
            {{ s.video | video_tag: autoplay: s.video_autoplay, loop: s.video_loop, muted: s.video_autoplay, controls: s.video_controls, class: 'won-band__video' }}
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="won-band__content">
        {%- if s.eyebrow != blank -%}
          <p class="won-band__eyebrow">{{ s.eyebrow }}</p>
        {%- endif -%}
        {%- if s.heading != blank -%}
          <h2
            class="won-heading won-band__heading"
            style="--won-h-size-m: {{ s.heading_size_mobile }}px; --won-h-size-d: {{ s.heading_size_desktop }}px; --won-h-mw-m: {{ s.heading_max_width_mobile }}%; --won-h-mw-d: {{ s.heading_max_width_desktop }}%;"
          >
            {{- s.heading | replace: '</p><p>', '<br>' | remove: '<p>' | remove: '</p>' | strip -}}
          </h2>
        {%- endif -%}
        {%- if s.body != blank -%}
          <div class="won-band__body rte">{{ s.body }}</div>
        {%- endif -%}
        {%- if s.button_label != blank or s.button2_label != blank -%}
          <div class="won-band__actions">
            {%- if s.button_label != blank -%}
              <a class="won-btn won-btn--{{ s.button_style }}" {% if s.button_link != blank %}href="{{ s.button_link }}"{% endif %}>{{ s.button_label }}</a>
            {%- endif -%}
            {%- if s.button2_label != blank -%}
              <a class="won-btn won-btn--{{ s.button2_style }}" {% if s.button2_link != blank %}href="{{ s.button2_link }}"{% endif %}>{{ s.button2_label }}</a>
            {%- endif -%}
          </div>
        {%- endif -%}
        {% content_for 'blocks' %}
      </div>

      {%- if is_gutter and has_media2 -%}
        <div class="won-band__media won-band__media--2">
          {%- if s.image_2 != blank -%}
            {{ s.image_2 | image_url: width: 1400 | image_tag: widths: '400, 700, 1000, 1400', sizes: '(min-width: 750px) 28vw, 100vw', class: 'won-band__img', loading: 'lazy', alt: s.image_2.alt | default: '' }}
          {%- else -%}
            <img class="won-band__img" src="{{ s.image_asset_2 | asset_url }}" alt="" width="1400" height="1400" loading="lazy">
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .won-band { display: flex; flex-direction: column; gap: var(--won-space-5); }
  .won-band__content {
    display: flex;
    flex-direction: column;
    gap: var(--won-space-4);
    text-align: var(--won-band-align, left);
    align-items: var(--won-band-flex, flex-start);
  }
  .won-band__eyebrow {
    margin: 0;
    font-family: var(--font-body--family, inherit);
    font-size: 0.85rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--won-accent);
  }
  .won-band__heading {
    font-size: var(--won-h-size-m, 2rem);
    max-width: var(--won-h-mw-m, 100%);
  }
  .won-band__body { margin: 0; opacity: 0.92; max-width: 60ch; }
  .won-band__actions { display: flex; flex-wrap: wrap; gap: var(--won-space-3); }

  .won-band__media { position: relative; overflow: hidden; border-radius: var(--won-radius-md); }
  .won-band__img,
  .won-band__video { display: block; width: 100%; height: 100%; object-fit: cover; }
  .won-band__overlay { position: absolute; inset: 0; z-index: 1; }

  .won-band--overlay { position: relative; justify-content: center; align-items: var(--won-band-flex, flex-start); min-height: var(--won-band-min, 480px); border-radius: var(--won-radius-lg); overflow: hidden; padding: var(--won-space-7) var(--won-space-6); }
  .won-band--overlay .won-band__media { position: absolute; inset: 0; border-radius: 0; }
  /* Depth + header separation scrim: darken top (behind a transparent header) and
     bottom, keep the middle clear for content. */
  .won-band--overlay .won-band__media::after {
    content: ''; position: absolute; inset: 0; z-index: 1; pointer-events: none;
    background: linear-gradient(180deg, rgba(0,0,0,0.32) 0%, rgba(0,0,0,0) 26%, rgba(0,0,0,0) 62%, rgba(0,0,0,0.28) 100%);
  }
  .won-band--overlay .won-band__content { position: relative; z-index: 2; color: #fff; text-shadow: 0 1px 24px rgba(0, 0, 0, 0.28); max-inline-size: 760px; }
  .won-band--overlay .won-band__eyebrow { color: rgba(255, 255, 255, 0.92); }
  .won-band--overlay .won-band__heading,
  .won-band--overlay .won-band__body { color: #fff; }
  .won-band--overlay .won-btn--secondary { color: #fff; border-color: rgba(255, 255, 255, 0.55); background: rgba(255, 255, 255, 0.08); text-shadow: none; }
  /* Full-bleed background hero: no rounded corners. */
  .won-container--full > .won-band--overlay { border-radius: 0; }
  /* Mobile hard-rule: background heroes read centered on small screens even when
     the desktop layout is left-aligned (the side product art crops off anyway). */
  @media (max-width: 749px) {
    .won-band--overlay { align-items: center; }
    .won-band--overlay .won-band__content { align-items: center; text-align: center; }
  }

  @media (min-width: 750px) {
    .won-band__heading { font-size: var(--won-h-size-d, 3rem); max-width: var(--won-h-mw-d, 60%); }
    .won-band--split { flex-direction: row; align-items: center; }
    .won-band--split.won-band--media-right { flex-direction: row-reverse; }
    .won-band--split .won-band__media,
    .won-band--split .won-band__content { flex: 1 1 50%; }
    .won-band--split .won-band__media { align-self: stretch; min-height: var(--won-band-min, 360px); }
    /* center-gutter: media | centred copy island | media (flawless-style). */
    .won-band--gutter { flex-direction: row; align-items: center; gap: var(--won-space-6); }
    .won-band--gutter .won-band__media { flex: 1 1 28%; align-self: stretch; min-height: var(--won-band-min, 360px); }
    .won-band--gutter .won-band__content { flex: 1 1 44%; text-align: center; align-items: center; }
    .won-band--gutter .won-band__body { margin-inline: auto; }
  }
{% endstylesheet %}

