{% doc %}
won-tab — one tab (title + rich content) used inside won-tabs. The title feeds the
tab button that won-tabs builds; this block renders the matching panel.
@example
{% content_for 'block', type: 'won-tab', id: 'tab-1' %}
{% enddoc %}

{%- assign s = block.settings -%}
<div
  class="won-tabs__panel"
  role="tabpanel"
  id="won-tabpanel-{{ block.id }}"
  aria-labelledby="won-tab-{{ block.id }}"
  data-title="{{ s.title | strip_html | strip | escape }}"
  {% if s.open %}data-won-default="true"{% endif %}
  {{ block.shopify_attributes }}
>
  {%- if s.title != blank -%}
    <h3 class="won-tabs__panel-title">{{ s.title }}</h3>
  {%- endif -%}
  <div class="rte">{{ s.content }}</div>
</div>

{% schema %}
{
  "name": "t:won.names.tab",
  "settings": [
    { "type": "header", "content": "t:won.headers.content" },
    { "type": "inline_richtext", "id": "title", "label": "t:won.settings.title", "default": "t:won.defaults.tab_title" },
    { "type": "richtext", "id": "content", "label": "t:won.settings.text", "default": "t:won.defaults.tab_content" },
    { "type": "checkbox", "id": "open", "label": "t:won.settings.default_tab", "info": "t:won.info.default_tab", "default": false }
  ],
  "presets": [{ "name": "t:won.names.tab" }]
}
{% endschema %}
