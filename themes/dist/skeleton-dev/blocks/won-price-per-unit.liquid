{% doc %}
  won-price-per-unit — the "price intelligence" widget. Shows the unit price for
  the CURRENT variant. Which metafield carries the reference amount, and what unit
  the price is quoted per, is a catalogue-wide decision: it lives in the theme
  setting "Cena za jednotku" and is resolved by snippets/won-unit-price.liquid.
  Renders nothing when no rule matches the product.
  @example
  {% content_for 'block', type: 'won-price-per-unit', id: 'ppu' %}
{% enddoc %}

{%- liquid
  assign s = block.settings
-%}
{%- capture ppu -%}
  {%- render 'won-unit-price', product: product, rules: s.rules, prefix: s.prefix -%}
{%- endcapture -%}
{%- assign ppu = ppu | strip -%}

{%- comment -%}
  The wrapper is NOT optional. Horizon swaps only the elements that ask for their
  own updated markup on `variant:update`; without it this block keeps the first
  variant's unit price while the price above it changes. See won-variant-reactive.js.
{%- endcomment -%}
<won-variant-reactive data-won-vr="ppu-{{ block.id }}">
  {%- if ppu != blank -%}
    <div class="won-ppu" {{ block.shopify_attributes }}>{{ ppu }}</div>
  {%- endif -%}
</won-variant-reactive>
<script src="{{ 'won-variant-reactive.js' | asset_url }}" defer></script>

{% stylesheet %}
  .won-ppu {
    display: inline-flex; align-items: baseline; gap: 0.35em;
    color: var(--won-muted); font-size: 0.9rem;
  }
  .won-ppu__value { font-weight: 600; }
  .won-ppu__prefix { opacity: 0.85; }
{% endstylesheet %}

{% schema %}
{
  "name": "t:won.names.price_per_unit",
  "settings": [
    { "type": "paragraph", "content": "t:won.info.ppu_about" },
    { "type": "text", "id": "prefix", "label": "t:won.settings.ppu_prefix" },
    { "type": "textarea", "id": "rules", "label": "t:won.settings.ppu_rules_override", "info": "t:won.info.ppu_rules_override" }
  ],
  "presets": [{ "name": "t:won.names.price_per_unit" }]
}
{% endschema %}
