{% doc %}
won-video — a responsive video embed (Shopify-hosted or external URL) with an
optional heading. Self-contained; for PDP or any section accepting theme blocks.
@example
{% content_for 'block', type: 'won-video', id: 'video' %}
{% enddoc %}

{%- liquid
  assign s = block.settings
  assign video_ratio = s.aspect_ratio | default: s.aspect | default: '16/9'
  if video_ratio == 'adaptive'
    assign video_ratio = '16/9'
    unless s.video_type == 'external'
      assign video_ratio = s.video.aspect_ratio | default: video_ratio
    endunless
  endif
-%}
<div class="won-video" style="--won-video-ratio: {{ video_ratio }}; --won-video-fit: {{ s.fit | default: 'cover' }};" {{ block.shopify_attributes }}>
  {%- if s.heading != blank -%}<p class="won-video__heading">{{ s.heading }}</p>{%- endif -%}
  <div class="won-video__frame">
    {%- if s.video_type == 'external' and s.video_url != blank -%}
      {%- assign video_title = s.heading | strip_html -%}
      {%- if video_title == blank -%}{%- assign video_title = 'won.a11y.video' | t -%}{%- endif -%}
      <iframe
        class="won-video__el"
        src="{% if s.video_url.type == 'youtube' %}https://www.youtube.com/embed/{{ s.video_url.id | escape }}{% else %}https://player.vimeo.com/video/{{ s.video_url.id | escape }}{% endif %}"
        title="{{ video_title | escape }}"
        loading="lazy"
        allow="accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture"
        allowfullscreen
      ></iframe>
    {%- elsif s.video != blank -%}
      {{ s.video | video_tag: controls: true, class: 'won-video__el', image_size: '1200x' }}
    {%- else -%}
      <div class="won-video__placeholder">{{ 'lifestyle-1' | placeholder_svg_tag: 'won-video__el' }}</div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .won-video__heading { margin: 0 0 var(--won-space-3); font-weight: 700; }
  .won-video__frame { position: relative; aspect-ratio: var(--won-video-ratio, 16/9); border-radius: var(--won-radius-md); overflow: hidden; background: var(--won-surface); }
  .won-video__el,
  .won-video__frame iframe { position: absolute; inset: 0; inline-size: 100%; block-size: 100%; object-fit: var(--won-video-fit, cover); border: 0; }
{% endstylesheet %}

{% schema %}
{
  "name": "t:won.names.video",
  "settings": [
    { "type": "header", "content": "t:won.headers.content" },
    { "type": "inline_richtext", "id": "heading", "label": "t:won.settings.heading" },
    {
      "type": "select", "id": "video_type", "label": "t:won.settings.video_type",
      "options": [
        { "value": "hosted", "label": "t:won.options.video_hosted" },
        { "value": "external", "label": "t:won.options.video_external" }
      ],
      "default": "hosted"
    },
    { "type": "video", "id": "video", "label": "t:won.settings.video", "visible_if": "{{ block.settings.video_type == 'hosted' }}" },
    { "type": "video_url", "id": "video_url", "label": "t:won.settings.video_url", "accept": ["youtube", "vimeo"], "visible_if": "{{ block.settings.video_type == 'external' }}" },
    { "type": "header", "content": "t:won.headers.layout" },
    {
      "type": "select", "id": "aspect_ratio", "label": "t:won.settings.card_aspect",
      "options": [
        { "value": "16/9", "label": "16:9" },
        { "value": "4/3", "label": "4:3" },
        { "value": "1/1", "label": "1:1" },
        { "value": "9/16", "label": "9:16" },
        { "value": "adaptive", "label": "t:won.options.video_adaptive" }
      ],
      "default": "16/9"
    },
    {
      "type": "select", "id": "fit", "label": "t:won.settings.video_fit",
      "info": "t:won.info.video_fit",
      "visible_if": "{{ block.settings.video_type == 'hosted' }}",
      "options": [
        { "value": "cover", "label": "t:won.options.video_cover" },
        { "value": "contain", "label": "t:won.options.video_contain" }
      ],
      "default": "cover"
    }
  ],
  "presets": [{ "name": "t:won.names.video" }]
}
{% endschema %}
