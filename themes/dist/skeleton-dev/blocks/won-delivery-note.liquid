{% doc %}
won-delivery-note — a small trust/delivery line (icon + rich text) for PDP or any
section accepting theme blocks. Static and self-contained.
@example
{% content_for 'block', type: 'won-delivery-note', id: 'delivery' %}
{% enddoc %}

{%- assign s = block.settings -%}
<div class="won-delivery" {{ block.shopify_attributes }}>
  {%- if s.show_icon -%}
    {%- assign icon_name = s.icon | default: 'truck' -%}
    {% render 'won-icon', name: icon_name, class: 'won-delivery__icon' %}
  {%- endif -%}
  <div class="won-delivery__text rte">{{ s.note }}</div>
</div>

{% stylesheet %}
  .won-delivery { display: flex; align-items: center; gap: var(--won-space-2); padding: var(--won-space-3); border-radius: var(--won-radius-sm); background: var(--won-surface); }
  .won-delivery__icon { flex: 0 0 auto; inline-size: 22px; block-size: 22px; color: var(--won-accent); }
  .won-delivery__text { font-size: 0.92rem; }
  .won-delivery__text > :first-child { margin-block-start: 0; }
  .won-delivery__text > :last-child { margin-block-end: 0; }
{% endstylesheet %}

{% schema %}
{
  "name": "t:won.names.delivery_note",
  "settings": [
    { "type": "header", "content": "t:won.headers.content" },
    { "type": "richtext", "id": "note", "label": "t:won.settings.note", "default": "t:won.defaults.delivery_note" },
    { "type": "checkbox", "id": "show_icon", "label": "t:won.settings.show_icon", "default": true },
    {
      "type": "select", "id": "icon", "label": "t:won.settings.icon", "default": "truck", "visible_if": "{{ block.settings.show_icon }}",
      "options": [
        { "value": "check", "label": "t:won.options.icon_check" }, { "value": "star", "label": "t:won.options.icon_star" },
        { "value": "truck", "label": "t:won.options.icon_truck" }, { "value": "shield", "label": "t:won.options.icon_shield" },
        { "value": "clock", "label": "t:won.options.icon_clock" }, { "value": "leaf", "label": "t:won.options.icon_leaf" },
        { "value": "bolt", "label": "t:won.options.icon_bolt" }, { "value": "heart", "label": "t:won.options.icon_heart" },
        { "value": "droplet", "label": "t:won.options.icon_droplet" }, { "value": "box", "label": "t:won.options.icon_box" },
        { "value": "return", "label": "t:won.options.icon_return" }, { "value": "award", "label": "t:won.options.icon_award" }
      ]
    }
  ],
  "presets": [{ "name": "t:won.names.delivery_note" }]
}
{% endschema %}
