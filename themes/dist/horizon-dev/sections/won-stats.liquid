{%- liquid
  assign s = section.settings
  assign lines = s.stats | newline_to_br | split: '<br />'
  # Count-up: section duration of 0 means "inherit the theme-wide default"
  # (Won · Animace čísel global setting), otherwise the section value wins.
  assign countup_duration = s.animate_duration
  if countup_duration == 0
    assign countup_duration = settings.won_countup_default_duration | default: 1600
  endif
-%}
<section
  class="won-section color-{{ s.color_scheme }}"
  style="{% render 'won-style-vars', settings: s %}"
  data-testid="won-stats-section"
>
  {% render 'won-guard', settings: s %}
  <div class="won-container{% if s.section_width == 'full' %} won-container--full{% endif %} won-stats-wrap">
    {%- if s.heading != blank -%}
      <h2
        class="won-heading won-stats__heading"
        style="--won-h-size-m: {{ s.heading_size_mobile }}px; --won-h-size-d: {{ s.heading_size_desktop }}px; --won-h-mw-m: {{ s.heading_max_width_mobile }}%; --won-h-mw-d: {{ s.heading_max_width_desktop }}%; text-align: {{ s.content_align }};"
      >
        {{- s.heading | replace: '</p><p>', '<br>' | remove: '<p>' | remove: '</p>' | strip -}}
      </h2>
    {%- endif -%}
    <dl class="won-stats" style="--won-cols-lg: {{ s.columns_desktop }};">
      {%- for line in lines -%}
        {%- assign row = line | strip -%}
        {%- if row contains ':' -%}
          {%- assign value = row | split: ':' | first | strip -%}
          {%- assign label = row | split: ':' | last | strip -%}
          <div class="won-stat">
            <dt class="won-stat__value"{% if s.animate_values %} data-won-countup data-won-countup-duration="{{ countup_duration }}"{% endif %}>{{ value }}</dt>
            <dd class="won-stat__label">{{ label }}</dd>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </dl>
  </div>
</section>

{%- if s.animate_values -%}
  {{ 'won-count-up.js' | asset_url | script_tag }}
{%- endif -%}

{% stylesheet %}
  .won-stats-wrap { display: flex; flex-direction: column; gap: var(--won-space-5); }
  .won-stats__heading { font-size: var(--won-h-size-m, 1.8rem); max-width: var(--won-h-mw-m, 100%); }
  .won-stats { margin: 0; display: grid; gap: var(--won-space-5); grid-template-columns: repeat(2, minmax(0, 1fr)); text-align: center; }
  .won-stat { display: flex; flex-direction: column; gap: var(--won-space-1); }
  .won-stat__value { margin: 0; font-size: clamp(2rem, 5vw, 3.2rem); font-weight: 800; letter-spacing: -0.03em; color: var(--won-accent); line-height: 1; }
  .won-stat__label { margin: 0; opacity: 0.8; }
  @media (min-width: 750px) {
    .won-stats__heading { font-size: var(--won-h-size-d, 2.4rem); max-width: var(--won-h-mw-d, 100%); }
    .won-stats { grid-template-columns: repeat(var(--won-cols-lg, 4), minmax(0, 1fr)); }
  }
{% endstylesheet %}

