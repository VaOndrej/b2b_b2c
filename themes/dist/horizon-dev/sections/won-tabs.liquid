{%- assign s = section.settings -%}
<section
  class="won-section color-{{ s.color_scheme }}"
  style="{% render 'won-style-vars', settings: s %}"
  data-testid="won-tabs-section"
>
  {% render 'won-guard', settings: s %}
  <div class="won-container{% if s.section_width == 'full' %} won-container--full{% endif %} won-tabs-wrap">
    {%- if s.heading != blank -%}
      <h2
        class="won-heading won-tabs__heading"
        style="--won-h-size-m: {{ s.heading_size_mobile }}px; --won-h-size-d: {{ s.heading_size_desktop }}px; --won-h-mw-m: {{ s.heading_max_width_mobile }}%; --won-h-mw-d: {{ s.heading_max_width_desktop }}%;"
      >
        {{- s.heading | replace: '</p><p>', '<br>' | remove: '<p>' | remove: '</p>' | strip -}}
      </h2>
    {%- endif -%}

    {%- comment -%}
      The nav is built by the WonTabs element from each panel's data-title.
      Child theme-block settings (the tab titles) aren't readable from
      section.blocks when panels render via content_for, so titles live on the
      panels. Without JS, every panel shows stacked with its own heading.
    {%- endcomment -%}
    <won-tabs class="won-tabs">
      <div class="won-tabs__nav" role="tablist"></div>
      <div class="won-tabs__panels">
        {% content_for 'blocks' %}
      </div>
    </won-tabs>
  </div>
</section>

{% stylesheet %}
  .won-tabs-wrap { display: flex; flex-direction: column; gap: var(--won-space-4); }
  .won-tabs__heading { font-size: var(--won-h-size-m, 1.6rem); max-width: var(--won-h-mw-m, 100%); }
  .won-tabs__nav { display: flex; flex-wrap: wrap; gap: var(--won-space-2); border-block-end: 1px solid var(--won-border); }
  /* Empty nav (pre-JS or no-JS) collapses so it leaves no gap. */
  .won-tabs__nav:empty { display: none; border: 0; }
  .won-tabs__tab {
    padding: var(--won-space-3) var(--won-space-4); border: 0; background: transparent; color: var(--won-fg);
    font: inherit; font-weight: 600; cursor: pointer; border-block-end: 2px solid transparent; margin-block-end: -1px;
  }
  .won-tabs__tab[aria-selected="true"] { color: var(--won-accent); border-block-end-color: var(--won-accent); }
  .won-tabs__panels { padding-block-start: var(--won-space-4); }
  .won-tabs__panel[hidden] { display: none; }
  .won-tabs__panel + .won-tabs__panel { margin-block-start: var(--won-space-5); }
  .won-tabs__panel-title { margin: 0 0 var(--won-space-2); font-weight: 600; }
  /* Once enhanced, the nav supplies the labels, so the in-panel titles and the
     inter-panel spacing are redundant. */
  won-tabs[data-won-bound] .won-tabs__panel-title { display: none; }
  won-tabs[data-won-bound] .won-tabs__panel + .won-tabs__panel { margin-block-start: 0; }
  @media (min-width: 750px) {
    .won-tabs__heading { font-size: var(--won-h-size-d, 2rem); max-width: var(--won-h-mw-d, 100%); }
  }
{% endstylesheet %}

{% javascript %}
  class WonTabs extends HTMLElement {
    connectedCallback() {
      if (this.dataset.wonBound) return;
      this.panels = Array.from(this.querySelectorAll('.won-tabs__panel'));
      if (!this.panels.length) return;

      // Build the tab nav from each panel's title. Titles live on the panels
      // because a section can't read its content_for children's settings.
      const nav = this.querySelector('[role="tablist"]');
      if (!nav) return;
      this.tabs = this.panels.map((panel, i) => {
        const btnId = panel.id.replace('won-tabpanel-', 'won-tab-');
        const btn = document.createElement('button');
        btn.className = 'won-tabs__tab';
        btn.type = 'button';
        btn.setAttribute('role', 'tab');
        btn.id = btnId;
        btn.setAttribute('aria-controls', panel.id);
        btn.textContent = panel.dataset.title || '';
        panel.setAttribute('aria-labelledby', btnId);
        nav.appendChild(btn);
        btn.addEventListener('click', () => this.select(i));
        btn.addEventListener('keydown', (e) => {
          let next = null;
          if (e.key === 'ArrowRight') next = (i + 1) % this.tabs.length;
          else if (e.key === 'ArrowLeft') next = (i - 1 + this.tabs.length) % this.tabs.length;
          if (next !== null) { e.preventDefault(); this.select(next); this.tabs[next].focus(); }
        });
        return btn;
      });

      this.dataset.wonBound = '1';
      this.select(0);
    }
    select(index) {
      this.tabs.forEach((tab, i) => {
        const on = i === index;
        tab.setAttribute('aria-selected', on ? 'true' : 'false');
        tab.tabIndex = on ? 0 : -1;
        const panel = this.querySelector('#' + tab.getAttribute('aria-controls'));
        if (panel) panel.hidden = !on;
      });
    }
  }
  if (!customElements.get('won-tabs')) customElements.define('won-tabs', WonTabs);
{% endjavascript %}

{% schema %}
{
  "name": "t:won.names.tabs",
  "tag": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "max_blocks": 8,
  "blocks": [
    {
      "type": "won-tab"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "t:won.headers.visibility"
    },
    {
      "type": "checkbox",
      "id": "hide_mobile",
      "label": "t:won.settings.hide_mobile",
      "info": "t:won.info.hide_mobile",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_desktop",
      "label": "t:won.settings.hide_desktop",
      "info": "t:won.info.hide_desktop",
      "default": false
    },
    {
      "type": "header",
      "content": "t:won.headers.content"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "t:won.settings.heading"
    },
    {
      "type": "range",
      "id": "heading_size_desktop",
      "label": "t:won.settings.heading_size_desktop",
      "min": 20,
      "max": 72,
      "step": 2,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "heading_max_width_desktop",
      "label": "t:won.settings.heading_max_width_desktop",
      "min": 30,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "t:won.settings.heading_size_mobile",
      "min": 16,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 22
    },
    {
      "type": "range",
      "id": "heading_max_width_mobile",
      "label": "t:won.settings.heading_max_width_mobile",
      "min": 30,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "header",
      "content": "t:won.headers.appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:won.settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:won.settings.section_width",
      "options": [
        {
          "value": "page",
          "label": "t:won.options.width_page"
        },
        {
          "value": "full",
          "label": "t:won.options.width_full"
        }
      ],
      "default": "page"
    },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "t:won.settings.corner_radius",
      "info": "t:won.info.corner_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "t:won.settings.border_width",
      "info": "t:won.info.border_width",
      "min": 0,
      "max": 8,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "select",
      "id": "border_style",
      "label": "t:won.settings.border_style",
      "options": [
        {
          "value": "solid",
          "label": "t:won.options.solid"
        },
        {
          "value": "dashed",
          "label": "t:won.options.dashed"
        }
      ],
      "default": "solid",
      "visible_if": "{{ section.settings.border_width > 0 }}"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "t:won.settings.border_color",
      "info": "t:won.info.border_color",
      "visible_if": "{{ section.settings.border_width > 0 }}"
    },
    {
      "type": "select",
      "id": "shadow",
      "label": "t:won.settings.shadow",
      "info": "t:won.info.shadow",
      "options": [
        {
          "value": "none",
          "label": "t:won.options.none"
        },
        {
          "value": "sm",
          "label": "t:won.options.shadow_sm"
        },
        {
          "value": "md",
          "label": "t:won.options.shadow_md"
        },
        {
          "value": "lg",
          "label": "t:won.options.shadow_lg"
        }
      ],
      "default": "none"
    },
    {
      "type": "color",
      "id": "accent_override",
      "label": "t:won.settings.accent_color",
      "info": "t:won.info.accent_color"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "t:won.settings.bg_color",
      "info": "t:won.info.bg_color"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:won.settings.text_color",
      "info": "t:won.info.text_color"
    },
    {
      "type": "header",
      "content": "t:won.headers.spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:won.settings.padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:won.settings.padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "header",
      "content": "t:won.headers.type_motion"
    },
    {
      "type": "select",
      "id": "heading_weight",
      "label": "t:won.settings.heading_weight",
      "info": "t:won.info.heading_weight",
      "options": [
        {
          "value": "theme",
          "label": "t:won.options.weight_theme"
        },
        {
          "value": "400",
          "label": "t:won.options.weight_normal"
        },
        {
          "value": "500",
          "label": "t:won.options.weight_medium"
        },
        {
          "value": "600",
          "label": "t:won.options.weight_semibold"
        },
        {
          "value": "700",
          "label": "t:won.options.weight_bold"
        },
        {
          "value": "800",
          "label": "t:won.options.weight_extrabold"
        }
      ],
      "default": "theme"
    },
    {
      "type": "select",
      "id": "letter_spacing",
      "label": "t:won.settings.letter_spacing",
      "info": "t:won.info.letter_spacing",
      "options": [
        {
          "value": "theme",
          "label": "t:won.options.ls_theme"
        },
        {
          "value": "tight",
          "label": "t:won.options.ls_tight"
        },
        {
          "value": "normal",
          "label": "t:won.options.ls_normal"
        },
        {
          "value": "wide",
          "label": "t:won.options.ls_wide"
        },
        {
          "value": "wider",
          "label": "t:won.options.ls_wider"
        }
      ],
      "default": "theme"
    },
    {
      "type": "select",
      "id": "line_height",
      "label": "t:won.settings.line_height",
      "info": "t:won.info.line_height",
      "options": [
        {
          "value": "theme",
          "label": "t:won.options.lh_theme"
        },
        {
          "value": "tight",
          "label": "t:won.options.lh_tight"
        },
        {
          "value": "normal",
          "label": "t:won.options.lh_normal"
        },
        {
          "value": "relaxed",
          "label": "t:won.options.lh_relaxed"
        }
      ],
      "default": "theme"
    },
    {
      "type": "select",
      "id": "text_transform",
      "label": "t:won.settings.text_transform",
      "info": "t:won.info.text_transform",
      "options": [
        {
          "value": "none",
          "label": "t:won.options.tt_none"
        },
        {
          "value": "uppercase",
          "label": "t:won.options.tt_uppercase"
        },
        {
          "value": "capitalize",
          "label": "t:won.options.tt_capitalize"
        }
      ],
      "default": "none"
    },
    {
      "type": "select",
      "id": "animate_in",
      "label": "t:won.settings.animate_in",
      "info": "t:won.info.animate_in",
      "options": [
        {
          "value": "none",
          "label": "t:won.options.anim_none"
        },
        {
          "value": "fade",
          "label": "t:won.options.anim_fade"
        },
        {
          "value": "slide",
          "label": "t:won.options.anim_slide"
        },
        {
          "value": "scale",
          "label": "t:won.options.anim_scale"
        }
      ],
      "default": "none"
    },
    {
      "type": "header",
      "content": "t:won.headers.advanced"
    },
    {
      "type": "paragraph",
      "content": "t:won.info.advanced_about"
    },
    {
      "type": "checkbox",
      "id": "show_advanced",
      "label": "t:won.settings.show_advanced",
      "info": "t:won.info.show_advanced",
      "default": false
    },
    {
      "type": "range",
      "id": "pad_inline",
      "label": "t:won.settings.pad_inline",
      "info": "t:won.info.pad_inline",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.show_advanced }}"
    },
    {
      "type": "range",
      "id": "section_opacity",
      "label": "t:won.settings.section_opacity",
      "info": "t:won.info.section_opacity",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ section.settings.show_advanced }}"
    },
    {
      "type": "text",
      "id": "custom_shadow",
      "label": "t:won.settings.custom_shadow",
      "info": "t:won.info.custom_shadow",
      "visible_if": "{{ section.settings.show_advanced }}"
    }
  ]
}
{% endschema %}
