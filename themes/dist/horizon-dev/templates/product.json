    "usp": {
      "type": "won-grid",
      "blocks": {
        "u1": {
          "type": "won-feature",
          "settings": {
            "heading": "Rychlá vstřebatelnost",
            "text": "<p>Účinek už do 30 minut.</p>"
          }
        },
        "u2": {
          "type": "won-feature",
          "settings": {
            "heading": "Bez lepku a laktózy",
            "text": "<p>Vhodné i pro citlivé.</p>"
          }
        },
        "u3": {
          "type": "won-feature",
          "settings": {
            "heading": "Testováno laboratoří",
            "text": "<p>Nezávislý rozbor každé šarže.</p>"
          }
        },
        "u4": {
          "type": "won-feature",
          "settings": {
            "heading": "Doprava zdarma",
            "text": "<p>Nad 1 500 Kč.</p>"
          }
        }
      },
      "block_order": [
        "u1",
        "u2",
        "u3",
        "u4"
      ],
      "settings": {
        "columns_desktop": 4,
        "columns_tablet": 2,
        "columns_mobile": "2",
        "item_style": "plain",
        "content_align": "center",
        "color_scheme": "scheme-1",
        "padding_top": 40,
        "padding_bottom": 24,
        "source": "blocks"
      }
    },
    "detail": {
      "type": "won-band",
      "blocks": {
        "d_stock": {
          "type": "won-stock-signal",
          "settings": {
            "low_threshold": 10,
            "delivery_fallback": "Doručení do 2 dnů"
          }
        },
        "d_ppu100": {
          "type": "won-price-per-unit",
          "settings": {
            "base": "per_100g",
            "amount_metafield": "won.net_weight_g",
            "amount": 1000,
            "prefix": "Cena za 100 g:"
          }
        },
        "d_ppuserv": {
          "type": "won-price-per-unit",
          "settings": {
            "base": "per_serving",
            "amount_metafield": "won.servings",
            "amount": 33,
            "prefix": "Cena za porci:"
          }
        },
        "d_high": {
          "type": "won-highlights",
          "settings": {
            "heading": "Klíčové přednosti",
            "items": "Doprava zdarma nad 1 500 Kč\nVyrobeno v EU\nTestováno nezávislou laboratoří",
            "show_icon": true
          }
        },
        "d_param": {
          "type": "won-param-table",
          "settings": {
            "heading": "Parametry",
            "rows": "Hmotnost : 1 000 g\nPorce : 33\nPříchuť : Čokoláda\nForma : Prášek"
          }
        },
        "d_nutri": {
          "type": "won-nutrition-table",
          "settings": {
            "heading": "Nutriční hodnoty",
            "source": "metafield",
            "metafield_key": "custom.nutrition",
            "label_nutrient": "Živina",
            "label_col1": "Na 100 g",
            "label_col2": "Na porci (10 g)",
            "rows": "Energie | 380 kcal | 76 kcal\nBílkoviny | 24 g | 4,8 g\nSacharidy | 60 g | 12 g\nTuky | 6 g | 1,2 g"
          }
        },
        "d_dose": {
          "type": "won-dosage",
          "settings": {
            "heading": "Kdy užívat",
            "steps": "Ráno : 1 odměrka do snídaně\nPo tréninku : 1 odměrka do 30 minut\nVečer : dle potřeby"
          }
        }
      },
      "block_order": [
        "d_stock",
        "d_ppu100",
        "d_ppuserv",
        "d_high",
        "d_param",
        "d_nutri",
        "d_dose"
      ],
      "settings": {
        "media_type": "none",
        "section_width": "page",
        "content_align": "left",
        "color_scheme": "scheme-1",
        "padding_top": 48,
        "padding_bottom": 48
