        },
        "t2": {
          "type": "won-panel",
          "settings": {
            "title": "Použití",
            "content": "<p>Rozmíchej 1 odměrku (30 g) ve 250 ml vody nebo mléka.</p>"
          }
        },
        "t3": {
          "type": "won-panel",
          "settings": {
            "title": "Skladování",
            "content": "<p>Skladuj v suchu do 25 °C, mimo dosah dětí.</p>"
