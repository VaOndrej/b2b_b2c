{% doc %}
won-tile — a single image tile linking to a collection or page, used inside
won-collection-tiles. Size axis lets one tile go large for a mosaic layout.
@example
{% content_for 'block', type: 'won-tile', id: 'tile-1' %}
{% enddoc %}

{%- liquid
  assign s = block.settings
  assign col = s.collection
  assign col_by_handle = collections[s.collection]
  if col_by_handle != blank
    assign col = col_by_handle
  endif
  assign tile_image = s.image
  if tile_image == blank and col != blank
    assign tile_image = col.image
  endif
  assign tile_url = s.link_url
  if tile_url == blank and col != blank
    assign tile_url = col.url
  endif
  assign tile_heading = s.heading
  if tile_heading == blank and col != blank
    assign tile_heading = col.title
  endif
-%}
<a
  class="won-tile won-tile--{{ s.tile_size }}"
  style="--won-radius-md: {{ s.corner_radius }}px;"
  {% if tile_url != blank %}href="{{ tile_url }}"{% endif %}
  {{ block.shopify_attributes }}
>
  {%- comment -%} `has_media` covers BOTH sources, or the placeholder class fights
     the packaged image: an image_asset tile would render its art on top of the
     empty-state gradient. {%- endcomment -%}
  {%- assign has_media = false -%}
  {%- if tile_image != blank or s.image_asset != blank -%}{%- assign has_media = true -%}{%- endif -%}
  <div class="won-tile__media{% unless has_media %} won-tile__media--placeholder{% endunless %}">
    {%- if s.toggle_overlay and has_media -%}<span class="won-tile__overlay" style="background: {{ s.overlay_color }};"></span>{%- endif -%}
    {%- if tile_image != blank -%}
      {{ tile_image | image_url: width: 1200 | image_tag: widths: '300, 500, 800, 1200', sizes: '(min-width: 750px) 33vw, 100vw', class: 'won-tile__img', loading: 'lazy', alt: tile_image.alt | default: tile_heading }}
    {%- elsif s.image_asset != blank -%}
      {%- comment -%} Packaged fallback, matching won-slide / won-band /
         won-shoppable-image. Without it a category tile has no art until someone
         uploads a collection image in the admin — which is why the demo's
         category row was four blank gradients. {%- endcomment -%}
      <img class="won-tile__img" src="{{ s.image_asset | asset_url }}" alt="{{ tile_heading | escape }}" width="1200" height="1500" loading="lazy">
    {%- endif -%}
    {%- if s.badge_text != blank -%}
      <span class="won-tile__badge won-tile__badge--{{ s.badge_position }} won-tile__badge--{{ s.badge_style }}">{{ s.badge_text }}</span>
    {%- endif -%}
  </div>
  {%- if tile_heading != blank or s.icon != blank -%}
    <span class="won-tile__label">
      {%- if s.icon != blank -%}<span class="won-tile__icon" aria-hidden="true">{{ s.icon }}</span>{%- endif -%}
      {{- tile_heading -}}
    </span>
  {%- endif -%}
</a>

{% stylesheet %}
  .won-tile { position: relative; display: block; border-radius: var(--won-radius-md); overflow: hidden; text-decoration: none; color: #fff; }
  .won-tile__media { position: relative; aspect-ratio: 3 / 4; }
  /* No image → clean branded gradient card (no vendor silhouette), so category
     tiles look intentional before the merchant uploads artwork. */
  .won-tile__media--placeholder {
    background:
      radial-gradient(120% 80% at 50% 0%, color-mix(in oklab, var(--won-accent) 22%, var(--won-surface)), var(--won-surface));
  }
  .won-tile--large { grid-column: span 2; grid-row: span 2; }
  .won-tile__img { position: absolute; inset: 0; inline-size: 100%; block-size: 100%; object-fit: cover; }
  .won-tile__overlay { position: absolute; inset: 0; z-index: 1; }
  .won-tile__badge {
    position: absolute; z-index: 3; margin: var(--won-space-3);
    padding: 0.3em 0.7em; border-radius: var(--won-radius-pill);
    font-size: 0.78rem; font-weight: 700; letter-spacing: 0.02em; line-height: 1.2;
    background: var(--won-accent); color: #fff;
  }
  .won-tile__badge--top_left { inset-block-start: 0; inset-inline-start: 0; }
  .won-tile__badge--top_right { inset-block-start: 0; inset-inline-end: 0; }
  .won-tile__badge--bottom_left { inset-block-end: 0; inset-inline-start: 0; }
  .won-tile__badge--bottom_right { inset-block-end: 0; inset-inline-end: 0; }
  .won-tile__badge--dark { background: color-mix(in oklab, #000 78%, transparent); color: #fff; }
  .won-tile__badge--light { background: var(--won-bg); color: var(--won-fg); box-shadow: 0 1px 4px rgba(0,0,0,0.12); }
  .won-tile__label {
    position: absolute; inset-block-end: 0; inset-inline: 0; z-index: 2;
    padding: var(--won-space-4);
    font-size: 1.2rem; font-weight: 700;
    background: linear-gradient(to top, color-mix(in oklab, #000 55%, transparent), transparent);
  }
  .won-tile__icon { margin-inline-end: 0.4em; }
  /* On the imageless gradient the label sits on a light surface — use dark ink
     and no scrim so it stays legible. */
  .won-tile__media--placeholder .won-tile__label {
    color: var(--won-fg);
    background: none;
  }
  @media (min-width: 750px) {
    .won-tile--large .won-tile__media { aspect-ratio: auto; block-size: 100%; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:won.names.tile",
  "settings": [
    { "type": "header", "content": "t:won.headers.content" },
    { "type": "collection", "id": "collection", "label": "t:won.settings.collection", "info": "t:won.info.tile_collection" },
    { "type": "image_picker", "id": "image", "label": "t:won.settings.image" },
    { "type": "text", "id": "image_asset", "label": "t:won.settings.image_asset", "info": "t:won.info.image_asset" },
    { "type": "inline_richtext", "id": "heading", "label": "t:won.settings.heading", "default": "t:won.defaults.tile_heading" },
    { "type": "text", "id": "icon", "label": "t:won.settings.icon", "info": "t:won.info.tile_icon" },
    { "type": "url", "id": "link_url", "label": "t:won.settings.link_url" },
    { "type": "text", "id": "badge_text", "label": "t:won.settings.badge_text", "info": "t:won.info.badge_text" },
    { "type": "header", "content": "t:won.headers.layout" },
    {
      "type": "select", "id": "tile_size", "label": "t:won.settings.tile_size",
      "options": [
        { "value": "small", "label": "t:won.options.tile_small" },
        { "value": "large", "label": "t:won.options.tile_large" }
      ],
      "default": "small"
    },
    { "type": "header", "content": "t:won.headers.appearance" },
    {
      "type": "select", "id": "badge_position", "label": "t:won.settings.badge_position", "visible_if": "{{ block.settings.badge_text != blank }}",
      "options": [
        { "value": "top_left", "label": "t:won.options.pos_top_left" },
        { "value": "top_right", "label": "t:won.options.pos_top_right" },
        { "value": "bottom_left", "label": "t:won.options.pos_bottom_left" },
        { "value": "bottom_right", "label": "t:won.options.pos_bottom_right" }
      ],
      "default": "top_right"
    },
    {
      "type": "select", "id": "badge_style", "label": "t:won.settings.badge_style", "visible_if": "{{ block.settings.badge_text != blank }}",
      "options": [
        { "value": "accent", "label": "t:won.options.badge_accent" },
        { "value": "dark", "label": "t:won.options.badge_dark" },
        { "value": "light", "label": "t:won.options.badge_light" }
      ],
      "default": "accent"
    },
    { "type": "range", "id": "corner_radius", "label": "t:won.settings.corner_radius", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 14, "info": "t:won.info.corner_radius" },
    { "type": "checkbox", "id": "toggle_overlay", "label": "t:won.settings.overlay", "info": "t:won.info.overlay", "default": true },
    { "type": "color", "id": "overlay_color", "label": "t:won.settings.overlay_color", "info": "t:won.info.overlay_color", "alpha": true, "default": "#0000001a", "visible_if": "{{ block.settings.toggle_overlay }}" }
  ],
  "presets": [{ "name": "t:won.names.tile" }]
}
{% endschema %}
