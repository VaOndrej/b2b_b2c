{%- liquid
  assign s = section.settings
  assign has_media = false
  if s.media_type == 'image' and s.image != blank
    assign has_media = true
  elsif s.media_type == 'image' and s.image_asset != blank
    assign has_media = true
  elsif s.media_type == 'video' and s.video != blank
    assign has_media = true
  endif
  assign is_bg = false
  if s.media_position == 'background' and has_media
    assign is_bg = true
  endif
  assign is_gutter = false
  if s.media_position == 'center_gutter'
    assign is_gutter = true
  endif
  assign has_media2 = false
  if s.image_2 != blank or s.image_asset_2 != blank
    assign has_media2 = true
  endif
  assign layout = 'stacked'
  if is_bg
    assign layout = 'overlay'
  elsif is_gutter
    assign layout = 'gutter'
  elsif has_media
    assign layout = 'split'
  endif
  # content_align is a text_alignment control (left|center|right) — valid for
  # text-align, but align-items needs a flex keyword, so map it separately.
  assign flex_align = 'flex-start'
  assign mi_s = '0'
  assign mi_e = 'auto'
  if s.content_align == 'center'
    assign flex_align = 'center'
    assign mi_s = 'auto'
    assign mi_e = 'auto'
  elsif s.content_align == 'right'
    assign flex_align = 'flex-end'
    assign mi_s = 'auto'
    assign mi_e = '0'
  endif
  # Blocks flow into columns on desktop only; a data stack is never multi-column
  # on mobile. Missing/0 keeps the historical single column.
  assign cols_d = s.content_columns | default: 1
  if cols_d < 1
    assign cols_d = 1
  endif
-%}

<section
  class="won-section color-{{ s.color_scheme }}"
  style="{% render 'won-spacing', settings: s %}"
  data-testid="won-band-section"
>
  <div class="won-container{% if s.section_width == 'full' %} won-container--full{% endif %}">
    <div
      class="won-band won-band--{{ layout }} won-band--media-{{ s.media_position }}"
      style="--won-band-align: {{ s.content_align }};--won-band-flex: {{ flex_align }};--won-band-mi-s: {{ mi_s }};--won-band-mi-e: {{ mi_e }};--won-band-cols-d: {{ cols_d }};{% if s.min_height > 0 %}--won-band-min: {{ s.min_height }}px;{% endif %}"
    >
      {%- if has_media -%}
        <div class="won-band__media">
          {%- if is_bg and s.toggle_overlay -%}
            <span class="won-band__overlay" style="background: {{ s.overlay_color }};"></span>
          {%- endif -%}
          {%- if s.media_type == 'image' -%}
            {%- if s.image != blank -%}
              {{ s.image | image_url: width: 2400 | image_tag: widths: '600, 900, 1200, 1800, 2400', sizes: '(min-width: 750px) 50vw, 100vw', class: 'won-band__img', loading: 'lazy', alt: s.image.alt | default: '' }}
            {%- else -%}
              <img class="won-band__img" src="{{ s.image_asset | asset_url }}" alt="" width="2400" height="1200" loading="lazy">
            {%- endif -%}
          {%- else -%}
            {{ s.video | video_tag: autoplay: s.video_autoplay, loop: s.video_loop, muted: s.video_autoplay, controls: s.video_controls, class: 'won-band__video' }}
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="won-band__content">
        {%- if s.eyebrow != blank -%}
          <p class="won-band__eyebrow">{{ s.eyebrow }}</p>
        {%- endif -%}
        {%- if s.heading != blank -%}
          <h2
            class="won-heading won-band__heading"
            style="--won-h-size-m: {{ s.heading_size_mobile }}px; --won-h-size-d: {{ s.heading_size_desktop }}px; --won-h-mw-m: {{ s.heading_max_width_mobile }}%; --won-h-mw-d: {{ s.heading_max_width_desktop }}%;"
          >
            {{- s.heading | replace: '</p><p>', '<br>' | remove: '<p>' | remove: '</p>' | strip -}}
          </h2>
        {%- endif -%}
        {%- if s.body != blank -%}
          <div class="won-band__body rte">{{ s.body }}</div>
        {%- endif -%}
        {%- if s.button_label != blank or s.button2_label != blank -%}
          <div class="won-band__actions">
            {% render 'won-button', label: s.button_label, link: s.button_link, style: s.button_style, new_tab: s.buttons_new_tab %}
            {% render 'won-button', label: s.button2_label, link: s.button2_link, style: s.button2_style, new_tab: s.buttons_new_tab %}
          </div>
        {%- endif -%}
        <div class="won-band__blocks">{% content_for 'blocks' %}</div>
      </div>

      {%- if is_gutter and has_media2 -%}
        <div class="won-band__media won-band__media--2">
          {%- if s.image_2 != blank -%}
            {{ s.image_2 | image_url: width: 1400 | image_tag: widths: '400, 700, 1000, 1400', sizes: '(min-width: 750px) 28vw, 100vw', class: 'won-band__img', loading: 'lazy', alt: s.image_2.alt | default: '' }}
          {%- else -%}
            <img class="won-band__img" src="{{ s.image_asset_2 | asset_url }}" alt="" width="1400" height="1400" loading="lazy">
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .won-band { display: flex; flex-direction: column; gap: var(--won-space-5); }
  /* Blocks STRETCH, they never shrink to their content.
     Why: with `align-items: flex-start` every theme block was a shrink-to-fit flex
     item, so a params/nutrition table inside a 1320px band collapsed to ~138px and
     read as a broken fragment. Alignment of the section's own copy is carried by
     text-align + the margin-inline pair below, never by shrinking boxes. */
  .won-band__content {
    display: flex;
    flex-direction: column;
    gap: var(--won-space-4);
    align-items: stretch;
    text-align: var(--won-band-align, left);
  }
  /* Capped-measure elements follow content_align without shrinking their neighbours. */
  .won-band__heading,
  .won-band__body { margin-inline: var(--won-band-mi-s, 0) var(--won-band-mi-e, auto); }

  /* Block flow. `content_columns` uses CSS multi-column, NOT grid: a grid row is as
     tall as its tallest cell, so a stack of uneven data groups (2-line stock signal
     next to a 6-row params table) leaves big holes. Column flow fills column 1 top to
     bottom and wraps — no holes, and reading order stays column-major, which is what
     a fact list wants. Always a single stack under 750px. */
  .won-band__blocks { display: flex; flex-direction: column; gap: var(--won-space-4); }
  .won-band__eyebrow {
    margin: 0;
    font-family: var(--font-body--family, inherit);
    font-size: 0.85rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--won-accent);
  }
  .won-band__heading {
    font-size: var(--won-h-size-m, 2rem);
    max-width: var(--won-h-mw-m, 100%);
  }
  .won-band__body { margin: 0; opacity: 0.92; max-width: 60ch; }
  .won-band__actions { display: flex; flex-wrap: wrap; gap: var(--won-space-3); justify-content: var(--won-band-flex, flex-start); }

  .won-band__media { position: relative; overflow: hidden; border-radius: var(--won-radius-md); }
  .won-band__img,
  .won-band__video { display: block; width: 100%; height: 100%; object-fit: cover; }
  .won-band__overlay { position: absolute; inset: 0; z-index: 1; }

  .won-band--overlay { position: relative; justify-content: center; align-items: var(--won-band-flex, flex-start); min-height: var(--won-band-min, 480px); border-radius: var(--won-radius-lg); overflow: hidden; padding: var(--won-space-7) var(--won-space-6); }
  .won-band--overlay .won-band__media { position: absolute; inset: 0; border-radius: 0; }
  /* Depth + header separation scrim: darken top (behind a transparent header) and
     bottom, keep the middle clear for content. */
  .won-band--overlay .won-band__media::after {
    content: ''; position: absolute; inset: 0; z-index: 1; pointer-events: none;
    background: linear-gradient(180deg, rgba(0,0,0,0.32) 0%, rgba(0,0,0,0) 26%, rgba(0,0,0,0) 62%, rgba(0,0,0,0.28) 100%);
  }
  .won-band--overlay .won-band__content { position: relative; z-index: 2; color: #fff; text-shadow: 0 1px 24px rgba(0, 0, 0, 0.28); max-inline-size: 760px; }
  .won-band--overlay .won-band__eyebrow { color: rgba(255, 255, 255, 0.92); }
  .won-band--overlay .won-band__heading,
  .won-band--overlay .won-band__body { color: #fff; }
  .won-band--overlay .won-btn--secondary { color: #fff; border-color: rgba(255, 255, 255, 0.55); background: rgba(255, 255, 255, 0.08); text-shadow: none; }
  /* Full-bleed background hero: no rounded corners. */
  .won-container--full > .won-band--overlay { border-radius: 0; }
  /* Mobile hard-rule: background heroes read centered on small screens even when
     the desktop layout is left-aligned (the side product art crops off anyway). */
  @media (max-width: 749px) {
    .won-band--overlay { align-items: center; }
    .won-band--overlay .won-band__content { align-items: center; text-align: center; }
  }

  @media (min-width: 750px) {
    .won-band__blocks {
      display: block;
      columns: var(--won-band-cols-d, 1);
      column-gap: var(--won-space-6);
    }
    .won-band__blocks > * { break-inside: avoid; margin-block-end: var(--won-space-5); }
    .won-band__blocks > :last-child { margin-block-end: 0; }
    .won-band__heading { font-size: var(--won-h-size-d, 3rem); max-width: var(--won-h-mw-d, 60%); }
    .won-band--split { flex-direction: row; align-items: center; }
    .won-band--split.won-band--media-right { flex-direction: row-reverse; }
    .won-band--split .won-band__media,
    .won-band--split .won-band__content { flex: 1 1 50%; }
    .won-band--split .won-band__media { align-self: stretch; min-height: var(--won-band-min, 360px); }
    /* center-gutter: media | centred copy island | media (flawless-style). */
    .won-band--gutter { flex-direction: row; align-items: center; gap: var(--won-space-6); }
    .won-band--gutter .won-band__media { flex: 1 1 28%; align-self: stretch; min-height: var(--won-band-min, 360px); }
    .won-band--gutter .won-band__content { flex: 1 1 44%; text-align: center; align-items: center; }
    .won-band--gutter .won-band__body { margin-inline: auto; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:won.names.band",
  "tag": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "blocks": [{ "type": "@theme" }, { "type": "@app" }],
  "settings": [
    { "type": "paragraph", "content": "t:won.info.band_about" },
    { "type": "header", "content": "t:won.headers.content" },
    { "type": "inline_richtext", "id": "eyebrow", "label": "t:won.settings.eyebrow" },
    { "type": "richtext", "id": "heading", "label": "t:won.settings.heading", "default": "t:won.defaults.band_heading" },
    { "type": "range", "id": "heading_size_desktop", "label": "t:won.settings.heading_size_desktop", "min": 24, "max": 96, "step": 2, "unit": "px", "default": 56 },
    { "type": "range", "id": "heading_max_width_desktop", "label": "t:won.settings.heading_max_width_desktop", "min": 30, "max": 100, "step": 5, "unit": "%", "default": 60 },
    { "type": "range", "id": "heading_size_mobile", "label": "t:won.settings.heading_size_mobile", "min": 16, "max": 64, "step": 2, "unit": "px", "default": 32 },
    { "type": "range", "id": "heading_max_width_mobile", "label": "t:won.settings.heading_max_width_mobile", "min": 30, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "richtext", "id": "body", "label": "t:won.settings.body" },
    { "type": "text", "id": "button_label", "label": "t:won.settings.button_label" },
    { "type": "url", "id": "button_link", "label": "t:won.settings.button_link" },
    {
      "type": "select", "id": "button_style", "label": "t:won.settings.button_style",
      "options": [
        { "value": "primary", "label": "t:won.options.primary" },
        { "value": "secondary", "label": "t:won.options.secondary" }
      ],
      "default": "primary"
    },
    { "type": "text", "id": "button2_label", "label": "t:won.settings.button2_label" },
    { "type": "url", "id": "button2_link", "label": "t:won.settings.button2_link" },
    {
      "type": "select", "id": "button2_style", "label": "t:won.settings.button2_style",
      "options": [
        { "value": "primary", "label": "t:won.options.primary" },
        { "value": "secondary", "label": "t:won.options.secondary" }
      ],
      "default": "secondary"
    },
    { "type": "checkbox", "id": "buttons_new_tab", "label": "t:won.settings.button_new_tab", "info": "t:won.info.button_new_tab", "default": false },
    { "type": "header", "content": "t:won.headers.media" },
    {
      "type": "select", "id": "media_type", "label": "t:won.settings.media_type",
      "options": [
        { "value": "none", "label": "t:won.options.none" },
        { "value": "image", "label": "t:won.options.image" },
        { "value": "video", "label": "t:won.options.video" }
      ],
      "default": "none"
    },
    {
      "type": "select", "id": "media_position", "label": "t:won.settings.media_position", "visible_if": "{{ section.settings.media_type != 'none' }}",
      "options": [
        { "value": "left", "label": "t:won.options.left" },
        { "value": "right", "label": "t:won.options.right" },
        { "value": "center_gutter", "label": "t:won.options.center_gutter" },
        { "value": "background", "label": "t:won.options.background" }
      ],
      "default": "right"
    },
    { "type": "image_picker", "id": "image", "label": "t:won.settings.image", "visible_if": "{{ section.settings.media_type == 'image' }}" },
    { "type": "text", "id": "image_asset", "label": "t:won.settings.image_asset", "info": "t:won.info.image_asset", "visible_if": "{{ section.settings.media_type == 'image' }}" },
    { "type": "video", "id": "video", "label": "t:won.settings.video", "visible_if": "{{ section.settings.media_type == 'video' }}" },
    { "type": "checkbox", "id": "video_autoplay", "label": "t:won.settings.video_autoplay", "info": "t:won.info.video_autoplay", "default": true, "visible_if": "{{ section.settings.media_type == 'video' }}" },
    { "type": "checkbox", "id": "video_loop", "label": "t:won.settings.video_loop", "default": true, "visible_if": "{{ section.settings.media_type == 'video' }}" },
    { "type": "checkbox", "id": "video_controls", "label": "t:won.settings.video_controls", "default": false, "visible_if": "{{ section.settings.media_type == 'video' }}" },
    { "type": "image_picker", "id": "image_2", "label": "t:won.settings.image_2", "info": "t:won.info.image_2", "visible_if": "{{ section.settings.media_type == 'image' and section.settings.media_position == 'center_gutter' }}" },
    { "type": "text", "id": "image_asset_2", "label": "t:won.settings.image_asset_2", "info": "t:won.info.image_asset", "visible_if": "{{ section.settings.media_type == 'image' and section.settings.media_position == 'center_gutter' }}" },
    { "type": "checkbox", "id": "toggle_overlay", "label": "t:won.settings.overlay", "default": true, "visible_if": "{{ section.settings.media_position == 'background' }}" },
    { "type": "color", "id": "overlay_color", "label": "t:won.settings.overlay_color", "alpha": true, "default": "#00000059", "visible_if": "{{ section.settings.media_position == 'background' }}" },
    { "type": "header", "content": "t:won.headers.layout" },
    { "type": "text_alignment", "id": "content_align", "label": "t:won.settings.content_align", "default": "left" },
    { "type": "range", "id": "min_height", "label": "t:won.settings.min_height", "min": 0, "max": 800, "step": 20, "unit": "px", "default": 0 },
    { "type": "range", "id": "content_columns", "label": "t:won.settings.content_columns", "info": "t:won.info.content_columns", "min": 1, "max": 3, "step": 1, "default": 1 },
    { "type": "header", "content": "t:won.headers.appearance" },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:won.settings.color_scheme", "default": "scheme-1" },
    {
      "type": "select", "id": "section_width", "label": "t:won.settings.section_width",
      "options": [
        { "value": "page", "label": "t:won.options.width_page" },
        { "value": "full", "label": "t:won.options.width_full" }
      ],
      "default": "page"
    },
    { "type": "color", "id": "accent_override", "label": "t:won.settings.accent_override" },
    { "type": "header", "content": "t:won.headers.spacing" },
    { "type": "range", "id": "padding_top", "label": "t:won.settings.padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding_bottom", "label": "t:won.settings.padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 56 }
  ],
  "presets": [
    {
      "name": "t:won.presets.media_text", "category": "t:won.categories.content",
      "settings": {
        "eyebrow": "Why Won", "heading": "<p>Made with clean ingredients</p>", "heading_size_desktop": 44,
        "body": "<p>Every batch is tested by an independent lab. No fillers, no compromises.</p>",
        "button_label": "Learn more", "button_style": "secondary",
        "media_type": "image", "image_asset": "won-hero-product.svg", "media_position": "left",
        "content_align": "left", "min_height": 420, "color_scheme": "scheme-1"
      }
    },
    {
      "name": "t:won.presets.center_gutter", "category": "t:won.categories.content",
      "settings": {
        "eyebrow": "This one just works", "heading": "<p>Fuel your best</p>", "heading_size_desktop": 48,
        "body": "<p>Clean, tested, and made to perform.</p>",
        "button_label": "Shop now", "button_style": "primary",
        "media_type": "image", "image_asset": "won-promo-1.svg", "image_asset_2": "won-promo-3.svg",
        "media_position": "center_gutter", "content_align": "center", "min_height": 380, "color_scheme": "scheme-1"
      }
    }
  ]
}
{% endschema %}
