        { "type": "won-slide", "settings": { "eyebrow": "New", "heading": "<p>New: BCAA</p>", "heading_size_desktop": 44, "text": "<p>Recovery after every workout.</p>", "button_label": "Shop now", "button_link": "shopify://collections/all", "button_style": "primary", "media_type": "image", "image_asset": "won-promo-4.png", "media_position": "background", "alignment": "left", "min_height": 460, "corner_radius": 20 } }
