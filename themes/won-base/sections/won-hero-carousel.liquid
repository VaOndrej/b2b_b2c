{%- comment -%}
  won-hero-carousel — hero as a full-bleed slider (one slide per view). Renders
  won-slide blocks in a swipeable track driven by the shared won-carousel.js
  (<won-carousel> element via data-won-* hooks). Shares .won-hero styling with
  won-hero / won-hero-grid (won-tokens.css). content_for appears exactly once.
{%- endcomment -%}

{%- assign s = section.settings -%}
<section
  class="won-section color-{{ s.color_scheme }}"
  style="{% render 'won-spacing', settings: s %}"
  data-testid="won-hero-carousel-section"
>
  <div
    class="won-container{% if s.section_width == 'full' %} won-container--full{% endif %} won-hero won-hero--slider{% if s.layout == 'peek' %} won-hero--peek{% endif %}"
    style="--won-hero-min: {{ s.min_height }}px; --won-hero-gap: {{ s.gap }}px; --won-hero-peek: {{ s.columns_mobile }}; --won-hero-slide: {{ s.slide_width }}%;"
  >
    <won-carousel class="won-hero__carousel"{% if s.autoplay %} data-autoplay="{{ s.autoplay_interval }}"{% endif %}><div class="won-hero__track" data-won-track>
        {% content_for 'blocks' %}
      </div>
      {%- if s.show_arrows -%}
        <div class="won-hero__arrows">
          <button type="button" class="won-hero__arrow" data-won-prev aria-label="{{ 'won.a11y.previous' | t }}"><span aria-hidden="true">‹</span></button>
          <button type="button" class="won-hero__arrow" data-won-next aria-label="{{ 'won.a11y.next' | t }}"><span aria-hidden="true">›</span></button>
        </div>
      {%- endif -%}
      {%- if s.show_progress -%}
        <div class="won-hero__progress" data-won-progress><span class="won-hero__progress-bar" data-won-progress-bar></span></div>
      {%- endif -%}
    </won-carousel>
  </div>
</section>

<script src="{{ 'won-carousel.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "t:won.names.hero_carousel",
  "tag": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "max_blocks": 8,
  "blocks": [{ "type": "won-slide" }, { "type": "@theme" }, { "type": "@app" }],
  "settings": [
    { "type": "range", "id": "min_height", "label": "t:won.settings.min_height", "min": 200, "max": 800, "step": 20, "unit": "px", "default": 520 },
    {
      "type": "select", "id": "layout", "label": "t:won.settings.hero_slider_layout", "info": "t:won.info.hero_slider_layout",
      "options": [
        { "value": "fill", "label": "t:won.options.hero_fill" },
        { "value": "peek", "label": "t:won.options.hero_peek" }
      ],
      "default": "fill"
    },
    { "type": "range", "id": "slide_width", "label": "t:won.settings.slide_width", "info": "t:won.info.slide_width", "min": 50, "max": 85, "step": 1, "unit": "%", "default": 64, "visible_if": "{{ section.settings.layout == 'peek' }}" },
    { "type": "header", "content": "t:won.headers.controls" },
    { "type": "checkbox", "id": "show_arrows", "label": "t:won.settings.show_arrows", "default": true },
    { "type": "checkbox", "id": "show_progress", "label": "t:won.settings.show_progress", "default": true },
    { "type": "checkbox", "id": "autoplay", "label": "t:won.settings.autoplay", "default": true },
    { "type": "range", "id": "autoplay_interval", "label": "t:won.settings.autoplay_interval", "min": 2, "max": 10, "step": 1, "unit": "s", "default": 6, "visible_if": "{{ section.settings.autoplay }}" },
    {
      "type": "select", "id": "columns_mobile", "label": "t:won.settings.columns_mobile",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "1.15", "label": "t:won.options.one_peek" }
      ],
      "default": "1"
    },
    { "type": "range", "id": "gap", "label": "t:won.settings.gap", "min": 0, "max": 32, "step": 2, "unit": "px", "default": 0 },
    { "type": "header", "content": "t:won.headers.appearance" },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:won.settings.color_scheme", "default": "scheme-1" },
    {
      "type": "select", "id": "section_width", "label": "t:won.settings.section_width",
      "options": [
        { "value": "page", "label": "t:won.options.width_page" },
        { "value": "full", "label": "t:won.options.width_full" }
      ],
      "default": "full"
    },
    { "type": "color", "id": "accent_override", "label": "t:won.settings.accent_override" },
    { "type": "header", "content": "t:won.headers.padding" },
    { "type": "range", "id": "padding_top", "label": "t:won.settings.padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_bottom", "label": "t:won.settings.padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 0 }
  ],
  "presets": [
    {
      "name": "t:won.presets.hero_carousel", "category": "t:won.categories.hero",
      "settings": { "min_height": 520, "section_width": "full", "show_arrows": true, "show_progress": true, "autoplay": true, "autoplay_interval": 6 },
      "blocks": [
        { "type": "won-slide", "settings": { "eyebrow": "Hydration", "heading": "<p>When water isn't enough</p>", "heading_size_desktop": 52, "text": "<p>Replace key minerals lost in the heat.</p>", "button_label": "Shop now", "button_link": "shopify://collections/all", "button_style": "primary", "media_type": "image", "image_asset": "won-promo-1.png", "media_position": "background", "alignment": "left", "min_height": 520 } },
        { "type": "won-slide", "settings": { "eyebrow": "Deal", "heading": "<p>Creatine −20%</p>", "heading_size_desktop": 52, "text": "<p>Strength and performance, every day.</p>", "button_label": "Shop now", "button_link": "shopify://collections/all", "button_style": "primary", "media_type": "image", "image_asset": "won-promo-2.png", "media_position": "background", "alignment": "left", "min_height": 520 } },
        { "type": "won-slide", "settings": { "eyebrow": "Bestseller", "heading": "<p>Whey with 21g protein</p>", "heading_size_desktop": 52, "text": "<p>Selected flavours at a great price.</p>", "button_label": "Shop now", "button_link": "shopify://collections/all", "button_style": "primary", "media_type": "image", "image_asset": "won-promo-3.png", "media_position": "background", "alignment": "left", "min_height": 520 } },
        { "type": "won-slide", "settings": { "eyebrow": "New", "heading": "<p>New: BCAA</p>", "heading_size_desktop": 52, "text": "<p>Recovery after every workout.</p>", "button_label": "Shop now", "button_link": "shopify://collections/all", "button_style": "primary", "media_type": "image", "image_asset": "won-promo-4.png", "media_position": "background", "alignment": "left", "min_height": 520 } }
      ]
    },
    {
      "name": "t:won.presets.hero_peek", "category": "t:won.categories.hero",
      "settings": { "layout": "peek", "slide_width": 64, "min_height": 460, "gap": 20, "section_width": "page", "show_arrows": true, "show_progress": false, "autoplay": false },
      "blocks": [
