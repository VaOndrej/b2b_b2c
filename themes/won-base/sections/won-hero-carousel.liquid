        { "type": "won-slide", "settings": { "eyebrow": "Deal", "heading": "<p>Creatine −20%</p>", "heading_size_desktop": 44, "text": "<p>Strength and performance, every day.</p>", "button_label": "Shop now", "button_link": "shopify://collections/all", "button_style": "primary", "media_type": "image", "image_asset": "won-promo-2.png", "media_position": "background", "alignment": "left", "min_height": 460, "corner_radius": 20 } },
