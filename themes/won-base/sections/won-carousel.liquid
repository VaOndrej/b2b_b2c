{%- liquid
  assign s = section.settings
  # Rail controls (arrows / indicator / arrow look) are resolved once, in
  # snippets/won-rail-controls.liquid — see the render below the track.
  assign items_count = 0
  if s.source == 'collection'
    assign items_count = s.collection.products.size
    if items_count > s.products_limit
      assign items_count = s.products_limit
    endif
  else
    assign items_count = section.blocks.size
  endif

  assign cols = s.columns_desktop | default: s.columns
  if items_count > 0 and items_count < cols
    assign cols = items_count
  endif
  assign fits = false
  if items_count > 0 and items_count <= cols
    assign fits = true
  endif
-%}

<section
  class="won-section color-{{ s.color_scheme }}"
  style="{% render 'won-spacing', settings: s %}"
  data-testid="won-carousel-section"
>
  <div class="won-container{% if s.section_width == 'full' %} won-container--full{% endif %} won-carousel-wrap">
    {%- if s.heading != blank or s.head_link_label != blank -%}
      <div class="won-carousel__header">
        {%- if s.heading != blank -%}
          <h2
            class="won-heading won-carousel__heading"
            style="--won-h-size-m: {{ s.heading_size_mobile }}px; --won-h-size-d: {{ s.heading_size_desktop }}px; --won-h-mw-m: {{ s.heading_max_width_mobile }}%; --won-h-mw-d: {{ s.heading_max_width_desktop }}%;"
          >
            {{- s.heading | replace: '</p><p>', '<br>' | remove: '<p>' | remove: '</p>' | strip -}}
          </h2>
        {%- endif -%}
        {%- if s.head_link_label != blank -%}
          <a class="won-carousel__head-link" {% if s.head_link_url != blank %}href="{{ s.head_link_url }}"{% endif %}>{{ s.head_link_label }}</a>
        {%- endif -%}
      </div>
    {%- endif -%}

    <won-carousel data-won-rail-indicator="{{ settings.won_rail_indicator | default: 'per_section' }}"
      class="won-carousel won-carousel--{{ s.layout }}{% if fits %} won-carousel--fits{% endif %}{% if s.columns_mobile contains '.' %} won-carousel--peek-mobile{% endif %}{% if s.layout == 'grid' and s.mobile_carousel %} won-carousel--scroll-sm{% endif %}"
      {% if s.layout == 'slider' and s.autoplay %}data-autoplay="{{ s.autoplay_interval }}"{% endif %}
      {% if s.layout == 'slider' and s.loop != blank %}data-won-loop="{{ s.loop }}"{% endif %}
      {%- comment -%}
        With mobile_carousel on, the grid becomes an 82%-card rail on phones, so
        columns_mobile no longer describes what renders. Report "peek" — the same
        token won-grid emits for its own --scroll-sm rail — or the attribute lies
        to the mobile-mode invariant in storefront.spec.ts.
      {%- endcomment -%}
      data-mobile-mode="{% if s.layout == 'grid' and s.mobile_carousel %}peek{% else %}{{ s.columns_mobile }}{% endif %}"
      style="--won-cols-lg: {{ cols }}; --won-cols-md: {{ s.columns_tablet }}; --won-cols-sm: {{ s.columns_mobile }}; --won-gap: {{ s.gap }}px;"
    >
      <div class="won-carousel__track" data-won-track {% if s.layout == 'marquee' %}data-marquee{% endif %}>
        {%- if s.source == 'collection' -%}
          {%- for product in s.collection.products limit: s.products_limit -%}
            {%- comment -%} Gift cards are a payment instrument, not part of the range: they
              have no packshot, no unit price and no place in "all products". Skipped inside
              the loop rather than filtered upstream, because Liquid cannot rebuild a
              paginated collection — and `!= false` so an unset setting still hides them. {%- endcomment -%}
            {%- if settings.won_hide_gift_cards != false and product.gift_card? -%}{%- continue -%}{%- endif -%}
            <div class="won-carousel__item">
              {% render 'won-product-card', product: product, aspect: s.card_aspect, show_ppu: s.show_card_ppu, ppu_rules: s.ppu_rules %}
            </div>
          {%- endfor -%}
        {%- else -%}
          {% content_for 'blocks' %}
        {%- endif -%}
      </div>

      {%- comment -%} A grid with `mobile_carousel` DOES scroll horizontally below
         750px, so it needs the same control row as a real slider — it just has to
         disappear again above the breakpoint, where the grid stops scrolling. {%- endcomment -%}
      {%- if s.layout == 'grid' and s.mobile_carousel -%}
        {% render 'won-rail-controls', s: s, sm_only: true %}
      {%- endif -%}
      {%- if s.layout == 'slider' -%}
        {% render 'won-rail-controls', s: s %}
      {%- endif -%}
    </won-carousel>
  </div>
</section>

<script src="{{ 'won-carousel.js' | asset_url }}" defer></script>

{% stylesheet %}
  .won-carousel-wrap { display: flex; flex-direction: column; gap: var(--won-space-4); }
  .won-carousel__header { display: flex; align-items: baseline; justify-content: space-between; gap: var(--won-space-4); flex-wrap: wrap; }
  .won-carousel__heading {
    font-size: var(--won-h-size-m, 1.5rem);
    max-width: var(--won-h-mw-m, 100%);
  }
  .won-carousel__head-link { display: inline-flex; align-items: center; min-block-size: 44px; color: var(--won-accent); font-weight: 600; text-decoration: none; white-space: nowrap; }

  .won-carousel { position: relative; display: block; }
  .won-carousel__track {
    display: flex;
    gap: var(--won-gap, 16px);
    --won-cols-cur: var(--won-cols-sm, 1);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    touch-action: pan-x pan-y;
    scrollbar-width: none;
    padding-bottom: 2px;
  }
  .won-carousel__track::-webkit-scrollbar { display: none; }
  .won-carousel__track > * {
    scroll-snap-align: start;
    flex: 0 0 calc((100% - (var(--won-cols-cur) - 1) * var(--won-gap, 16px)) / var(--won-cols-cur));
  }
  /* "fits" = fewer items than desktop columns → center them and drop the scroll.
     Only from the desktop breakpoint: on mobile the cards are near-full-width, so
     removing the scroll clip would spill them past the viewport (horizontal page
     overflow). Mobile always keeps overflow-x: auto (internal scroll). */
  @media (min-width: 1024px) {
    .won-carousel--fits .won-carousel__track { justify-content: center; overflow-x: visible; scroll-snap-type: none; }
  }
  .won-carousel--grid .won-carousel__track {
    display: grid;
    grid-template-columns: repeat(var(--won-cols-cur), minmax(0, 1fr));
    overflow: visible;
    scroll-snap-type: none;
  }
  /* Grid layout that becomes a single swipeable rail on phones. Mirrors
     won-grid's .won-grid--scroll-sm so the two sections behave identically.
     Must out-specify .won-carousel--grid .won-carousel__track above, hence the
     doubled class. */
  @media (max-width: 749px) {
    .won-carousel--scroll-sm.won-carousel--scroll-sm .won-carousel__track {
      display: flex;
      flex-wrap: nowrap;
      grid-template-columns: none;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
    }
    .won-carousel--scroll-sm .won-carousel__track::-webkit-scrollbar { display: none; }
    .won-carousel--scroll-sm .won-carousel__track > * {
      flex: 0 0 min(82%, var(--won-card-max, 380px));
      scroll-snap-align: start;
    }
  }
  /* Ceiling for the default N-column basis too: `columns_mobile: 1` means "one
     card per swipe", not "a card as wide as a tablet". Scoped to the mobile band
     so a 2-column desktop rail still fills its columns. */
  @media (max-width: 749px) {
    .won-carousel__track > * {
      flex-basis: min(
        calc((100% - (var(--won-cols-cur) - 1) * var(--won-gap, 16px)) / var(--won-cols-cur)),
        var(--won-card-max, 380px)
      );
    }
  }
  .won-carousel.is-dragging .won-carousel__track { scroll-snap-type: none; scroll-behavior: auto; cursor: grabbing; }
  /* Fractional mobile columns (e.g. 1.2) = a peek rail. Centre-snap so the
     active card shows a neighbour on BOTH sides mid-scroll — start-snap pinned
     it left and only ever peeked the card on the right. A fixed 76% card leaves
     a clearly visible sliver on each side (a 1.2-column basis minus the gap left
     only a few px — too subtle to read as "there's more"). */
  @media (max-width: 749px) {
    .won-carousel--peek-mobile .won-carousel__track > * { scroll-snap-align: center; flex: 0 0 min(76%, var(--won-card-max, 380px)); }
  }

  .won-carousel__arrows { display: flex; gap: var(--won-space-2); justify-content: flex-end; }
  .won-carousel__arrows[hidden] { display: none; }
  .won-carousel__arrow {
    inline-size: 44px; block-size: 44px; border-radius: var(--won-radius-pill);
    border: 1px solid var(--won-border); background: var(--won-bg); color: var(--won-fg);
    font-size: 1.4rem; line-height: 1; cursor: pointer;
  }
  .won-carousel__arrow:disabled { opacity: 0.35; cursor: default; }
  /* `pill` is the default and MUST reproduce the base rule above (--won-radius-pill).
     Any other default would silently reshape every carousel already in the wild. */
  .won-carousel__arrow--pill { border-radius: var(--won-radius-pill); }
  .won-carousel__arrow--soft { border-radius: var(--won-radius-sm); }
  .won-carousel__arrow--square { border-radius: 0; }
  .won-carousel__arrow--minimal {
    border-radius: 0;
    border-color: transparent;
    background: transparent;
  }
  /* The grid only scrolls below the tablet breakpoint, so its progress bar
     must disappear with the scrolling — a full-width static bar under a
     desktop grid is a dead control. */
  /* Controls that exist only while the grid IS a rail. Above the breakpoint the
     grid stops scrolling, so its arrows and bar must go with it — otherwise they
     are dead controls on a static grid. */
  @media (min-width: 750px) {
    .won-carousel__progress--sm-only,
    .won-carousel__arrows--sm-only { display: none; }
  }
  /* A scroll indicator must read as chrome, not as content. Full-container width in
     solid accent made it the loudest horizontal element on the PDP — louder than the
     prices in the cards it belongs to. Half the height, a muted fill, and a capped
     width keep the affordance while returning the emphasis to the cards. */
  .won-carousel__progress {
    block-size: 2px;
    /* The bar is a SCROLLBAR, so it spans the rail it describes: it takes every
       pixel of the control row the arrows leave. A fixed cap made it a short dash
       under the first card with a dead gap after it — and you cannot read "how far
       along am I" off something that short, which is its only job. Prominence is
       handled by being 2px and muted, not by being narrow.
       Guard: tests/smoke/won-rail-indicator-scale.spec.ts */
    flex: 1 1 auto;
    inline-size: auto;
    background: var(--won-border);
    border-radius: var(--won-radius-pill);
    overflow: hidden;
  }
  .won-carousel__progress-bar {
    display: block; block-size: 100%; inline-size: 30%;
    background: color-mix(in oklab, var(--won-fg) 55%, transparent);
    border-radius: inherit; transform: translateX(0);
  }
  .won-carousel__dots { display: flex; gap: var(--won-space-1); justify-content: center; flex: 1 1 auto; }
  .won-carousel__dots[hidden] { display: none; }
  .won-carousel__dot {
    inline-size: 44px; block-size: 44px; padding: 0; border: 0; background: transparent;
    cursor: pointer; display: inline-flex; align-items: center; justify-content: center;
  }
  .won-carousel__dot::before {
    content: ""; inline-size: 8px; block-size: 8px; border-radius: 50%;
    background: var(--won-border); transition: inline-size var(--won-dur) var(--won-ease), background var(--won-dur) var(--won-ease);
  }
  .won-carousel__dot[aria-current="true"]::before { inline-size: 22px; border-radius: var(--won-radius-pill); background: var(--won-accent); }

  /* Marquee: won-carousel.js wraps the items in a group and duplicates it; each
     group claims >= the full width (100cqi) so the two together always span >=2x
     the viewport and the -50% translate never scrolls a blank gap in (the belt
     used to render its content once, leaving the second half empty). */
  .won-carousel--marquee .won-carousel__track { overflow: hidden; container-type: inline-size; gap: 0; }
  .won-carousel--marquee .won-carousel__track[data-marquee] { animation: won-marquee 30s linear infinite; }
  .won-carousel__mq-group {
    display: flex; align-items: stretch; gap: var(--won-gap, 16px);
    padding-inline-end: var(--won-gap, 16px); flex: 0 0 auto;
    min-inline-size: 100cqi; justify-content: space-around;
  }
  .won-carousel__mq-group > * {
    /* A marquee is a continuous BELT, not an "N per view" rail, so its items are
       sized by their content and spread by the group's space-around — exactly
       how the dedicated won-marquee section does it.
       Sizing them as 100cqi / --won-cols-cur made the belt depend on the column
       breakpoints, and the columns settings are per-layout: a marquee with only
       columns_desktop set fell back to --won-cols-sm (1) below 1024px, so every
       logo became a full viewport wide and the belt showed exactly one at a time
       with a screenful of gap after it. */
    flex: 0 0 auto;
    max-inline-size: 100cqi;
    scroll-snap-align: none;
  }
  .won-carousel--marquee:hover .won-carousel__track[data-marquee] { animation-play-state: paused; }
  @keyframes won-marquee { from { transform: translateX(0); } to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) {
    .won-carousel--marquee .won-carousel__track[data-marquee] { animation: none; }
    .won-carousel__mq-group[aria-hidden="true"] { display: none; }
    .won-carousel__track { scroll-behavior: auto; }
  }

  /* .won-pcard* styles are global (won-tokens.css) — shared by carousel + PLP. */

  @media (min-width: 750px) {
    .won-carousel__track { --won-cols-cur: var(--won-cols-md, 2); }
    .won-carousel__heading { font-size: var(--won-h-size-d, 2rem); max-width: var(--won-h-mw-d, 60%); }
  }
  @media (min-width: 1024px) {
    .won-carousel__track { --won-cols-cur: var(--won-cols-lg, 4); }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:won.names.carousel",
  "tag": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "max_blocks": 24,
  "blocks": [{ "type": "won-slide" }, { "type": "@theme" }, { "type": "@app" }],
  "settings": [
    { "type": "paragraph", "content": "t:won.info.carousel_about" },
    { "type": "header", "content": "t:won.headers.mode" },
    {
      "type": "select", "id": "layout", "label": "t:won.settings.layout",
      "options": [
        { "value": "slider", "label": "t:won.options.layout_slider" },
        { "value": "grid", "label": "t:won.options.layout_grid" },
        { "value": "marquee", "label": "t:won.options.layout_marquee" }
      ],
      "default": "slider"
    },
    { "type": "header", "content": "t:won.headers.content" },
    {
      "type": "select", "id": "source", "label": "t:won.settings.source",
      "options": [
        { "value": "manual", "label": "t:won.options.source_manual" },
        { "value": "collection", "label": "t:won.options.source_collection" }
      ],
      "default": "manual"
    },
    { "type": "collection", "id": "collection", "label": "t:won.settings.collection" },
    { "type": "range", "id": "products_limit", "label": "t:won.settings.products_limit", "min": 2, "max": 24, "step": 1, "default": 8, "visible_if": "{{ section.settings.source == 'collection' }}" },
    { "type": "richtext", "id": "heading", "label": "t:won.settings.heading" },
    { "type": "range", "id": "heading_size_desktop", "label": "t:won.settings.heading_size_desktop", "min": 20, "max": 72, "step": 2, "unit": "px", "default": 34 },
    { "type": "range", "id": "heading_max_width_desktop", "label": "t:won.settings.heading_max_width_desktop", "min": 30, "max": 100, "step": 5, "unit": "%", "default": 60 },
    { "type": "range", "id": "heading_size_mobile", "label": "t:won.settings.heading_size_mobile", "min": 16, "max": 48, "step": 2, "unit": "px", "default": 24 },
    { "type": "range", "id": "heading_max_width_mobile", "label": "t:won.settings.heading_max_width_mobile", "min": 30, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "text", "id": "head_link_label", "label": "t:won.settings.head_link_label" },
    { "type": "url", "id": "head_link_url", "label": "t:won.settings.head_link_url" },
    { "type": "header", "content": "t:won.headers.layout" },
    { "type": "range", "id": "columns_desktop", "label": "t:won.settings.columns_desktop", "min": 1, "max": 6, "step": 1, "default": 4, "visible_if": "{{ section.settings.layout != 'marquee' }}" },
    { "type": "range", "id": "columns_tablet", "label": "t:won.settings.columns_tablet", "min": 1, "max": 4, "step": 1, "default": 2, "visible_if": "{{ section.settings.layout != 'marquee' }}" },
    {
      "type": "select", "id": "columns_mobile", "label": "t:won.settings.columns_mobile",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "1.2", "label": "t:won.options.one_peek" },
        { "value": "2", "label": "2" }
      ],
      "default": "1",
      "visible_if": "{{ section.settings.layout != 'marquee' }}"
    },
    { "type": "checkbox", "id": "mobile_carousel", "label": "t:won.settings.mobile_carousel", "info": "t:won.info.mobile_carousel", "default": false, "visible_if": "{{ section.settings.layout == 'grid' }}" },
    { "type": "range", "id": "gap", "label": "t:won.settings.gap", "min": 0, "max": 48, "step": 2, "unit": "px", "default": 16 },
    {
      "type": "select", "id": "card_aspect", "label": "t:won.settings.card_aspect", "visible_if": "{{ section.settings.source == 'collection' }}",
      "options": [
        { "value": "natural", "label": "t:won.options.aspect_natural" },
        { "value": "square", "label": "t:won.options.aspect_square" },
        { "value": "portrait", "label": "t:won.options.aspect_portrait" },
        { "value": "landscape", "label": "t:won.options.aspect_landscape" }
      ],
      "default": "portrait"
    },
    { "type": "checkbox", "id": "show_card_ppu", "label": "t:won.settings.vp_show_ppu", "default": false, "visible_if": "{{ section.settings.source == 'collection' }}" },
    { "type": "textarea", "id": "ppu_rules", "label": "t:won.settings.ppu_rules_override", "info": "t:won.info.ppu_rules_override", "visible_if": "{{ section.settings.show_card_ppu }}" },
    { "type": "header", "content": "t:won.headers.controls" },
    { "type": "checkbox", "id": "show_arrows", "label": "t:won.settings.show_arrows", "default": true, "visible_if": "{{ section.settings.layout == 'slider' }}" },
    {
      "type": "select", "id": "arrow_style", "label": "t:won.settings.arrow_style",
      "options": [
        { "value": "pill", "label": "t:won.options.arrow_pill" },
        { "value": "soft", "label": "t:won.options.arrow_soft" },
        { "value": "square", "label": "t:won.options.arrow_square" },
        { "value": "minimal", "label": "t:won.options.arrow_minimal" }
      ],
      "default": "pill",
      "visible_if": "{{ section.settings.layout == 'slider' and section.settings.show_arrows }}"
    },
    { "type": "checkbox", "id": "show_progress", "label": "t:won.settings.show_progress", "info": "t:won.info.show_progress", "default": true, "visible_if": "{{ section.settings.layout == 'slider' or section.settings.mobile_carousel }}" },
    { "type": "checkbox", "id": "show_dots", "label": "t:won.settings.show_dots", "default": false, "visible_if": "{{ section.settings.layout == 'slider' }}" },
    {
      "type": "select", "id": "loop", "label": "t:won.settings.loop", "info": "t:won.info.loop", "visible_if": "{{ section.settings.layout == 'slider' }}",
      "options": [
        { "value": "", "label": "t:won.options.loop_off" },
        { "value": "always", "label": "t:won.options.loop_always" },
        { "value": "desktop", "label": "t:won.options.loop_desktop" },
        { "value": "mobile", "label": "t:won.options.loop_mobile" }
      ],
      "default": ""
    },
    { "type": "checkbox", "id": "autoplay", "label": "t:won.settings.autoplay", "default": false, "visible_if": "{{ section.settings.layout == 'slider' }}" },
    { "type": "range", "id": "autoplay_interval", "label": "t:won.settings.autoplay_interval", "min": 2, "max": 10, "step": 1, "unit": "s", "default": 5, "visible_if": "{{ section.settings.layout == 'slider' and section.settings.autoplay }}" },
    { "type": "header", "content": "t:won.headers.appearance" },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:won.settings.color_scheme", "default": "scheme-1" },
    {
      "type": "select", "id": "section_width", "label": "t:won.settings.section_width",
      "options": [
        { "value": "page", "label": "t:won.options.width_page" },
        { "value": "full", "label": "t:won.options.width_full" }
      ],
      "default": "page"
    },
    { "type": "color", "id": "accent_override", "label": "t:won.settings.accent_override" },
    { "type": "header", "content": "t:won.headers.spacing" },
    { "type": "range", "id": "padding_top", "label": "t:won.settings.padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "t:won.settings.padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 48 }
  ],
  "presets": [
    {
      "name": "t:won.presets.product_carousel",
      "category": "t:won.categories.products",
      "settings": { "source": "collection", "layout": "slider", "columns_desktop": 4, "heading": "<p>Bestsellers</p>" }
    },
    {
      "name": "t:won.presets.content_slider",
      "category": "t:won.categories.content",
      "settings": { "source": "manual", "layout": "slider", "columns_desktop": 3 },
      "blocks": [{ "type": "won-slide" }, { "type": "won-slide" }, { "type": "won-slide" }]
    },
    {
      "name": "t:won.presets.logo_marquee",
      "category": "t:won.categories.content",
      "settings": { "source": "manual", "layout": "marquee", "columns_desktop": 6, "show_arrows": false, "show_progress": false },
      "blocks": [{ "type": "won-slide" }, { "type": "won-slide" }, { "type": "won-slide" }, { "type": "won-slide" }, { "type": "won-slide" }, { "type": "won-slide" }]
    }
  ]
}
{% endschema %}
