{%- comment -%}
  won-announcement-bar — a thin, generic top-of-page bar. Replaces the old
  single-purpose won-shipping-bar: each announcement is its own block, so a
  merchant mixes free-shipping progress, a promo/new-collection line, and plain
  messages, and turns each on/off independently. Blocks either rotate one at a
  time (<won-announcement> cycles them) or show as a single static line. The
  free_shipping block keeps the live cart progress bar. Optional dismiss button
  remembers the close for the session.
{%- endcomment -%}

{%- assign s = section.settings -%}
<section
  class="won-section color-{{ s.color_scheme }}"
  style="{% render 'won-spacing', settings: s %}"
  data-testid="won-announcement-bar-section"
>
  <div class="won-container">
    <won-announcement
      class="won-annbar won-annbar--{{ s.display }}{% if s.dismissible %} won-annbar--dismissible{% endif %}"
      data-display="{{ s.display }}"
      data-interval="{{ s.interval }}"
      {% if s.dismissible %}data-dismiss-key="won-ann-{{ section.id }}"{% endif %}
      style="--won-annbar-align: {{ s.alignment }};"
    >
      <div class="won-annbar__viewport" aria-live="polite">
        {%- for block in section.blocks -%}
          {%- assign bs = block.settings -%}
          <div class="won-annbar__item" data-annbar-item{% unless forloop.first %} hidden{% endunless %} {{ block.shopify_attributes }}>
            {%- case block.type -%}
              {%- when 'free_shipping' -%}
                {%- liquid
                  assign threshold = bs.threshold | times: 100
                  assign total = cart.total_price
                  assign remaining = threshold | minus: total
                  assign rem_money = remaining | money
                  assign pct = 0
                  if threshold > 0
                    assign pct = total | times: 100 | divided_by: threshold
                    if pct > 100
                      assign pct = 100
                    endif
                  endif
                -%}
                <span
                  class="won-annbar__ship"
                  data-annbar-ship
                  data-threshold="{{ threshold }}"
                  data-msg-remaining="{{ bs.msg_remaining | default: 'won.ship.remaining' | t | escape }}"
                  data-msg-reached="{{ bs.msg_reached | default: 'won.ship.reached' | t | escape }}"
                >
                  {%- if bs.icon != blank -%}<span class="won-annbar__icon" aria-hidden="true">{{ bs.icon }}</span>{%- endif -%}
                  <span class="won-annbar__msg" data-annbar-ship-msg>
                    {%- if remaining <= 0 -%}
                      {{ bs.msg_reached | default: 'won.ship.reached' | t }}
                    {%- else -%}
                      {{ bs.msg_remaining | default: 'won.ship.remaining' | t | replace: '[amount]', rem_money }}
                    {%- endif -%}
                  </span>
                  <span class="won-annbar__track"><span class="won-annbar__fill" data-annbar-ship-fill style="inline-size: {{ pct }}%;"></span></span>
                </span>
              {%- when 'message' -%}
                {%- if bs.icon != blank -%}<span class="won-annbar__icon" aria-hidden="true">{{ bs.icon }}</span>{%- endif -%}
                {%- if bs.link != blank -%}
                  <a class="won-annbar__msg won-annbar__link" href="{{ bs.link }}">{{ bs.text }}</a>
                {%- else -%}
                  <span class="won-annbar__msg">{{ bs.text }}</span>
                {%- endif -%}
            {%- endcase -%}
          </div>
        {%- endfor -%}
      </div>
      {%- if s.dismissible -%}
        <button type="button" class="won-annbar__close" data-annbar-close aria-label="{{ 'won.a11y.close' | t }}"><span aria-hidden="true">&times;</span></button>
      {%- endif -%}
    </won-announcement>
  </div>
</section>

{% stylesheet %}
  .won-annbar { position: relative; display: flex; align-items: center; min-block-size: 24px; }
  .won-annbar__viewport {
    flex: 1 1 auto; display: flex; align-items: center; flex-wrap: wrap;
    justify-content: var(--won-annbar-align, center); gap: var(--won-space-1) var(--won-space-3);
  }
  .won-annbar--dismissible .won-annbar__viewport { padding-inline: 44px; }
  .won-annbar__item { display: inline-flex; align-items: center; gap: var(--won-space-2); font-size: 0.86rem; font-weight: 600; }
  .won-annbar__item[hidden] { display: none; }
  .won-annbar__ship { display: inline-flex; align-items: center; gap: var(--won-space-2); }
  .won-annbar__msg { margin: 0; }
  .won-annbar__link { color: inherit; text-decoration: underline; text-underline-offset: 2px; }
  .won-annbar__icon { font-size: 1.05em; line-height: 1; }
  .won-annbar__track {
    display: inline-block; inline-size: clamp(80px, 20vw, 200px); block-size: 6px;
    background: var(--won-border); border-radius: var(--won-radius-pill); overflow: hidden; vertical-align: middle;
  }
  .won-annbar__fill { display: block; block-size: 100%; inline-size: 0; background: var(--won-accent); border-radius: inherit; transition: inline-size var(--won-dur) var(--won-ease); }
  .won-annbar__close {
    position: absolute; inset-inline-end: 0; inset-block: 0; margin-block: auto;
    inline-size: 44px; block-size: 44px; padding: 0; border: 0; background: transparent;
    display: inline-flex; align-items: center; justify-content: center;
    color: inherit; cursor: pointer; font-size: 1.3rem; line-height: 1; opacity: 0.65;
  }
  .won-annbar__close:hover { opacity: 1; }
  /* Rotate: each freshly-shown item fades in. */
  .won-annbar--rotate .won-annbar__item:not([hidden]) { animation: won-annbar-in var(--won-dur) var(--won-ease); }
  @keyframes won-annbar-in { from { opacity: 0; } to { opacity: 1; } }
  /* Reduced motion / no-JS: reveal every rotating message inline (nobody misses
     an announcement because the rotation never ran). */
  @media (prefers-reduced-motion: reduce) {
    .won-annbar--rotate .won-annbar__item[hidden] { display: inline-flex; }
    .won-annbar--rotate .won-annbar__item { animation: none; }
  }
{% endstylesheet %}

{% javascript %}
  class WonAnnouncement extends HTMLElement {
    connectedCallback() {
      if (this.dataset.wonBound) return;
      this.dataset.wonBound = '1';
      this.items = Array.from(this.querySelectorAll('[data-annbar-item]'));
      this.reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Dismiss: hide for the session once closed.
      this.key = this.dataset.dismissKey;
      if (this.key) {
        try { if (sessionStorage.getItem(this.key) === '1') this.hideBar(); } catch (e) {}
        var close = this.querySelector('[data-annbar-close]');
        if (close) close.addEventListener('click', () => {
          this.hideBar();
          try { sessionStorage.setItem(this.key, '1'); } catch (e) {}
        });
      }

      // Live free-shipping progress (any free_shipping block).
      this.ship = this.querySelector('[data-annbar-ship]');
      if (this.ship) {
        /* ONE event, and the cart comes WITH it. Subscribing to both fired this
           twice for every add — measured on the dev store: two identical
           /cart.js in the same millisecond — and each one re-read a cart the
           event was already carrying. `cart:refresh` is the base-agnostic one
           every won cart write emits, so it is the one to keep. */
        this._refresh = (e) => this.refreshShip(e && e.detail && e.detail.cart);
        document.addEventListener('cart:refresh', this._refresh);
      }

      // Rotate through the messages (only worth it with 2+ and motion allowed).
      if (this.dataset.display === 'rotate' && this.items.length > 1 && !this.reduced) {
        this.i = 0;
        var interval = (parseFloat(this.dataset.interval) || 5) * 1000;
        this._timer = setInterval(() => this.advance(), interval);
        this.addEventListener('pointerenter', () => clearInterval(this._timer));
        this.addEventListener('pointerleave', () => { this._timer = setInterval(() => this.advance(), interval); });
      }
    }
    disconnectedCallback() {
      clearInterval(this._timer);
      if (this._refresh) document.removeEventListener('cart:refresh', this._refresh);
    }
    hideBar() {
      var sec = this.closest('.won-section');
      (sec || this).setAttribute('hidden', '');
    }
    advance() {
      this.items[this.i].setAttribute('hidden', '');
      this.i = (this.i + 1) % this.items.length;
      this.items[this.i].removeAttribute('hidden');
    }
    money(cents, currency) {
      try { return new Intl.NumberFormat(undefined, { style: 'currency', currency: currency || 'USD' }).format(cents / 100); }
      catch (e) { return (cents / 100).toFixed(2); }
    }
    async refreshShip(cart) {
      var threshold = parseInt(this.ship.dataset.threshold, 10) || 0;
      if (!threshold) return;
      try {
        if (!cart || typeof cart.total_price !== 'number') cart = await (await fetch('/cart.js')).json();
        var total = cart.total_price;
        var pct = Math.min(100, Math.round((total / threshold) * 100));
        var fill = this.ship.querySelector('[data-annbar-ship-fill]');
        var msg = this.ship.querySelector('[data-annbar-ship-msg]');
        if (fill) fill.style.inlineSize = pct + '%';
        if (msg) {
          msg.textContent = total >= threshold
            ? this.ship.dataset.msgReached
            : (this.ship.dataset.msgRemaining || '').replace('[amount]', this.money(threshold - total, cart.currency));
        }
      } catch (e) { /* keep server-rendered state */ }
    }
  }
  if (!customElements.get('won-announcement')) customElements.define('won-announcement', WonAnnouncement);
{% endjavascript %}

{% schema %}
{
  "name": "t:won.names.announcement_bar",
  "tag": "section",
  "class": "won-announcement-bar-section",
  "max_blocks": 8,
  "blocks": [
    {
      "type": "message",
      "name": "t:won.names.ann_message",
      "settings": [
        { "type": "text", "id": "text", "label": "t:won.settings.text", "default": "t:won.defaults.ann_message" },
        { "type": "text", "id": "icon", "label": "t:won.settings.icon", "info": "t:won.info.ann_icon" },
        { "type": "url", "id": "link", "label": "t:won.settings.link", "info": "t:won.info.ann_link" }
      ]
    },
    {
      "type": "free_shipping",
      "name": "t:won.names.ann_freeship",
      "settings": [
        { "type": "number", "id": "threshold", "label": "t:won.settings.ship_threshold", "info": "t:won.info.ship_threshold", "default": 1500 },
        { "type": "text", "id": "icon", "label": "t:won.settings.icon", "info": "t:won.info.ann_icon" },
        { "type": "text", "id": "msg_remaining", "label": "t:won.settings.ship_msg_remaining", "info": "t:won.info.ship_msg_remaining" },
        { "type": "text", "id": "msg_reached", "label": "t:won.settings.ship_msg_reached" }
      ]
    }
  ],
  "settings": [
    { "type": "paragraph", "content": "t:won.info.announcement_bar_about" },
    { "type": "header", "content": "t:won.headers.mode" },
    {
      "type": "select", "id": "display", "label": "t:won.settings.ann_display", "info": "t:won.info.ann_display",
      "options": [
        { "value": "rotate", "label": "t:won.options.ann_rotate" },
        { "value": "single", "label": "t:won.options.ann_single" }
      ],
      "default": "rotate"
    },
    { "type": "header", "content": "t:won.headers.layout" },
    {
      "type": "select", "id": "alignment", "label": "t:won.settings.alignment",
      "options": [
        { "value": "center", "label": "t:won.options.align_center" },
        { "value": "flex-start", "label": "t:won.options.align_start" }
      ],
      "default": "center"
    },
    { "type": "header", "content": "t:won.headers.controls" },
    { "type": "range", "id": "interval", "label": "t:won.settings.ann_interval", "info": "t:won.info.ann_interval", "min": 3, "max": 12, "step": 1, "unit": "s", "default": 5, "visible_if": "{{ section.settings.display == 'rotate' }}" },
    { "type": "checkbox", "id": "dismissible", "label": "t:won.settings.ann_dismissible", "info": "t:won.info.ann_dismissible", "default": false },
    { "type": "header", "content": "t:won.headers.appearance" },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:won.settings.color_scheme", "default": "scheme-2" },
    { "type": "header", "content": "t:won.headers.spacing" },
    { "type": "range", "id": "padding_top", "label": "t:won.settings.padding_top", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 10 },
    { "type": "range", "id": "padding_bottom", "label": "t:won.settings.padding_bottom", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 10 }
  ],
  "presets": [
    {
      "name": "t:won.names.announcement_bar",
      "category": "t:won.categories.layout",
      "settings": { "display": "rotate" },
      "blocks": [
        { "type": "free_shipping" },
        { "type": "message" }
      ]
    }
  ]
}
{% endschema %}
