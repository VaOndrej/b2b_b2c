{%- comment -%} DEPRECATED: preset stripped, not in the Add-section picker. Superseded by won-grid (stats_row / trust_band). Kept for back-compat rendering only — do not add new settings here. {%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign lines = s.stats | newline_to_br | split: '<br />'
  # Count-up: section duration of 0 means "inherit the theme-wide default"
  # (Won · Animace čísel global setting), otherwise the section value wins.
  assign countup_duration = s.animate_duration
  if countup_duration == 0
    assign countup_duration = settings.won_countup_default_duration | default: 1600
  endif
-%}
<section
  class="won-section color-{{ s.color_scheme }}"
  style="{% render 'won-spacing', settings: s %}"
  data-testid="won-stats-section"
>
  <div class="won-container{% if s.section_width == 'full' %} won-container--full{% endif %} won-stats-wrap">
    {%- if s.heading != blank -%}
      <h2
        class="won-heading won-stats__heading"
        style="--won-h-size-m: {{ s.heading_size_mobile }}px; --won-h-size-d: {{ s.heading_size_desktop }}px; --won-h-mw-m: {{ s.heading_max_width_mobile }}%; --won-h-mw-d: {{ s.heading_max_width_desktop }}%; text-align: {{ s.content_align }};"
      >
        {{- s.heading | replace: '</p><p>', '<br>' | remove: '<p>' | remove: '</p>' | strip -}}
      </h2>
    {%- endif -%}
    <dl class="won-stats" style="--won-cols-lg: {{ s.columns_desktop }}; --won-cols-sm: {{ s.columns_mobile }};">
      {%- for line in lines -%}
        {%- assign row = line | strip -%}
        {%- if row contains ':' -%}
          {%- assign value = row | split: ':' | first | strip -%}
          {%- assign label = row | split: ':' | last | strip -%}
          <div class="won-stat">
            <dt class="won-stat__value"{% if s.animate_values %} data-won-countup data-won-countup-duration="{{ countup_duration }}"{% endif %}>{{ value }}</dt>
            <dd class="won-stat__label">{{ label }}</dd>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </dl>
  </div>
</section>

{%- if s.animate_values -%}
  {{ 'won-count-up.js' | asset_url | script_tag }}
{%- endif -%}

{% stylesheet %}
  .won-stats-wrap { display: flex; flex-direction: column; gap: var(--won-space-5); }
  .won-stats__heading { font-size: var(--won-h-size-m, 1.8rem); max-width: var(--won-h-mw-m, 100%); }
  .won-stats { margin: 0; display: grid; gap: var(--won-space-5); grid-template-columns: repeat(var(--won-cols-sm, 2), minmax(0, 1fr)); text-align: center; }
  .won-stat { display: flex; flex-direction: column; gap: var(--won-space-1); }
  .won-stat__value { margin: 0; font-size: clamp(2rem, 5vw, 3.2rem); font-weight: 800; letter-spacing: -0.03em; color: var(--won-accent); line-height: 1; }
  .won-stat__label { margin: 0; opacity: 0.8; }
  @media (min-width: 750px) {
    .won-stats__heading { font-size: var(--won-h-size-d, 2.4rem); max-width: var(--won-h-mw-d, 100%); }
    .won-stats { grid-template-columns: repeat(var(--won-cols-lg, 4), minmax(0, 1fr)); }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:won.names.stats",
  "tag": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:won.headers.content"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "t:won.settings.heading"
    },
    {
      "type": "range",
      "id": "heading_size_desktop",
      "label": "t:won.settings.heading_size_desktop",
      "min": 20,
      "max": 72,
      "step": 2,
      "unit": "px",
      "default": 34
    },
    {
      "type": "range",
      "id": "heading_max_width_desktop",
      "label": "t:won.settings.heading_max_width_desktop",
      "min": 30,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "t:won.settings.heading_size_mobile",
      "min": 16,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "heading_max_width_mobile",
      "label": "t:won.settings.heading_max_width_mobile",
      "min": 30,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "textarea",
      "id": "stats",
      "label": "t:won.settings.stats",
      "default": "t:won.defaults.stats_items"
    },
    {
      "type": "header",
      "content": "t:won.headers.layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "t:won.settings.columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "t:won.settings.columns_mobile",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "2"
    },
    {
      "type": "text_alignment",
      "id": "content_align",
      "label": "t:won.settings.content_align",
      "default": "center"
    },
    {
      "type": "header",
      "content": "t:won.headers.controls"
    },
    {
      "type": "checkbox",
      "id": "animate_values",
      "label": "t:won.settings.animate_values",
      "info": "t:won.info.animate_values",
      "default": false
    },
    {
      "type": "range",
      "id": "animate_duration",
      "label": "t:won.settings.animate_duration",
      "min": 0,
      "max": 4000,
      "step": 100,
      "unit": "ms",
      "default": 0,
      "info": "t:won.info.animate_duration",
      "visible_if": "{{ section.settings.animate_values }}"
    },
    {
      "type": "header",
      "content": "t:won.headers.appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:won.settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:won.settings.section_width",
      "options": [
        {
          "value": "page",
          "label": "t:won.options.width_page"
        },
        {
          "value": "full",
          "label": "t:won.options.width_full"
        }
      ],
      "default": "page"
    },
    {
      "type": "header",
      "content": "t:won.headers.spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:won.settings.padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:won.settings.padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 56
    }
  ]
}
{% endschema %}
