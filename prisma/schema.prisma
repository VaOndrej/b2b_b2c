// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model MarginGuardConfig {
  id                    String   @id @default("default")
  b2bTag                String   @default("b2b")
  globalMinPricePercent Float    @default(70)
  b2bGlobalMinPricePercent Float  @default(70)
  productCatalogSourceType String @default("SHOPIFY")
  productCatalogAutoImportEnabled Boolean @default(true)
  productCatalogLastSyncAt DateTime?
  productCatalogLastSyncError String?
  allowZeroFinalPrice   Boolean  @default(false)
  allowRemoveAtMinimumOrderQuantity Boolean @default(true)
  allowStacking         Boolean  @default(false)
  maxCombinedPercentOff Float?
  marginGuardEnabled    Boolean  @default(true)
  cartValidationStatus  String   @default("UNKNOWN")
  cartValidationLastError String?
  cartValidationLastSyncAt DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  // MVP_5_3 #2.3c — the per-segment pricing/discount/quantity/visibility children
  // were dropped; price catalogs are now the single source of truth. Only
  // shop-wide scalars + violations + the separate storefront-content rules remain.
  violations            MarginViolationLog[]
  storefrontContentRules StorefrontContentRule[]
  collectionVisibilityRules CollectionVisibilityRule[]
}

model CatalogProduct {
  id              String   @id @default(cuid())
  sourceType      String
  externalKey     String
  shopifyProductId String? @unique
  title           String
  handle          String?
  status          String?
  vendor          String?
  productType     String?
  imageUrl        String?
  isActive        Boolean  @default(true)
  syncedAt        DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([sourceType, externalKey])
}

model CatalogCollection {
  id                  String   @id @default(cuid())
  sourceType          String
  externalKey         String
  shopifyCollectionId String?  @unique
  title               String
  handle              String?
  isActive            Boolean  @default(true)
  syncedAt            DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([sourceType, externalKey])
}

model CatalogVariant {
  id               String   @id @default(cuid())
  sourceType       String
  externalKey      String
  shopifyVariantId String?  @unique
  shopifyProductId String?
  title            String
  productTitle     String
  productHandle    String?
  sku              String?
  optionSummary    String?
  isActive         Boolean  @default(true)
  syncedAt         DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([sourceType, externalKey])
}

model MarginViolationLog {
  id              String            @id @default(cuid())
  configId        String
  config          MarginGuardConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  shop            String
  productId       String
  customerId      String?
  segment         String
  basePrice       Float
  finalPrice      Float
  floorPrice      Float
  violationAmount Float
  source          String
  createdAt       DateTime          @default(now())
}

model StorefrontContentRule {
  id              String            @id @default(cuid())
  configId        String
  config          MarginGuardConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  name            String
  active          Boolean           @default(true)
  priority        Int               @default(100)
  segment         String
  pageType        String            @default("ALL")
  productId       String?
  collectionId    String?
  targetType      String
  targetSelector  String?
  targetPosition  String?
  action          String
  value           String?
  valueCsLocale   String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([configId, name])
}

model CollectionVisibilityRule {
  id               String            @id @default(cuid())
  configId         String
  config           MarginGuardConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  collectionId     String
  collectionHandle String
  collectionTitle  String?
  visibilityMode   String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([configId, collectionId])
}

// ---------------------------------------------------------------------------
// MVP_5_3 — Simulated price catalogs. A catalog generalizes the binary B2B/B2C
// segment into a universal scoping key (audience + membership + price list +
// floor + discounts + quantity + optional market). The default (base) catalog
// is the global baseline / anonymous-B2C fallback; other catalogs are deltas.
//
// NOTE: the existing CatalogProduct/CatalogCollection/CatalogVariant models are
// the import master-list ("Products / Source"), NOT price catalogs — left as-is.
//
// Phase 1 is additive: these tables are created and seeded with the two system
// catalogs (default + b2b) so behavior is unchanged. The destructive
// segment→catalogId remap + reader switch is sequenced into Phase 2, where the
// admin and config builder actually consume these tables.
// ---------------------------------------------------------------------------

model PriceCatalog {
  id             String   @id @default(cuid())
  name           String
  priority       Int      @default(0)
  status         String   @default("ACTIVE")
  isDefault      Boolean  @default(false)
  isSystem       Boolean  @default(false)
  matchCompany   Boolean  @default(false)
  membershipMode String   @default("INHERIT_ALL")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  audienceTags  CatalogAudienceTag[]
  marketFilters CatalogMarketFilter[]
  memberships   CatalogMembership[]
  priceRules    CatalogPriceRule[]
  tierPrices    CatalogTierPriceRule[]
  floorRules    CatalogFloorRule[]
  quantityRules CatalogQuantityRule[]
  discountRules CatalogDiscountRule[]
  variantVisibilityRules CatalogVariantVisibilityRule[]
  visibilityRules CatalogVisibilityRule[]
  couponRules   CatalogCouponRule[]
  discountCaps  CatalogDiscountCap[]
  blacklistRules CatalogDiscountBlacklistRule[]
  customerQuantityRules CatalogCustomerQuantityRule[]
}

model CatalogAudienceTag {
  id        String       @id @default(cuid())
  catalogId String
  catalog   PriceCatalog @relation(fields: [catalogId], references: [id], onDelete: Cascade)
  tag       String

  @@unique([catalogId, tag])
}

model CatalogMarketFilter {
  id           String       @id @default(cuid())
  catalogId    String
  catalog      PriceCatalog @relation(fields: [catalogId], references: [id], onDelete: Cascade)
  countryCode  String?
  currencyCode String?
  languageCode String?
}

model CatalogMembership {
  id        String       @id @default(cuid())
  catalogId String
  catalog   PriceCatalog @relation(fields: [catalogId], references: [id], onDelete: Cascade)
  productId String

  @@unique([catalogId, productId])
}

model CatalogPriceRule {
  id        String       @id @default(cuid())
  catalogId String
  catalog   PriceCatalog @relation(fields: [catalogId], references: [id], onDelete: Cascade)
  scope     String // CATALOG | COLLECTION | PRODUCT | VARIANT
  targetId  String?
  mode      String // FIXED | PERCENT
  value     Float
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([catalogId, scope, targetId])
}

model CatalogTierPriceRule {
  id          String       @id @default(cuid())
  catalogId   String
  catalog     PriceCatalog @relation(fields: [catalogId], references: [id], onDelete: Cascade)
  productId   String
  variantId   String?
  minQuantity Int
  unitPrice   Float
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([catalogId, productId, variantId, minQuantity])
}

model CatalogFloorRule {
  id                    String       @id @default(cuid())
  catalogId             String
  catalog               PriceCatalog @relation(fields: [catalogId], references: [id], onDelete: Cascade)
  productId             String? // null = catalog-level default
  variantId             String?
  minPercentOfBasePrice Float
  allowZeroFinalPrice   Boolean?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  @@unique([catalogId, productId, variantId])
}

model CatalogQuantityRule {
  id           String       @id @default(cuid())
  catalogId    String
  catalog      PriceCatalog @relation(fields: [catalogId], references: [id], onDelete: Cascade)
  productId    String?
  variantId    String?
  collectionId String?
  moq          Int?
  step         Int?
  max          Int?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([catalogId, productId, variantId, collectionId])
}

model CatalogDiscountRule {
  id                         String       @id @default(cuid())
  catalogId                  String
  catalog                    PriceCatalog @relation(fields: [catalogId], references: [id], onDelete: Cascade)
  scope                      String
  targetId                   String?
  code                       String?
  percentOff                 Float
  priority                   Int          @default(100)
  stackMode                  String       @default("STACKABLE")
  minPricePercentOfBasePrice Float?
  createdAt                  DateTime     @default(now())
  updatedAt                  DateTime     @updatedAt
}

// MVP_5_3 #1 — per-catalog VARIANT visibility (e.g. a carton variant visible
// only in the wholesale catalog). visibilityMode "HIDDEN" hides the variant for
// customers resolved into this catalog. Projected to the storefront per catalog.
model CatalogVariantVisibilityRule {
  id             String       @id @default(cuid())
  catalogId      String
  catalog        PriceCatalog @relation(fields: [catalogId], references: [id], onDelete: Cascade)
  productId      String
  variantId      String
  visibilityMode String       @default("HIDDEN")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([catalogId, variantId])
}

// MVP_5_3 #2.0a — per-catalog PRODUCT / COLLECTION visibility (catalog-native
// replacement for the legacy segment-based ProductVisibilityRule /
// CollectionVisibilityRule). visibilityMode "HIDDEN" hides the target for
// customers resolved into this catalog. `handle` caches the storefront handle
// (collections are hidden by handle; product handles are resolved at projection).
model CatalogVisibilityRule {
  id             String       @id @default(cuid())
  catalogId      String
  catalog        PriceCatalog @relation(fields: [catalogId], references: [id], onDelete: Cascade)
  scope          String // "PRODUCT" | "COLLECTION"
  targetId       String
  handle         String?
  visibilityMode String       @default("HIDDEN")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([catalogId, scope, targetId])
}

// MVP_5_3 #2.0b — a coupon code is allowed for this catalog's audience
// (catalog-native replacement for CouponSegmentRule). A code with any catalog
// rule is restricted to those catalogs.
model CatalogCouponRule {
  id        String       @id @default(cuid())
  catalogId String
  catalog   PriceCatalog @relation(fields: [catalogId], references: [id], onDelete: Cascade)
  code      String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([catalogId, code])
}

// MVP_5_3 #2.0d — per-catalog max combined discount cap (replaces
// DiscountSegmentCap). One cap per catalog.
model CatalogDiscountCap {
  id                    String       @id @default(cuid())
  catalogId             String       @unique
  catalog               PriceCatalog @relation(fields: [catalogId], references: [id], onDelete: Cascade)
  maxCombinedPercentOff Float
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
}

// MVP_5_3 #2.0c — discount combination blacklist as catalog/shop policy
// (replaces DiscountCombinationBlacklistRule). Put shop-wide pairs on the
// default catalog; per-catalog pairs on the catalog.
model CatalogDiscountBlacklistRule {
  id         String       @id @default(cuid())
  catalogId  String
  catalog    PriceCatalog @relation(fields: [catalogId], references: [id], onDelete: Cascade)
  leftType   String
  leftValue  String
  rightType  String
  rightValue String
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
}

// MVP_5_3 #2.0e — per-catalog customer-specific max order quantity (replaces
// ProductCustomerQuantityRule).
model CatalogCustomerQuantityRule {
  id               String       @id @default(cuid())
  catalogId        String
  catalog          PriceCatalog @relation(fields: [catalogId], references: [id], onDelete: Cascade)
  customerId       String
  productId        String
  maxOrderQuantity Int
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@unique([catalogId, customerId, productId])
}
