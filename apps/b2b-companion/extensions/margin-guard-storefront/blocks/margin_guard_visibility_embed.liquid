{% assign hidden_handles_meta = shop.metafields["margin_guard"]["hidden_handles"].value %}
{% assign storefront_projection_meta = shop.metafields["margin_guard"]["storefront_projection"].value %}
{% comment %}
  MVP_5_4_9 — the storefront resolves the customer's CATALOG client-side (from
  audience tags + native B2B), then reads that catalog's anti-flash snapshot. No
  more binary B2B/B2C: catalogResolution maps tags→catalog and the snapshots /
  hidden handles are keyed by catalogId.
{% endcomment %}
{% assign current_b2b_tag = 'b2b' %}
{% if hidden_handles_meta and hidden_handles_meta.b2bTag %}
  {% assign current_b2b_tag = hidden_handles_meta.b2bTag | strip | downcase %}
{% elsif storefront_projection_meta and storefront_projection_meta.b2bTag %}
  {% assign current_b2b_tag = storefront_projection_meta.b2bTag | strip | downcase %}
{% endif %}

{% comment %} Resolve the customer's catalog id (highest-priority audience match; default fallback). {% endcomment %}
{% assign current_catalog_id = 'default' %}
{% if storefront_projection_meta and storefront_projection_meta.defaultCatalogId %}
  {% assign current_catalog_id = storefront_projection_meta.defaultCatalogId %}
{% elsif hidden_handles_meta and hidden_handles_meta.defaultCatalogId %}
  {% assign current_catalog_id = hidden_handles_meta.defaultCatalogId %}
{% endif %}
{% assign mg_best_priority = -999999 %}
{% if storefront_projection_meta and storefront_projection_meta.catalogResolution %}
  {% for entry in storefront_projection_meta.catalogResolution %}
    {% unless entry.isDefault %}
      {% assign entry_matches = false %}
      {% if entry.matchCompany and customer and customer.b2b? %}
        {% assign entry_matches = true %}
      {% endif %}
      {% if customer and entry.audienceTags %}
        {% for audience_tag in entry.audienceTags %}
          {% assign normalized_audience_tag = audience_tag | strip | downcase %}
          {% if normalized_audience_tag != blank and customer.tags contains normalized_audience_tag %}
            {% assign entry_matches = true %}
          {% endif %}
        {% endfor %}
      {% endif %}
      {% if entry_matches %}
        {% assign entry_priority = entry.priority | default: 0 %}
        {% if entry_priority >= mg_best_priority %}
          {% assign mg_best_priority = entry_priority %}
          {% assign current_catalog_id = entry.id %}
        {% endif %}
      {% endif %}
    {% endunless %}
  {% endfor %}
{% endif %}

{% assign hidden_handles_for_context = empty %}
{% if hidden_handles_meta and hidden_handles_meta.catalogs %}
  {% assign hidden_handles_for_context = hidden_handles_meta.catalogs[current_catalog_id] %}
{% endif %}
{% assign projection_catalog_snapshot = empty %}
{% assign hidden_collections_for_context = empty %}
{% if storefront_projection_meta and storefront_projection_meta.catalogSnapshots %}
  {% assign projection_catalog_snapshot = storefront_projection_meta.catalogSnapshots[current_catalog_id] %}
  {% if projection_catalog_snapshot and projection_catalog_snapshot.hiddenCollectionHandles %}
    {% assign hidden_collections_for_context = projection_catalog_snapshot.hiddenCollectionHandles %}
  {% endif %}
{% endif %}
{% if hidden_handles_for_context.size > 0 %}
  <style id="margin-guard-segment-default-hide">
    {% for handle in hidden_handles_for_context %}
      {% assign normalized_handle = handle | strip | downcase %}
      {% if normalized_handle != blank %}
        [data-product-card]:has(a[href*='/products/{{ normalized_handle }}']),
        .product-card:has(a[href*='/products/{{ normalized_handle }}']),
        .card:has(a[href*='/products/{{ normalized_handle }}']),
        .grid__item:has(a[href*='/products/{{ normalized_handle }}']),
        .product-item:has(a[href*='/products/{{ normalized_handle }}']),
        article:has(a[href*='/products/{{ normalized_handle }}']),
        li:has(a[href*='/products/{{ normalized_handle }}']) {
          display: none !important;
        }
      {% endif %}
    {% endfor %}
  </style>
{% endif %}
{% if hidden_collections_for_context.size > 0 %}
  <style id="margin-guard-collection-default-hide">
    {% for handle in hidden_collections_for_context %}
      {% assign normalized_collection_handle = handle | strip | downcase %}
      {% if normalized_collection_handle != blank %}
        [data-collection-card]:has(a[href*='/collections/{{ normalized_collection_handle }}']),
        .collection-card:has(a[href*='/collections/{{ normalized_collection_handle }}']),
        .collection-list__item:has(a[href*='/collections/{{ normalized_collection_handle }}']),
        .card:has(a[href*='/collections/{{ normalized_collection_handle }}']),
        .grid__item:has(a[href*='/collections/{{ normalized_collection_handle }}']),
        article:has(a[href*='/collections/{{ normalized_collection_handle }}']),
        li:has(a[href*='/collections/{{ normalized_collection_handle }}']) {
          display: none !important;
        }
      {% endif %}
    {% endfor %}
  </style>
{% endif %}
{% if storefront_projection_meta %}
  <script id="margin-guard-storefront-bootstrap" type="application/json">
    {
      "schemaVersion": {{ storefront_projection_meta.schemaVersion | default: 0 | json }},
      "configUpdatedAt": {{ storefront_projection_meta.configUpdatedAt | json }},
      "generatedAt": {{ storefront_projection_meta.generatedAt | json }},
      "b2bTag": {{ storefront_projection_meta.b2bTag | default: current_b2b_tag | json }},
      "allowRemoveAtMinimumOrderQuantity": {{ storefront_projection_meta.allowRemoveAtMinimumOrderQuantity | default: true | json }},
      "coverage": {{ storefront_projection_meta.coverage | default: empty | json }},
      "messages": {{ storefront_projection_meta.messages | default: empty | json }},
      "pricingPreview": {{ storefront_projection_meta.pricingPreview | default: empty | json }},
      "catalogId": {{ current_catalog_id | json }},
      "snapshot": {{ projection_catalog_snapshot | default: empty | json }}
    }
  </script>
{% endif %}
<script>
(function(){
  try {
    {% if storefront_projection_meta.debug %}
    console.log("[MarginGuard] embed bootstrap", {
      customerId: {% if customer %}{{ customer.id | json }}{% else %}null{% endif %},
      customerTags: {% if customer %}{{ customer.tags | json }}{% else %}[]{% endif %},
      currentB2bTag: {{ current_b2b_tag | default: 'b2b' | json }},
      currentCatalogId: {{ current_catalog_id | json }},
      usesNativeB2B: {% if customer and customer.b2b? %}true{% else %}false{% endif %},
      hiddenHandlesForContext: {{ hidden_handles_for_context | default: empty | json }},
      hiddenCollectionHandlesForContext: {{ hidden_collections_for_context | default: empty | json }},
      hiddenHandlesMeta: {{ hidden_handles_meta | default: empty | json }},
      storefrontProjectionMeta: {{ storefront_projection_meta | default: empty | json }}
    });
    {% endif %}
    var raw = sessionStorage.getItem("marginGuardRulesCache_v1");
    if (!raw) return;
    var parsed = JSON.parse(raw);
    if (!parsed || typeof parsed !== "object") return;
    var fetchedAt = Number(parsed.fetchedAt);
    if (!isFinite(fetchedAt) || Date.now() - fetchedAt > 300000) return;
    var handles = parsed.hiddenHandles;
    if (!Array.isArray(handles) || !handles.length) return;
    var css = "";
    for (var i = 0; i < handles.length; i++) {
      var h = handles[i];
      if (!h) continue;
      css += "[data-product-card]:has(a[href*='/products/" + h + "']),"
        + ".product-card:has(a[href*='/products/" + h + "']),"
        + ".card:has(a[href*='/products/" + h + "']),"
        + ".grid__item:has(a[href*='/products/" + h + "']),"
        + ".product-item:has(a[href*='/products/" + h + "']),"
        + "article:has(a[href*='/products/" + h + "']),"
        + "li:has(a[href*='/products/" + h + "'])"
        + "{ display: none !important; }\n";
    }
    if (css) {
      var style = document.createElement("style");
      style.id = "margin-guard-early-hide";
      style.textContent = css;
      document.head.appendChild(style);
      {% if storefront_projection_meta.debug %}
      console.log("[MarginGuard] early-hide cache applied", {
        hiddenHandles: handles,
        styleId: "margin-guard-early-hide"
      });
      {% endif %}
    }
  } catch(e) {}
})();
</script>
{% # theme-check-disable RemoteAsset %}
{%- comment -%}
  The visibility script is a dynamic, per-customer app-proxy endpoint (it passes
  the logged-in customer id + tags), so it cannot be served via an asset_url
  filter (those are for static theme assets) — RemoteAsset is intentional here.
  `defer` keeps it from blocking the parser: first-paint anti-flash is handled by
  the inline <style>/<script> above (from the shop metafields), and this script
  only does the live, customer-specific refinement once the DOM is parsed.
{%- endcomment -%}
<script
  src="/apps/margin-guard/visibility-script{% if customer %}?logged_in_customer_id={{ customer.id }}&logged_in_customer_tags={{ customer.tags | json | url_encode }}{% endif %}"
  data-margin-guard-visibility-script
  defer
></script>
{% # theme-check-enable RemoteAsset %}

{% schema %}
{
  "name": "Margin Guard Visibility",
  "target": "head",
  "settings": []
}
{% endschema %}
