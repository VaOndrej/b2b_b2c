{
  "name": "won-discounts",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19 <22 || >=22.12"
  },
  "scripts": {
    "prebuild": "prisma generate",
    "build": "react-router build",
    "build:all": "npm run build:functions && npm run build",
    "build:functions": "PATH=\"$HOME/.cargo/bin:$PATH\" shopify app function build --path extensions/won-discounts-engine",
    "dev": "PATH=\"$HOME/.cargo/bin:$PATH\" shopify app dev --path .",
    "prisma:generate": "prisma generate",
    "prisma:migrate:deploy": "node ./scripts/ensure-sqlite-db.mjs && prisma migrate deploy",
    "setup": "npm run prisma:generate && npm run prisma:migrate:deploy",
    "start": "react-router-serve ./build/server/index.js",
    "config:link": "shopify app config link --path .",
    "pretypecheck": "prisma generate",
    "typecheck": "react-router typegen && tsc --noEmit",
    "lint": "eslint --ignore-path .gitignore --cache --cache-location ./node_modules/.cache/eslint .",
    "docs:gen": "tsx scripts/gen-docs.ts && tsx scripts/gen-docs-index.ts && tsx scripts/export-docs.ts",
    "docs:export": "tsx scripts/export-docs.ts",
    "test:unit": "node ./scripts/run-unit-tests.mjs",
    "test:postgres": "node ./scripts/test-postgres.mjs",
    "test:unit:node": "tsx --test 'tests/**/*.test.ts'",
    "test:e2e": "node ./scripts/require-e2e-contract.mjs",
    "test:e2e:preview": "playwright test --config=playwright.preview.config.ts",
    "test:e2e:local:all": "node ./scripts/make-e2e-overlay.mjs --check && node ./scripts/require-e2e-contract.mjs --local-matrix"
  },
  "dependencies": {
    "@prisma/client": "^6.16.3",
    "@react-router/dev": "^7.12.0",
    "@react-router/fs-routes": "^7.12.0",
    "@react-router/node": "^7.12.0",
    "@react-router/serve": "^7.12.0",
    "@shopify/app-bridge-react": "^4.2.4",
    "@shopify/shopify-app-react-router": "^1.1.0",
    "@shopify/shopify-app-session-storage-prisma": "^8.0.0",
    "@won/app-kit": "*",
    "@won/core": "*",
    "@won/testing": "*",
    "isbot": "^5.1.31",
    "prisma": "^6.16.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^7.12.0",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "devDependencies": {
    "@shopify/polaris-types": "^1.0.1",
    "@types/node": "^22.18.8",
    "@types/react": "^18.3.25",
    "@types/react-dom": "^18.3.7",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "vite": "^6.3.6"
  },
  "author": "Ondy"
}
