// Minimal schema for a new app: only the Session model required by Shopify's
// Prisma session storage. Add your own models below.
//
// Every standalone app owns its generated Prisma client. Never point a second
// schema at the hoisted @prisma/client output: generating one app would then
// overwrite the runtime expected by another app in this monorepo.
generator client {
  provider     = "prisma-client"
  output       = "../app/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)

  refreshToken        String?
  refreshTokenExpires DateTime?

  /// Won: the admin language (`cs` | `en`) Shopify passed as `?locale=` on the
  /// last embedded document load of this session. Client-side fetches carry no
  /// `?locale=`, and an offline session has no user locale, so loaders read it
  /// from here (app/lib/integration/locale.server.ts). The session library
  /// never writes this column, so a token refresh keeps it.
  adminLocale         String?
}

// Won Discounts config persistence (spec §2, doctrine DATA-2/DATA-3/DATA-4).
// The shape stored in `data` is validated only by @won/core/discounts/config —
// this schema just stores the sanitized JSON, keyed by shop.
model ShopConfig {
  shop          String   @id
  schemaVersion Int
  data          String
  updatedAt     DateTime @updatedAt
}

// Append-only history of every saved config, for support/rollback. Pruned to
// CONFIG_HISTORY_RETENTION_DAYS by app/lib/config.server.ts.
model ConfigVersion {
  id            String   @id @default(cuid())
  shop          String
  schemaVersion Int
  data          String
  createdAt     DateTime @default(now())

  @@index([shop, createdAt])
}

/// Won discount nodes the sync layer owns in Shopify (1 automatic + 1 per code rule).
model WonNode {
  id             String   @id @default(cuid())
  shop           String
  key            String   // "auto" | "code:<ruleId>"
  role           String   // "automatic" | "code"
  ruleId         String?
  discountNodeId String   // Shopify GID
  codesHash      String?
  varsVersion    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  @@unique([shop, key])
  @@index([shop])
}

/// Raw snapshot of a native Shopify discount taken before moving it into Won (undo, A7).
///
/// Claim guard (migration 20260928184219_sync_version_link_claim_guard): a
/// PARTIAL unique index allows at most one live claim — status `moving` or
/// `undoing` — per shop + nativeId, across every app instance:
///   CREATE UNIQUE INDEX "NativeDiscountBackup_one_claim_per_native"
///     ON "NativeDiscountBackup"("shop", "nativeId") WHERE "status" IN ('moving', 'undoing');
/// Prisma's schema language cannot express a partial index, so it lives only in
/// the migration SQL (migrate diff ignores it; tests/integration/claim-guard.test.ts
/// pins it). app/lib/native/move.server.ts treats its violation (P2002) as
/// "already claimed".
model NativeDiscountBackup {
  id        String   @id @default(cuid())
  shop      String
  nativeId  String   // original Shopify GID
  kind      String   // human-readable type key from detection, e.g. "code_basic"
  title     String
  snapshot  String   // JSON of the native discount as read before deletion
  wonRuleId String?
  status    String   // "backed_up" | "moved" | "restored" | "failed"
  error     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([shop, status])
}

/// Result of the last sync runs for the Přehled status (bounded, pruned to last 20 per shop).
model SyncRun {
  id         String   @id @default(cuid())
  shop       String
  startedAt  DateTime @default(now())
  finishedAt DateTime?
  ok         Boolean  @default(false)
  steps      String   // JSON array of {step, ok, detail}
  errorCount Int      @default(0)
  /// JSON array of work the run left for the next one (e.g. "campaign_switch_held"); null/[] = none.
  pending    String?
  /// The ConfigVersion this run synced (a save: the version it saved; a resync:
  /// the stored config's version). "Běží" compares it with the current version.
  /// Null = unknown (runs before this column, or the version was pruned).
  configVersionId String?
  @@index([shop, startedAt])
}

/// Per-shop sync bookkeeping (F2, app/lib/sync/sync-state.server.ts): what the
/// last sync ran against and what is known to be stale. One row per shop,
/// erased with the shop (shop/redact).
model ShopSyncState {
  shop               String    @id
  /// Shop IANA zone the last sync built the payload with. A different zone on
  /// Přehled → resync (rule days are shop days).
  timezone           String?
  /// When the product-targeting step last finished without errors (Přehled
  /// refreshes the targeting when this is older than 24 h).
  productsSyncedAt   DateTime?
  /// Set by products/collections webhooks: collection membership (or a targeted
  /// product) changed since the last product sync; cleared by a product sync
  /// that started after it.
  targetingStaleAt   DateTime?
  /// What made it stale (topic + resource id), short, for support.
  targetingStaleNote String?
  /// When Přehled last compared Shopify market countries with the config.
  marketsCheckedAt   DateTime?
  /// The plan ("free" | "pro") the shop function config LIVE in Shopify was
  /// built for (BILL-1, F2 re-review I-2): another plan now → resync; until
  /// then the admin says checkout still runs the older settings. Null = not
  /// recorded (a config written before this column: see sync/runs.ts).
  appliedPlan        String?
  /// Margin protection (MVP 2) cost mirror (app/lib/sync/costs.ts): when the
  /// last FULL pass that finished without errors STARTED. Older than 24 h (or
  /// null) → the Přehled and the daily reconcile run a new pass.
  costsScannedAt     DateTime?
  /// Resume point of an unfinished full pass: the productVariants endCursor of
  /// the last page it finished (a pass cancelled by a newer one, or cut short
  /// by a restart, continues here). Null = no pass to resume.
  costsCursor        String?
  /// JSON of the pass under way or the last one that failed, for the admin
  /// ("propisujeme nákupní ceny N z M"): {token, since, done, total,
  /// failedAt?, error?}. Null = nothing pending.
  costsPending       String?
  updatedAt          DateTime  @updatedAt
}

/// Products that carry the sync's $app:won_discounts/product metafield (sync
/// bookkeeping in the app DB, DATA-1). payloadHash = hash of the value last
/// written; null = a write is in flight (write-ahead: the row exists BEFORE the
/// metafield is written, so a crash never leaves an untracked metafield).
model ProductTargetIndex {
  id          String   @id @default(cuid())
  shop        String
  productId   String   // Shopify product GID
  payloadHash String?
  /// The value last written (productMetafieldValue JSON: ruleIds,
  /// variantRuleIds, marginRefs). The margin impact overview (Pro) reads the
  /// refs from here instead of re-reading collection membership. Null = not
  /// recorded yet (a row from before MVP 2; the next product pass fills it).
  value       String?
  updatedAt   DateTime @updatedAt
  @@unique([shop, productId])
  @@index([shop])
}

/// Cost mirror (margin protection, MVP 2, app/lib/sync/costs.ts): one row per
/// variant of the shop, as the last pass / webhook read it from Shopify, and
/// the `$app:won_discounts/variant` metafield value the sync last wrote for it
/// ({"cost": n, "cur": "USD"}; null = the variant carries no such metafield).
/// Source of the admin's counts ("N produktů nemá nákupní cenu"), the impact
/// overview and Vyzkoušet košík. Only kept while margin protection is on;
/// deleted on uninstall and shop/redact.
model VariantCost {
  id              String   @id @default(cuid())
  shop            String
  variantId       String   // Shopify ProductVariant GID
  productId       String   // Shopify Product GID
  inventoryItemId String   // Shopify InventoryItem GID (inventory_items/update webhooks name it)
  /// Product title and variant title (null = "Default Title"), for the admin lists.
  title           String?
  variantTitle    String?
  /// Variant price, decimal string in the shop currency.
  price           String
  /// inventoryItem.unitCost (decimal string + currency); null = no cost in Shopify.
  cost            String?
  currency        String?
  metafieldValue  String?
  /// The full pass that last saw this variant (rows no pass saw are re-checked, then dropped).
  scanId          String?
  updatedAt       DateTime @updatedAt
  @@unique([shop, variantId])
  @@index([shop, inventoryItemId])
  @@index([shop, productId])
}
