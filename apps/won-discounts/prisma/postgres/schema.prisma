  /// JSON string[]: the price lists (GIDs) whose fixed price the merchant picked.
  priceListIds  String    @default("[]")
  /// "starting" | "active" | "ending" | "ended"
  status        String
  /// "quota" | "date" | "manual" | null
  endReason     String?
  sold          Int       @default(0)
  returned      Int       @default(0)
  /// Pieces returned after the end that wait for the merchant's decision (reopenOnReturnAfterEnd = ask).
  returnPending Int       @default(0)
  /// JSON {currency, variant: {price, compareAt}, lists: [{id, currency, price, compareAt}]} — minor units.
  backup        String?
  /// JSON, same shape: what the start wrote.
