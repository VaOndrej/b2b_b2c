  /// variantRuleIds, marginRefs). The margin impact overview (Pro) reads the
  /// refs from here instead of re-reading collection membership. Null = not
  /// recorded yet (a row from before MVP 2; the next product pass fills it).
  value       String?
  updatedAt   DateTime @updatedAt
  @@unique([shop, productId])
  @@index([shop])
}

/// Cost mirror (margin protection, MVP 2, app/lib/sync/costs.ts): one row per
/// variant of the shop, as the last pass / webhook read it from Shopify, and
/// the `$app:won_discounts/variant` metafield value Shopify CONFIRMED it holds
/// ({"cost": n, "cur": "USD"}; null = none, or not confirmed). Source of the
/// admin's counts ("N produktů nemá nákupní cenu"), the impact overview and
/// Vyzkoušet košík (those two read only confirmed values). Only kept while
/// margin protection is on; on uninstall only the cost-free `mayCarry`
/// markers stay (a later switch-off still clears them), shop/redact erases all.
model VariantCost {
  id              String   @id @default(cuid())
  shop            String
  variantId       String   // Shopify ProductVariant GID
  productId       String   // Shopify Product GID
  inventoryItemId String   // Shopify InventoryItem GID (inventory_items/update webhooks name it)
  /// Product title and variant title (null = "Default Title"), for the admin lists.
  title           String?
  variantTitle    String?
  /// Variant price, decimal string in the shop currency.
  price           String
  /// inventoryItem.unitCost (decimal string + currency) when it is usable (a
  /// number > 0 with an ISO currency); null = no usable cost in Shopify.
  cost            String?
  currency        String?
  /// Confirmed value only: what Shopify was read to hold, or what a write Shopify accepted set.
  metafieldValue  String?
  /// Write-ahead marker: the variant MAY carry the sync's metafield (set before
  /// a write goes out, cleared when Shopify is read without it or a delete is
  /// confirmed). The switch-off clear deletes every such variant's metafield.
  mayCarry        Boolean  @default(false)
  /// The last write Shopify refused for this variant (userErrors). Null = none.
  writeError      String?
  /// When the refusal was last acted on: the refused write, then each retry
  /// attempt (set before the retry goes out, so a retry that fails before
  /// touching the row is not re-queued until the back-off passes again).
  /// Shown in the mirror status as the time of the last failed attempt.
  writeFailedAt   DateTime?
  /// The full pass that last saw this variant (rows no pass saw are re-checked, then dropped).
  scanId          String?
  updatedAt       DateTime @updatedAt
  @@unique([shop, variantId])
  @@index([shop, inventoryItemId])
  @@index([shop, productId])
}

/// Výprodej (MVP 5, contracts O1–O7, app/lib/integration/outlet.server.ts): one sale on an existing
/// variant. `backup` is written BEFORE the first price write (write-ahead, §14c) and is what the end
/// restores; `sale` is what the start wrote (the end restores only fields that still hold it, O5).
/// At most one run not `ended` per variant (checked in the start's transaction). Erased with the shop.
model OutletRun {
  id            String    @id @default(cuid())
