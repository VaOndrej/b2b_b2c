  error         String?
  attempts      Int       @default(0)
  nextAttemptAt DateTime?
  createdAt     DateTime  @default(now())
  startedAt     DateTime?
  endedAt       DateTime?
  updatedAt     DateTime  @updatedAt
  @@index([shop, status])
  @@index([shop, variantId])
}

/// History of a sale's steps (O1): started, sale, cancel, refund, quota_reached, ended, price_restored,
/// price_kept, price_list_skipped, return_after_end, reopened, oversold, start_failed, end_failed.
/// `key` makes every webhook step idempotent (WBH-2): `sale:<orderId>:<lineItemId>`,
/// `cancel:<orderId>:<lineItemId>`, `refund:<refundId>:<refundLineItemId>`. No PII: numeric order ids only.
/// Pruned 400 days after the run ended (scheduler `history.prune`).
model OutletEvent {
  id      String   @id @default(cuid())
  shop    String
  runId   String
  kind    String
  qty     Int      @default(0)
  orderId String?
  /// The order line this step counts for (sale / cancel / refund): numeric line item id.
  lineId  String?
  key     String
  detail  String?
  at      DateTime @default(now())
  @@unique([shop, key])
  @@index([shop, runId, at])
}

