{% comment %}
  Campaign banner (feedback 2 bod 7): the name of the campaign that runs right now and a countdown to its end,
  for any section of any template. The storefront config lists the campaigns with their start and end (`camps`,
  epoch seconds); pages are cached, so WHICH one runs is decided in the browser (assets/won-discounts-blocks.js)
  and the block stays hidden when none does. In the theme editor it shows a sample instead.
{% endcomment %}
{%- liquid
  assign won_camps = app.metafields.won_discounts.storefront_config.value.camps
  assign won_ends = 'campaign.ends' | t
  assign won_units = 'campaign.units' | t
  assign won_sample = 'campaign.sample' | t
-%}
{%- if won_camps != blank or request.design_mode -%}
  <div
    class="won-campaign won-campaign--{{ block.settings.align }}"
    data-won-discounts-campaign
    data-text="{{ block.settings.text | escape }}"
    data-countdown="{{ block.settings.show_countdown }}"
    data-ends="{{ won_ends | escape }}"
    data-units="{{ won_units | escape }}"
    {% if request.design_mode %}data-sample="{{ won_sample | escape }}"{% endif %}
    hidden
    {{ block.shopify_attributes }}
  >
    <script type="application/json">{% if won_camps != blank %}{{ won_camps | json | replace: '</', '<\/' }}{% else %}[]{% endif %}</script>
    <p class="won-campaign__title"></p>
    <p class="won-campaign__time" aria-live="off"></p>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Campaign banner",
  "target": "section",
  "stylesheet": "won-discounts.css",
  "javascript": "won-discounts-blocks.js",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "info": "{name} is replaced with the campaign's name.",
      "default": "{name}"
    },
    { "type": "checkbox", "id": "show_countdown", "label": "Countdown to the end", "default": true },
    {
      "type": "select",
      "id": "align",
      "label": "Alignment",
      "default": "center",
      "options": [
        { "value": "start", "label": "Start" },
        { "value": "center", "label": "Center" }
      ]
    }
  ]
}
{% endschema %}
