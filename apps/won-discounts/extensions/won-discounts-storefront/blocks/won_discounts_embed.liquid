{% comment %}
  App embed for Won Discounts. MVP 0: the root marker (rendered "loading";
  won-discounts.js sets "ready", so "ready" proves the script ran) and the
  storefront config (contract K5: the app-data metafield, plain namespace,
  never $app). MVP 4 (contract R7/R8): when the config offers rewards, the cart
  panel's data — the rewards, each gift variant's title and availability
  (all_products[handle]: at most 20 handles a page, F-R2), the cart currency's
  minor digits, the texts, the app proxy path — and won-discounts-cart.js.
  The embed never changes the cart by itself (SF-1): the cart script writes
  only in answer to the customer. Notes: extensions/won-discounts-storefront/README.md
{% endcomment %}

{% liquid
  assign won_discounts_config_raw = app.metafields.won_discounts.storefront_config.value
  if won_discounts_config_raw == blank
    assign won_discounts_config = '{}'
  else
    assign won_discounts_config = won_discounts_config_raw | json
  endif
  assign rw = won_discounts_config_raw.rewards
  # The merchant's texts in the page's language: that language's own metafield (tx_<locale>).
  assign won_tx_key = 'tx_' | append: request.locale.iso_code | downcase
  assign won_tx = app.metafields.won_discounts[won_tx_key].value
  assign cur = cart.currency.iso_code
  assign exp = 2
  assign exp0 = 'BIF,CLP,DJF,GNF,ISK,JPY,KMF,KRW,PYG,RWF,UGX,VND,VUV,XAF,XOF,XPF' | split: ','
  assign exp3 = 'BHD,IQD,JOD,KWD,LYD,OMR,TND' | split: ','
  if exp0 contains cur
    assign exp = 0
  elsif exp3 contains cur
    assign exp = 3
  endif
  if routes.root_url == '/'
    assign proxy = '/apps/won-discounts/cart-plan'
  else
    assign proxy = routes.root_url | append: '/apps/won-discounts/cart-plan'
  endif
%}

<div
  id="won-discounts-root"
  data-won-discounts-embed
  data-won-discounts-status="loading"
  data-won-discounts-currency="{{ cart.currency.iso_code }}"
  hidden
></div>
<script type="application/json" id="won-discounts-config">{{ won_discounts_config }}</script>
{%- comment -%}
  MVP 7 (contract M7, SEC-3): the Pro custom look. The storefront config carries the stylesheet READY — its
  variables on the Won block roots and the merchant's CSS scoped under them by the app (core customLookCss; it
  refuses "<", url(, @import, …), so this text cannot end the element or load anything.
{%- endcomment -%}
{%- if won_discounts_config_raw.appearance.css != blank -%}
  <style id="won-discounts-custom">{{ won_discounts_config_raw.appearance.css }}</style>
{%- endif -%}
{%- comment -%}
  MVP 7 BETA (contract M8): prices by quantity on product cards, for themes whose card takes no app block. On a
  collection or search page the embed prints {handle: text} for the page's products (at most the first 50 the
  page object lists; what a card may say: snippets/won-card-tier.liquid) and assets/won-discounts-cards.js places
  each text under its card's price. A product the page did not list gets nothing.
{%- endcomment -%}
{%- if won_discounts_config_raw.cards == 1 -%}
  {%- liquid
    assign won_list = nil
    if template.name == 'collection'
      assign won_list = collection.products
    elsif template.name == 'search'
      assign won_list = search.results
    endif
    assign won_lang = request.locale.iso_code | slice: 0, 2 | downcase
    assign won_langs = 'cs,sk,en' | split: ','
    unless won_langs contains won_lang
      assign won_lang = 'en'
    endunless
  -%}
  {%- if won_list != nil -%}
    {%- capture won_cards -%}
      {%- assign won_sep = '' -%}
      {%- for won_p in won_list limit: 50 -%}
        {%- if won_p.variants != nil -%}
          {%- capture won_label -%}{%- render 'won-card-tier', p: won_p, cfg: won_discounts_config_raw, cur: cur, lang: won_lang, tx: won_tx -%}{%- endcapture -%}
          {%- comment -%} Shopify wraps an app snippet's output in HTML comments ("BEGIN / END app snippet"): keep the text between them. The text is marked first: `split` drops a trailing empty string, and a snippet that said nothing would leave the opening comment as the label. {%- endcomment -%}
          {%- assign won_label = won_label | split: '<!-- END' | first | append: '¦' | split: '-->' | last | remove: '¦' | strip -%}
          {%- if won_label != blank -%}
            {{- won_sep -}}{{ won_p.handle | json }}:{{ won_label | json }}
            {%- assign won_sep = ',' -%}
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endcapture -%}
    {%- if won_cards != blank -%}
      <script type="application/json" id="won-discounts-cards">{ {{- won_cards | replace: '</', '<\/' -}} }</script>
      <script src="{{ 'won-discounts-cards.js' | asset_url }}" defer></script>
    {%- endif -%}
  {%- endif -%}
{%- endif -%}

{%- if rw != blank -%}
  {%- capture won_gift_facts -%}
    {%- assign sep = '' -%}
    {%- for g in rw.gifts -%}
      {%- for o in g.c -%}
        {%- assign gp = all_products[o.h] -%}
        {%- for gv in gp.variants -%}
          {%- if gv.id == o.v -%}
            {%- liquid
              assign title = gp.title
              unless gv.title == 'Default Title'
                assign title = title | append: ' — ' | append: gv.title
              endunless
            -%}
            {{- sep -}}"{{ o.v }}":{"t":{{ title | json }},"a":{{ gv.available }}}
            {%- assign sep = ',' -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endfor -%}
      {%- if g.f != blank -%}
        {%- assign gp = all_products[g.f.h] -%}
        {%- for gv in gp.variants -%}
          {%- if gv.id == g.f.v -%}
            {{- sep -}}"{{ g.f.v }}":{"t":{{ gp.title | json }},"a":{{ gv.available }}}
            {%- assign sep = ',' -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endcapture -%}
  {%- capture won_cart_data -%}
    {"on":true,"rw":{{ rw | json }},"mk":{{ cur | append: '@' | append: localization.market.handle | json }},"exp":{{ exp }},"lang":{{ request.locale.iso_code | json }},"proxy":{{ proxy | json }},"g":{ {{- won_gift_facts -}} },"tx":{
    {%- assign won_d = 'cart.ms_left' | t -%}"ms_left":{{ won_tx['cart.ms_left'] | default: won_d | json }},
    {%- assign won_d = 'cart.ms_done' | t -%}"ms_done":{{ won_tx['cart.ms_done'] | default: won_d | json }},
    {%- assign won_d = 'cart.ms_from' | t -%}"ms_from":{{ won_tx['cart.ms_from'] | default: won_d | json }},
    {%- assign won_d = 'cart.ms_ship' | t -%}"ms_ship":{{ won_tx['cart.ms_ship'] | default: won_d | json }},
    {%- assign won_d = 'cart.ms_gift' | t -%}"ms_gift":{{ won_tx['cart.ms_gift'] | default: won_d | json }},
    {%- assign won_d = 'cart.ms_gift_named' | t -%}"ms_gift_named":{{ won_tx['cart.ms_gift_named'] | default: won_d | json }},
    {%- assign won_d = 'cart.ms_disc' | t -%}"ms_disc":{{ won_tx['cart.ms_disc'] | default: won_d | json }},
    {%- assign won_d = 'cart.gift_done' | t -%}"gift_done":{{ won_tx['cart.gift_done'] | default: won_d | json }},
    {%- assign won_d = 'cart.gift_decline' | t -%}"gift_decline":{{ won_tx['cart.gift_decline'] | default: won_d | json }},
    {%- assign won_d = 'cart.gift_declined' | t -%}"gift_declined":{{ won_tx['cart.gift_declined'] | default: won_d | json }},
    {%- assign won_d = 'cart.gift_pick' | t -%}"gift_pick":{{ won_tx['cart.gift_pick'] | default: won_d | json }},
    {%- assign won_d = 'cart.gift_add' | t -%}"gift_add":{{ won_tx['cart.gift_add'] | default: won_d | json }},
    {%- assign won_d = 'cart.gift_soldout' | t -%}"gift_soldout":{{ won_tx['cart.gift_soldout'] | default: won_d | json }},
    {%- assign won_d = 'cart.code_label' | t -%}"code_label":{{ won_tx['cart.code_label'] | default: won_d | json }},
    {%- assign won_d = 'cart.code_apply' | t -%}"code_apply":{{ won_tx['cart.code_apply'] | default: won_d | json }},
    {%- assign won_d = 'cart.code_remove' | t -%}"code_remove":{{ won_tx['cart.code_remove'] | default: won_d | json }},
    {%- assign won_d = 'cart.code_invalid' | t -%}"code_invalid":{{ won_tx['cart.code_invalid'] | default: won_d | json }},
    {%- assign won_d = 'cart.code_loses_gift' | t -%}"code_loses_gift":{{ won_tx['cart.code_loses_gift'] | default: won_d | json }},
    {%- assign won_d = 'cart.keep_code' | t -%}"keep_code":{{ won_tx['cart.keep_code'] | default: won_d | json }},
    {%- assign won_d = 'cart.drop_code' | t -%}"drop_code":{{ won_tx['cart.drop_code'] | default: won_d | json }},
    {%- assign won_d = 'cart.saved' | t -%}"saved":{{ won_tx['cart.saved'] | default: won_d | json }},
    {%- assign won_d = 'cart.hint' | t -%}"hint":{{ won_tx['cart.hint'] | default: won_d | json }},
    {%- assign won_d = 'cart.hint_capped' | t -%}"hint_capped":{{ won_tx['cart.hint_capped'] | default: won_d | json }},
    "n":{ {%- assign won_sep = '' -%}
      {%- for won_step in rw.disc -%}
        {%- assign won_name_key = 'cart.ms_name.' | append: won_step.id -%}
        {%- if won_tx[won_name_key] != blank -%}{{ won_sep }}{{ won_step.id | json }}:{{ won_tx[won_name_key] | json }}{%- assign won_sep = ',' -%}{%- endif -%}
      {%- endfor -%} }}}
  {%- endcapture -%}
  <script type="application/json" id="won-discounts-cart-data">{{ won_cart_data | replace: '</', '<\/' }}</script>
  <script src="{{ 'won-discounts-cart.js' | asset_url }}" defer></script>
{%- endif -%}

{%- comment -%}
  Feedback 2 (2026-10-06, body 5 a 7): the top bar. The theme's announcement bar takes no app block, so the embed
  offers its own strip: the Milestones ladder (one sentence and a thin track) and / or the running campaign. It is printed here and moved to the top
  of <body> by assets/won-discounts-blocks.js, which also hides it while it has nothing to say.
{%- endcomment -%}
{%- if block.settings.top_bar_rewards or block.settings.top_bar_campaign -%}
  {%- liquid
    assign won_camps = won_discounts_config_raw.camps
    assign won_ends = 'campaign.ends' | t
    assign won_ends = won_tx['campaign.ends'] | default: won_ends
    assign won_units = 'campaign.units' | t
    assign won_units = won_tx['campaign.units'] | default: won_units
  -%}
  <div
    class="won-topbar"
    data-won-discounts-topbar
    style="--won-topbar-bg: {{ block.settings.top_bar_bg }}; --won-topbar-text: {{ block.settings.top_bar_text }};"
    hidden
  >
    {%- if block.settings.top_bar_campaign and won_camps != blank -%}
      <div class="won-campaign" data-won-discounts-campaign data-text="{name}" data-ends="{{ won_ends | escape }}" data-units="{{ won_units | escape }}" hidden>
        <script type="application/json">{{ won_camps | json | replace: '</', '<\/' }}</script>
        <p class="won-campaign__title"></p>
        <p class="won-campaign__time" aria-live="off"></p>
      </div>
    {%- endif -%}
    {%- if block.settings.top_bar_rewards and rw != blank -%}
      <div class="won-progress" data-won-discounts-progress data-size="bar">
        {%- render 'won-milestones', rw: rw, cur: cur, size: 'bar', tx: won_tx -%}
      </div>
    {%- endif -%}
  </div>
  <script src="{{ 'won-discounts-blocks.js' | asset_url }}" defer></script>
{%- endif -%}

{% schema %}
{
  "name": "Won Discounts",
  "target": "body",
  "stylesheet": "won-discounts.css",
  "javascript": "won-discounts.js",
  "settings": [
    { "type": "header", "content": "Top bar" },
    { "type": "checkbox", "id": "top_bar_rewards", "label": "Show reward progress at the top of the store", "default": false },
    { "type": "checkbox", "id": "top_bar_campaign", "label": "Show the running campaign at the top of the store", "default": false },
    { "type": "color", "id": "top_bar_bg", "label": "Top bar background", "default": "#111111" },
    { "type": "color", "id": "top_bar_text", "label": "Top bar text", "default": "#ffffff" }
  ]
}
{% endschema %}
