{% comment %}
  App embed for Won Discounts (MVP0). This block only proves the storefront
  foundation loads: it renders a hidden root marker and an inline JSON config
  script tag, then loads the storefront JS with `defer`. It applies no
  discount and mutates no cart — later MVPs build the actual discount UI on
  top of this foundation. See doctrine SF-1 (no cart mutation from the
  embed) and SF-2 (storefront JS gzip budget).
{% endcomment %}

{% liquid
  assign won_discounts_config_raw = app.metafields['$app:won_discounts'].storefront_config.value
  if won_discounts_config_raw == blank
    assign won_discounts_config = '{}'
  else
    assign won_discounts_config = won_discounts_config_raw | json
  endif
%}

<div
  id="won-discounts-root"
  data-won-discounts-embed
  data-won-discounts-status="ready"
  data-won-discounts-currency="{{ cart.currency.iso_code }}"
  hidden
></div>
<script type="application/json" id="won-discounts-config">{{ won_discounts_config }}</script>

{% schema %}
{
  "name": "t:blocks.won_discounts.name",
  "target": "body",
  "stylesheet": "won-discounts.css",
  "javascript": "won-discounts.js",
  "settings": []
}
{% endschema %}
