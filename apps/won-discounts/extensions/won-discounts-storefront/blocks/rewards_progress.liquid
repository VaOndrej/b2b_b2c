{% comment %}
  Milestones (feedback 2026-10-06, bod 10; before: "Rewards progress"): the ladder of steps by cart value — free
  shipping, free gifts, discounts off the order — for any section of any template (the product page, the home
  page, an Apps section under the header), in the size the merchant picks. The ladder is rendered here from the
  cart; assets/won-discounts-blocks.js redraws it when the cart changes. Renders nothing when the shop offers no
  step in the cart's currency (in the theme editor it says so instead of leaving a gap).
{% endcomment %}
{%- liquid
  assign won_rw = app.metafields.won_discounts.storefront_config.value.rewards
  assign won_cur = cart.currency.iso_code
  assign won_tx_key = 'tx_' | append: request.locale.iso_code | downcase
  assign won_tx = app.metafields.won_discounts[won_tx_key].value
-%}
{%- capture won_rows -%}
  {%- if won_rw != blank -%}
    {%- render 'won-milestones', rw: won_rw, cur: won_cur, size: block.settings.size, tx: won_tx -%}
  {%- endif -%}
{%- endcapture -%}
{%- assign won_rows = won_rows | strip -%}
{%- if won_rows contains 'won-ms' -%}
  <div
    class="won-progress won-progress--{{ block.settings.align }}"
    data-won-discounts-progress
    data-size="{{ block.settings.size }}"
    {{ block.shopify_attributes }}
  >
    {{ won_rows }}
  </div>
{%- elsif request.design_mode -%}
  <p class="won-progress won-progress--{{ block.settings.align }}" {{ block.shopify_attributes }}>{{ 'progress.empty' | t }}</p>
{%- endif -%}

{% schema %}
{
  "name": "Milestones",
  "target": "section",
  "stylesheet": "won-discounts.css",
  "javascript": "won-discounts-blocks.js",
  "settings": [
    {
      "type": "select",
      "id": "size",
      "label": "Size",
      "default": "compact",
      "options": [
        { "value": "bar", "label": "Strip: one sentence and a thin track" },
        { "value": "compact", "label": "Compact: a track with a mark per step" },
        { "value": "full", "label": "Full: every step with its reward" }
      ]
    },
    {
      "type": "select",
      "id": "align",
      "label": "Alignment",
      "default": "start",
      "options": [
        { "value": "start", "label": "Start" },
        { "value": "center", "label": "Center" }
      ]
    }
  ]
}
{% endschema %}
