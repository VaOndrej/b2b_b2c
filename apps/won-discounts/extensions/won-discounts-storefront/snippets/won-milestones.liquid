{%- comment -%}
  Milníky (feedback 2026-10-06, bod 10): the ladder of steps by cart value — free shipping, free gifts and
  discounts off the order — in one of three sizes:
    bar      one sentence and a thin track (the embed's top bar)
    compact  a track with a mark per step and the sentence about the next one (product page, cart drawer)
    full     every step with its reward, the reached ones ticked (cart page)
  Rendered here from the cart for the first paint; assets/won-discounts.js `ladder` draws the same markup after
  every cart change (the "Milestones" block and the top bar through won-discounts-blocks.js).
  The base is the cart's goods before discounts without gift lines (the same as won-discounts.js `base`).
  Params: rw (the storefront config's rewards), cur (cart currency), size, tx (the merchant's texts in the
  page's language, metafield tx_<locale>; a discount step's own name is tx['cart.ms_name.<id>']).
{%- endcomment -%}
{%- liquid
  assign won_base = 0
  for won_item in cart.items
    if won_item.properties['_won_gift'] == blank
      assign won_base = won_base | plus: won_item.original_line_price
    endif
  endfor
  # Amounts per market: the market's own amount ("EUR@sk") first, then its currency's.
  # A negative amount = this market is left without one (never the currency's fallback).
  assign won_mk = cur | append: '@' | append: localization.market.handle
  assign won_from = 'cart.ms_from' | t
  assign won_from = tx['cart.ms_from'] | default: won_from
  assign won_rows = ''
  assign won_n = 100

  assign won_t = rw.ship[won_mk] | default: rw.ship[cur]
  if won_t != nil and won_t > 0
    assign won_label = 'cart.ms_ship' | t
    assign won_label = tx['cart.ms_ship'] | default: won_label
    assign won_key = won_t | prepend: '000000000000000' | slice: -15, 15
    assign won_rows = won_rows | append: won_key | append: won_n | append: '¦¦s¦¦' | append: won_t | append: '¦¦' | append: won_label | append: '§§§'
  endif

  for won_g in rw.gifts
    assign won_n = won_n | plus: 1
    assign won_t = won_g.t[won_mk] | default: won_g.t[cur]
    if won_t != nil and won_t > 0
      assign won_label = 'cart.ms_gift' | t
      assign won_label = tx['cart.ms_gift'] | default: won_label
      if won_g.c.size == 1
        assign won_o = won_g.c | first
        assign won_gp = all_products[won_o.h]
        for won_gv in won_gp.variants
          if won_gv.id == won_o.v and won_gv.available
            assign won_title = won_gp.title
            unless won_gv.title == 'Default Title'
              assign won_title = won_title | append: ' — ' | append: won_gv.title
            endunless
            assign won_label = 'cart.ms_gift_named' | t
            assign won_label = tx['cart.ms_gift_named'] | default: won_label | replace: '{name}', won_title
          endif
        endfor
      endif
      assign won_key = won_t | prepend: '000000000000000' | slice: -15, 15
      assign won_rows = won_rows | append: won_key | append: won_n | append: '¦¦g¦¦' | append: won_t | append: '¦¦' | append: won_label | append: '§§§'
    endif
  endfor

  for won_d in rw.disc
    assign won_n = won_n | plus: 1
    assign won_t = won_d.t[won_mk] | default: won_d.t[cur]
    if won_t != nil and won_t > 0
      assign won_value = nil
      if won_d.pct != nil
        assign won_value = won_d.pct | append: ' %'
      else
        assign won_off = won_d.off[won_mk] | default: won_d.off[cur]
        if won_off != nil and won_off > 0
          assign won_value = won_off | money
        endif
      endif
      if won_value != nil
        assign won_label = 'cart.ms_disc' | t
        assign won_name_key = 'cart.ms_name.' | append: won_d.id
        assign won_label = tx[won_name_key] | default: tx['cart.ms_disc'] | default: won_label | replace: '{value}', won_value
        assign won_key = won_t | prepend: '000000000000000' | slice: -15, 15
        assign won_rows = won_rows | append: won_key | append: won_n | append: '¦¦d¦¦' | append: won_t | append: '¦¦' | append: won_label | append: '§§§'
      endif
    endif
  endfor

  assign won_steps = won_rows | split: '§§§' | sort
  assign won_top = 0
  assign won_next = nil
  for won_row in won_steps
    assign won_f = won_row | split: '¦¦'
    assign won_top = won_f[2] | plus: 0
    if won_next == nil and won_base < won_top
      assign won_next = won_row
    endif
  endfor
-%}
{%- if won_steps.size > 0 -%}
  {%- liquid
    if won_next == nil
      assign won_text = 'cart.ms_done' | t
      assign won_text = tx['cart.ms_done'] | default: won_text
      assign won_text = tx['cart.ms_done'] | default: won_text
      assign won_pct = 100
    else
      assign won_f = won_next | split: '¦¦'
      assign won_left = won_f[2] | minus: won_base | money
      assign won_text = 'cart.ms_left' | t
      assign won_text = tx['cart.ms_left'] | default: won_text | replace: '{amount}', won_left | replace: '{reward}', won_f[3]
      assign won_pct = won_base | times: 100.0 | divided_by: won_top | round
    endif
  -%}
  <div class="won-ms won-ms--{{ size }}" data-won-ms="{{ size }}">
    <p class="won-ms__text">{{ won_text | escape }}</p>
    <div class="won-ms__track" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ won_pct }}">
      <span style="width:{{ won_pct }}%"></span>
      {%- unless size == 'bar' -%}
        {%- for won_row in won_steps -%}
          {%- liquid
            assign won_f = won_row | split: '¦¦'
            assign won_at = won_f[2] | plus: 0
            assign won_mark = won_at | times: 100.0 | divided_by: won_top | round
          -%}
          <i style="left:{{ won_mark }}%"{% if won_base >= won_at %} data-done{% endif %}></i>
        {%- endfor -%}
      {%- endunless -%}
    </div>
    {%- if size == 'full' -%}
      <ol class="won-ms__list">
        {%- for won_row in won_steps -%}
          {%- liquid
            assign won_f = won_row | split: '¦¦'
            assign won_at = won_f[2] | plus: 0
            assign won_at_text = won_at | money
            assign won_at_line = won_from | replace: '{amount}', won_at_text
          -%}
          <li data-won-ms-step="{{ won_f[1] }}"{% if won_base >= won_at %} data-done{% endif %}><span>{{ won_f[3] | escape }}</span><span>{{ won_at_line }}</span></li>
        {%- endfor -%}
      </ol>
    {%- endif -%}
  </div>
{%- endif -%}
