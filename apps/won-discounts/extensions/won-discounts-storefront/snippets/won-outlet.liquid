{% comment %}
  Won Discounts — the sale badge (MVP 5), rendered by the app block blocks/outlet_badge.liquid and, for a theme's
  own <won-discounts show="outlet"> tag on the product page, by the embed (umístění na webu, balík D). The contract
  is in the block's header. Params: attrs (the block's shopify_attributes, blank for a tag), scripts (true = load
  won-discounts-blocks.js here when needed; the embed loads it itself).
{% endcomment %}
{%- liquid
  assign ov = product.metafields['$app:won_discounts'].outlet.value
  assign d = ov.d
  assign show = false
  assign tx_key = 'tx_' | append: request.locale.iso_code | downcase
  assign tx = app.metafields.won_discounts[tx_key].value
  assign t_badge = 'outlet.badge' | t
  assign t_badge = tx['outlet.badge'] | default: t_badge
  assign won_timed = false
  if app.metafields.won_discounts.storefront_config.value.appearance.oc == 1 and ov.e != blank
    assign won_timed = true
    assign won_ends = 'campaign.ends' | t
    assign won_ends = tx['campaign.ends'] | default: won_ends
    assign won_units = 'campaign.units' | t
    assign won_units = tx['campaign.units'] | default: won_units
  endif
  if d == 'strike_badge' or d == 'strike_badge_left' or ov.s != blank
    assign show = true
  endif
  # The placeholder of the pieces left in a sale's own text, written without a closing brace in this file
  # (Shopify's tokenizer ends an output at the first one).
  assign won_left_token = '%7Bleft%7D' | url_decode
  assign won_legacy = 0
  if d == 'strike_badge'
    assign won_legacy = 1
  elsif d == 'strike_badge_left'
    assign won_legacy = 2
  endif
  assign won_picked = product.selected_or_first_available_variant.id
  assign won_many = false
  if product.variants.size > 1
    assign won_many = true
  endif
-%}
{%- capture won_rows -%}
  {%- if show and ov.v != blank -%}
    {%- for v in product.variants -%}
      {%- liquid
        assign key = v.id | append: ''
        assign left = ov.v[key]
        assign won_level = ov.s[key] | default: won_legacy
        if ov.s[key] == 0
          assign won_level = 0
        endif
        assign won_msg = ov.m[key]
        assign won_msg_left = false
        if won_msg contains won_left_token
          assign won_msg_left = true
          assign won_left_text = left | plus: 0 | append: ''
          assign won_msg = won_msg | replace: won_left_token, won_left_text
        endif
      -%}
      {%- if left != nil and won_level > 0 -%}
        {%- assign left = left | plus: 0 -%}
        <p class="won-outlet__row" data-won-discounts-outlet-variant="{{ v.id }}"{% if won_many and v.id != won_picked %} hidden{% endif %}>
          <span class="won-outlet__badge" data-won-discounts-outlet-badge>
            {%- if won_msg != blank -%}{{ won_msg | escape }}{%- else -%}{{ t_badge | escape }}{%- endif -%}
          </span>
          {%- if won_level == 2 and left > 0 and won_msg_left == false -%}
            <span class="won-outlet__left" data-won-discounts-outlet-left>{{ 'outlet.left' | t: count: left }}</span>
          {%- endif -%}
          {%- if won_timed and ov.e[key] != nil -%}
            <span class="won-outlet__time" data-won-discounts-campaign data-text="" data-ends="{{ won_ends | escape }}" data-units="{{ won_units | escape }}" hidden>
              <script type="application/json">[{"n":"","s":0,"e":{{ ov.e[key] | plus: 0 }}}]</script>
              <span class="won-campaign__title" hidden></span>
              <span class="won-campaign__time" aria-live="off"></span>
            </span>
          {%- endif -%}
        </p>
      {%- endif -%}
    {%- endfor -%}
  {%- endif -%}
{%- endcapture -%}
{%- assign won_rows = won_rows | strip -%}
{%- if won_rows != blank -%}
  <div class="won-outlet" data-won-discounts-outlet {{ attrs }}>
    {{ won_rows }}
  </div>
  {%- if scripts -%}
  {%- if won_timed or won_many -%}
    <script src="{{ 'won-discounts-blocks.js' | asset_url }}" defer></script>
  {%- endif -%}
  {%- endif -%}
{%- elsif request.design_mode -%}
  <div class="won-outlet" data-won-discounts-outlet data-won-discounts-outlet-sample {{ attrs }}>
    <p class="won-outlet__row">
      <span class="won-outlet__badge">{{ t_badge | escape }}</span>
      <span class="won-outlet__left">{{ 'outlet.left' | t: count: 5 }}</span>
      <span style="flex-basis:100%;font-size:12px;line-height:1.4;opacity:.7">{{ 'outlet.sample' | t }}</span>
    </p>
  </div>
{%- endif -%}
