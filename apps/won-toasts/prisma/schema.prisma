// Minimal schema for a new app: only the Session model required by Shopify's
// Prisma session storage. Add your own models below.
//
// Every standalone app owns its generated Prisma client. Never point a second
// schema at the hoisted @prisma/client output: generating one app would then
// overwrite the runtime expected by another app in this monorepo.
generator client {
  provider     = "prisma-client"
  output       = "../app/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)

  refreshToken        String?
  refreshTokenExpires DateTime?
}

// Per-shop Won Toasts configuration. `global` and `theme` hold the layered
// config blobs (see @won/core/toasts/config.types); scalar columns stay for the
// fields we query/gate on (enabled, plan, version). Event rules get their own
// model in MVP4. `version` lets us migrate older config shapes forward.
model ToastAppConfig {
  id        String   @id @default(cuid())
  shop      String   @unique
  version   Int      @default(1)
  enabled   Boolean  @default(false)
  plan       String   @default("free")
  global     Json?
  theme      Json?
  // Per-type look/behaviour overrides (default + override); cart events share one type.
  byType     Json?
  // Per cart-event on/off (added/removed/increased/decreased). Absent = on.
  cartEvents Json?
  messages   Json?
  // Merchant-defined languages (locale-as-data): enabledLocales + defaultLocale.
  locales    Json?
  milestones Json?
  targeting  Json?
  // MVP9+ recipes: page-view / aggregate notification rules (see @won/core/toasts/notifications).
  notifications Json?
  // MVP10 exclusions: pages / URL patterns where the app must not run.
  exclusions Json?
  // MVP13d: benchmarks are opt-OUT (aggregate is not PII). True = exclude this
  // shop from the cross-store aggregate AND from seeing benchmarks.
  benchmarkOptOut Boolean @default(false)
  // MVP13d: merchant self-selected industry for "stores like yours" cohorting.
  industry   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// Automatic config version history — a snapshot is stored on every save so the
// merchant can roll back to a previous state (replaces raw-JSON backup). Capped
// per shop; purged with the shop's data on uninstall/redact.
model ConfigVersion {
  id        String   @id @default(cuid())
  shop      String
  data      Json
  createdAt DateTime @default(now())

  @@index([shop, createdAt])
}

// MVP11 — real aggregate events. Each row is a genuine cart-add or order,
// timestamped, so "X people added" / "Y orders in the last week" are counted
// from real data (see @won/core/toasts/aggregates). No PII is stored here — the
// social-proof feed (MVP12) uses its own anonymized model. Retention is capped.
model ToastEvent {
  id       String   @id @default(cuid())
  shop     String
  kind     String // 'order' | 'cart_add'
  quantity Int      @default(1)
  at       DateTime @default(now())
  // Idempotency key for at-least-once order webhooks (WBH-2): a duplicate
  // orders/create delivery for the same order is a no-op. Null for cart_add
  // beacons (multiple nulls are allowed by the unique index).
  orderId  String?

  @@unique([shop, orderId])
  @@index([shop, kind, at])
}

// MVP12 — social proof feed. Deliberately minimal PII: first name + city +
// product title only (see @won/core/toasts/social-proof.anonymizeOrder).
// customerId is kept solely to honour GDPR customers/redact. Retention capped.
model SaleEvent {
  id         String   @id @default(cuid())
  shop       String
  firstName  String?
  city       String?
  product    String?
  customerId String?
  at         DateTime @default(now())
  // Idempotency key (WBH-2): one sale per order even if orders/create retries.
  orderId    String?

  @@unique([shop, orderId])
  @@index([shop, at])
  @@index([shop, customerId])
}

// MVP13 — RAW toast lifecycle analytics (short-lived; 30-day retention). One row
// per emitted atom (shown/visible/read_through/hover/click/dismiss/auto_fade/
// suppressed — plus legacy impression/click/dismiss/undo). `dims` is the scrubbed
// PII-free dimension bag (see @won/core/toasts/insights.scrubEvent); the daily
// ToastRollup below is what the dashboard reads. No PII; a toast is an assist,
// not attributed revenue. Purged on uninstall/redact.
model AnalyticsEvent {
  id      String   @id @default(cuid())
  shop    String
  ruleId  String
  variant Int      @default(0)
  type    String // atom: shown|visible|read_through|hover|click|dismiss|auto_fade|suppressed (+ legacy)
  // MVP13a: scrubbed dimension bag (type/device/pageType/customerState/…), never PII.
  dims    Json?
  // MVP13a: on-screen time in ms (present on dismiss/auto_fade).
  dwellMs Int?
  at      DateTime @default(now())

  @@index([shop, at])
}

// MVP13c — experiments. Every config change can ship as an experiment: `variant`
// config runs for a share of visitors, `control` (the pre-change config) for the
// rest, for `minDays`..`maxDays` or until Bayesian significance. `holdoutPercent`
// carves out a cohort shown NO toasts (the only honest revenue proof). `baseline`
// stores the guardrail reference metrics. `audit` is the readable outcome log.
// Only ONE active experiment per shop (queue). Purged on uninstall/redact.
model Experiment {
  id             String   @id @default(cuid())
  shop           String
  name           String
  status         String   @default("running") // running | promoted | reverted | expired
  // Snapshot of the config BEFORE the change (restore target on rollback/expire).
  control        Json
  // The proposed config under test.
  variant        Json
  variantPercent Int      @default(50)
  holdoutPercent Int      @default(0)
  gatingMode     String   @default("test_first") // test_first | apply_now
  // Guardrail baseline metrics captured at start (see @won/core experiment-engine).
  baseline       Json?
  // Human-readable audit entries (started/promoted/reverted/expired/guardrail).
  audit          Json?
  source         String   @default("manual") // manual | ai | auto_pilot
  createdAt      DateTime @default(now())
  decidedAt      DateTime?

  @@index([shop, status])
}

// MVP13a — DAILY rollup (365-day retention). The dashboard and AI advisor read
// THIS, never raw rows. One row per (shop, date, type, segment); `counters` holds
// the RollupCounters blob from @won/core/toasts/insights. Upserted as events
// ingest. Purged on uninstall/redact.
model ToastRollup {
  id            String   @id @default(cuid())
  shop          String
  date          String // YYYY-MM-DD (UTC)
  type          String
  device        String   @default("unknown")
  pageType      String   @default("unknown")
  customerState String   @default("unknown")
  abVariant     Int      @default(0)
  counters      Json
  updatedAt     DateTime @updatedAt

  @@unique([shop, date, type, device, pageType, customerState, abVariant])
  @@index([shop, date])
}
