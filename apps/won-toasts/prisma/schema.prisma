// Minimal schema for a new app: only the Session model required by Shopify's
// Prisma session storage. Add your own models below.
//
// Every standalone app owns its generated Prisma client. Never point a second
// schema at the hoisted @prisma/client output: generating one app would then
// overwrite the runtime expected by another app in this monorepo.
generator client {
  provider     = "prisma-client"
  output       = "../app/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)

  refreshToken        String?
  refreshTokenExpires DateTime?
}

// Per-shop Won Toasts configuration. `global` and `theme` hold the layered
// config blobs (see @won/core/toasts/config.types); scalar columns stay for the
// fields we query/gate on (enabled, plan, version). Event rules get their own
// model in MVP4. `version` lets us migrate older config shapes forward.
model ToastAppConfig {
  id        String   @id @default(cuid())
  shop      String   @unique
  version   Int      @default(1)
  enabled   Boolean  @default(false)
  plan       String   @default("free")
  global     Json?
  theme      Json?
  messages   Json?
  milestones Json?
  targeting  Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
