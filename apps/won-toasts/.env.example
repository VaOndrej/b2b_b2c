# Every standalone app owns its database. Postgres (fan-out ready).
# Local dev: use the docker-compose Postgres (docker compose up -d db):
DATABASE_URL="postgresql://won:won@localhost:5432/won_toasts?schema=public"
# Production: the managed Postgres connection string from your host (Fly/Render/…).

# Shopify CLI provides these during `shopify app dev`. Populate them only for a
# non-CLI runtime or deployment environment.
SHOPIFY_API_KEY=""
SHOPIFY_API_SECRET=""
SHOPIFY_APP_URL=""
SCOPES="read_themes"

# Shared real-store Horizon/Dawn test harness. Replace the store for the app.
SHOPIFY_E2E_STOREFRONT_BASE_URL="https://REPLACE_ME.myshopify.com"
SHOPIFY_E2E_STOREFRONT_PASSWORD=""
