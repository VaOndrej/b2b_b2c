{% liquid
  assign won_quantity_product = product
  assign won_quantity_variant = won_quantity_product.selected_or_first_available_variant
  assign won_quantity_message_token = '__WON_QUANTITY__'
%}

<div
  hidden
  data-won-quantity-embed
  data-won-quantity-endpoint="/apps/won-quantity/config"
  data-won-quantity-locale="{{ request.locale.iso_code | default: 'en' | escape }}"
  data-won-quantity-product-id="{% if won_quantity_product %}{{ won_quantity_product.id }}{% endif %}"
  data-won-quantity-variant-id="{% if won_quantity_variant %}{{ won_quantity_variant.id }}{% endif %}"
  data-won-quantity-message-minimum="{{ 'won_quantity.minimum' | t: quantity: won_quantity_message_token | escape }}"
  data-won-quantity-message-step="{{ 'won_quantity.step' | t: quantity: won_quantity_message_token | escape }}"
  data-won-quantity-message-maximum="{{ 'won_quantity.maximum' | t: quantity: won_quantity_message_token | escape }}"
></div>

{% schema %}
{
  "name": "t:blocks.won_quantity.name",
  "target": "body",
  "stylesheet": "won-quantity.css",
  "javascript": "won-quantity.js",
  "settings": []
}
{% endschema %}
