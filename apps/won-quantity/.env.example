# Local database owned only by Won Quantity.
DATABASE_URL="file:./dev.sqlite"

# Shopify CLI provides app credentials while `shopify app dev` is running.
# Set these only for non-CLI runtime environments.
SHOPIFY_API_KEY=""
SHOPIFY_API_SECRET=""
SHOPIFY_APP_URL=""
SCOPES="read_products"

# Shared real-store Horizon/Dawn test harness.
SHOPIFY_E2E_STOREFRONT_BASE_URL="https://b2b-b2c-store-development.myshopify.com"
SHOPIFY_E2E_STOREFRONT_PASSWORD=""
